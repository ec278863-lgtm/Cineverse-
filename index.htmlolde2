<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>CineVerse</title><meta name="theme-color" content="#0b0e17"><link rel="icon" href="data:image/png;base64,"><link rel="apple-touch-icon" href="data:image/png;base64,">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.min.js"></script>
<style>
:root{--bg:#0b0e17;--c:#161b2a;--a:#19e3b1;--m:#8b93a7}
*{box-sizing:border-box;margin:0}html,body{overflow-x:hidden}body{background:var(--bg);color:#fff;font:14px system-ui,-apple-system,Segoe UI,Roboto,sans-serif;padding-bottom:84px;max-width:640px;margin:auto}
.top{position:sticky;top:0;z-index:5;background:var(--bg);display:flex;gap:10px;align-items:center;padding:calc(10px + env(safe-area-inset-top,0px)) 12px 10px}
.logo{font-weight:800;font-size:19px;letter-spacing:-.5px}.logo b{color:var(--a)}
#q{flex:1;min-width:0;background:var(--c);border:0;border-radius:12px;color:#fff;padding:12px 14px;font-size:14px}
.tabs{display:flex;gap:22px;overflow-x:auto;padding:2px 14px 10px;scrollbar-width:none}.tabs span{color:var(--m);font-size:16px;white-space:nowrap;padding-bottom:4px}.tabs .on{color:#fff;font-size:20px;font-weight:700;border-bottom:3px solid var(--a)}
.hero{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}.slide{flex:0 0 100%;scroll-snap-align:start;height:240px;background:#1b2540 center/cover;position:relative}.slide:after{content:'';position:absolute;inset:0;background:linear-gradient(transparent 35%,var(--bg))}
.sc{position:absolute;left:12px;right:12px;bottom:12px;z-index:1;display:flex;gap:10px;align-items:center;background:rgba(22,27,42,.88);border-radius:14px;padding:8px}.sc .po{width:44px;flex:none;border-radius:6px;padding:0;font-size:0}.sc div{flex:1;min-width:0}.sc b{display:block;font-size:16px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.sc small{color:var(--m)}
.pl{width:40px;height:40px;border-radius:50%;background:var(--a);color:#001a13;display:grid;place-items:center;font-size:16px;flex:none}
.sec{display:flex;justify-content:space-between;align-items:center;padding:20px 14px 10px}.sec h3{font-size:20px}.sec a{color:var(--m)}
.cats,.row{display:flex;gap:10px;overflow-x:auto;padding:0 14px;scrollbar-width:none}
.cat{flex:none;width:136px;height:72px;border-radius:12px;display:flex;align-items:center;padding:0 14px;font-size:16px;font-weight:600;background:linear-gradient(135deg,var(--g),#0d1322)}
.card{flex:none;width:114px}.card p{font-size:13px;padding:6px 2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.po{aspect-ratio:2/3;border-radius:10px;background:linear-gradient(160deg,#1f2d4d,#0f1524) center/cover;display:flex;align-items:flex-end;padding:8px;font-size:12px;font-weight:700;color:#a9b8d8;overflow:hidden}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;padding:0 14px}.grid .card{width:auto}
.bar{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:640px;background:#0f1320f2;display:flex;padding:8px 0 calc(8px + env(safe-area-inset-bottom,0px));z-index:6;border-top:1px solid #1d2335}.bar span{text-align:center;color:var(--m);font-size:11px;flex:1}.bar i{display:block;font-style:normal;font-size:22px}.bar .on{color:var(--a)}
.sheet{position:fixed;inset:0;background:rgba(0,0,0,.72);z-index:9;display:none}.sheet.open{display:block}
.sb{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:640px;max-height:92vh;overflow:auto;background:var(--bg);border-radius:20px 20px 0 0;padding:0 14px calc(20px + env(safe-area-inset-bottom,0px))}
.bd{height:190px;margin:0 -14px 10px;background:#1b2540 center/cover;position:relative}.bd:after{content:'';position:absolute;inset:0;background:linear-gradient(transparent 40%,var(--bg))}
.x{position:absolute;top:10px;right:10px;z-index:2;background:#000a;border:0;color:#fff;width:34px;height:34px;border-radius:50%;font-size:16px}
.btn{background:var(--a);color:#001a13;border:0;border-radius:10px;padding:12px 16px;font-weight:700;font-size:14px}.btn.g{background:var(--c);color:#fff}
.f{width:100%;background:var(--c);border:1px solid #232a3f;border-radius:10px;color:#fff;padding:12px;margin-top:8px;font-size:14px}
.ep{display:flex;justify-content:space-between;align-items:center;padding:12px;background:var(--c);border-radius:10px;margin-top:8px}
video{width:100%;border-radius:12px;background:#000;margin:10px 0;display:none;max-height:45vh}
.ad{margin:16px 14px 0;display:block;border-radius:12px;overflow:hidden}.ad img{width:100%;display:block}
.chips{display:flex;gap:8px;flex-wrap:wrap;padding-bottom:6px}.chips span{background:var(--c);padding:8px 13px;border-radius:18px;font-size:13px;color:var(--m)}.chips .on{background:var(--a);color:#001a13;font-weight:700}
.rw{display:flex;gap:12px;padding:10px 14px;align-items:center}.rw .po{width:56px;flex:none}.rw b{display:block;margin-bottom:4px}
.mi{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:16px 14px;border-bottom:1px solid #151a29}.mi>.s{margin:0;white-space:nowrap}.mi>span:first-child{min-width:0;flex:1}.mi p.s{white-space:normal}.mi a{color:#fff;text-decoration:none}
.prof{display:flex;gap:14px;align-items:center;padding:8px 14px 14px}.av{width:56px;height:56px;border-radius:50%;background:var(--a);color:#001a13;display:grid;place-items:center;font-size:24px;font-weight:800}
.sw{position:relative;width:46px;height:26px;flex:none}.sw input{opacity:0;width:100%;height:100%;position:absolute;margin:0;z-index:1}.sw i{position:absolute;inset:0;background:#2a3147;border-radius:13px;transition:.2s}.sw i:after{content:'';position:absolute;left:3px;top:3px;width:20px;height:20px;border-radius:50%;background:#fff;transition:.2s}.sw input:checked+i{background:var(--a)}.sw input:checked+i:after{transform:translateX(20px)}
.fl{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding-bottom:12px}.sm{margin:0}
.dots{display:flex;gap:6px;justify-content:center;padding:6px}.dots i{width:6px;height:6px;border-radius:3px;background:#2a3147;transition:.25s}.dots .on{width:18px;background:var(--a)}
.pg{animation:sl .3s ease}@keyframes sl{from{opacity:0;transform:translateX(26px)}}.sb{animation:up .28s ease}@keyframes up{from{transform:translate(-50%,50px);opacity:0}}
.sk{background:linear-gradient(90deg,#141a2a 25%,#1d2438 50%,#141a2a 75%);background-size:200% 100%;animation:sh 1.2s infinite;border-radius:10px}@keyframes sh{to{background-position:-200% 0}}
.card:active,.cat:active,.rw:active{transform:scale(.97)}textarea.f{min-height:110px;font-family:inherit}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
.pwr{position:relative}.pwr .f{padding-right:70px}.eye{position:absolute;right:6px;top:calc(50% + 4px);transform:translateY(-50%);background:none;border:0;color:#7d869b;font-weight:700;font-size:13px;padding:10px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:0 14px 8px}.stats div{background:var(--c);border-radius:12px;padding:12px;text-align:center}.stats b{display:block;font-size:22px;color:var(--a)}.stats span{font-size:12px;color:var(--m)}
.wc{position:fixed;inset:0;z-index:30}.wl{position:fixed;inset:0;z-index:31;display:grid;place-items:center;text-align:center;padding:20px}.wt{animation:pop .8s cubic-bezier(.2,1.4,.4,1)}.wt small{display:block;color:var(--a);letter-spacing:2px;text-transform:uppercase;font-size:13px}.wt b{display:block;margin-top:10px;font-size:40px;text-shadow:0 0 26px #19e3b1;word-break:break-word}@keyframes pop{from{transform:scale(.3);opacity:0}}
.doc{line-height:1.7;color:#cdd3e2}.doc h4{margin:20px 0 6px;font-size:16px;color:#fff}.doc a{color:var(--a)}.foot a{cursor:pointer}
@media(min-width:760px){body{max-width:1100px}.bar{max-width:1100px}.sb{max-width:720px}.grid{grid-template-columns:repeat(5,1fr)}.card{width:156px}.slide{height:400px}.cat{width:190px}.top{padding-left:20px;padding-right:20px}.sec,.pad,.rw,.foot{padding-left:20px;padding-right:20px}.row,.cats{padding:0 20px}.stats{padding:0 20px 8px}}
.watch{position:fixed;inset:0;z-index:8;background:var(--bg);overflow-y:auto;display:none}.watch.open{display:block;animation:sl .28s ease}.wi{max-width:1100px;margin:auto}
.wv{position:sticky;top:0;z-index:3;aspect-ratio:16/9;background:#000 center/cover}.wv video{display:block;width:100%;height:100%;object-fit:contain;margin:0;border-radius:0;max-height:none;background:#000}
.bk{position:absolute;top:8px;left:8px;z-index:4;width:40px;height:40px;border-radius:50%;border:0;background:#000a;color:#fff;font-size:26px;line-height:1}.nv{position:absolute;inset:0;display:grid;place-items:center;color:#fff;background:#000b;text-align:center;padding:20px;z-index:1}
.wh{font-size:26px;line-height:1.2}.wb{display:flex;gap:10px;flex-wrap:wrap;margin:14px 0}.pill{display:flex;align-items:center;gap:8px;background:#232a3f;color:#fff;border:0;border-radius:24px;padding:10px 18px;font-size:15px}.mi2{width:30px;height:30px;border-radius:50%;background:#1d2a44 center/cover}
.ec{flex:none;width:136px;background:#2b3248;border-radius:10px;padding:12px;font-size:17px;font-weight:600}.ec small{display:block;color:var(--m);font-weight:400;font-size:14px;margin-top:4px}.ec.on{background:#0f4a3a;color:var(--a)}
.tb{display:flex;gap:30px;padding:16px 20px 0;border-bottom:1px solid #1d2335;margin-top:16px}.tb span{font-size:20px;color:var(--m);padding-bottom:10px}.tb .on{color:#fff;font-weight:700;border-bottom:3px solid var(--a)}
#wc{padding-top:16px}.cmt{padding:12px 20px;border-bottom:1px solid #151a29}.cmt p{margin:6px 0;line-height:1.5}
.upb{display:none;margin:14px 0 0;background:var(--c);border-radius:10px;overflow:hidden}.upb i{display:block;height:6px;background:var(--a);width:0;transition:width .3s}.upb span{display:block;padding:10px 12px;font-size:13px;line-height:1.5}.upb.er i{background:#ff6b6b;width:100%!important}.upb.er span{color:#ff9a9a}
.bars{display:flex;align-items:flex-end;gap:4px;height:110px}.bars div{flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;height:100%}.bars i{width:100%;background:var(--a);border-radius:3px 3px 0 0}.bars span{font-size:10px;color:var(--m);margin-top:3px}
.tag{font-size:11px;background:#232a3f;border-radius:6px;padding:2px 6px;margin-left:6px;color:var(--m);font-weight:400}
.in{position:fixed;inset:0;z-index:40;background:#000;display:grid;place-items:center;overflow:hidden;transition:opacity .4s}.in.out{opacity:0}.ic{position:absolute;inset:0}
.il{position:absolute;font:900 38vmin/1 system-ui,-apple-system,sans-serif;background:linear-gradient(180deg,#19e3b1,#2fb8ff 60%,#7a5cff);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 0 40px rgba(25,227,177,.55));animation:lg 3s cubic-bezier(.4,0,.2,1) both}
@keyframes lg{0%{opacity:0;transform:scale(.55)}30%{opacity:1;transform:scale(1)}58%{opacity:1;transform:scale(1.12)}100%{opacity:0;transform:scale(7)}}
.iw{position:relative;text-align:center;padding:20px;opacity:0;animation:iwk 1s 3.1s cubic-bezier(.2,1.3,.4,1) both}@keyframes iwk{from{opacity:0;transform:scale(.4)}to{opacity:1;transform:scale(1)}}
.iw small{display:block;color:var(--a);letter-spacing:3px;text-transform:uppercase;font-size:13px}.iw em{display:block;font-style:normal;font-weight:800;font-size:34px;margin-top:6px}.iw b{display:block;margin-top:14px;font-size:44px;text-shadow:0 0 28px #19e3b1;word-break:break-word}
.in.rm .il{display:none}.in.rm .iw{animation:none;opacity:1}
.foot{padding:26px 14px 0;color:var(--m);font-size:13px;line-height:2}.foot a{color:var(--m);margin-right:12px}.msg{padding:20px 14px;color:var(--m);line-height:1.5}.pad{padding:0 14px}.mt{margin-top:10px}.s{color:var(--m);font-size:13px;margin-top:4px;line-height:1.5}
#toast{position:fixed;left:50%;bottom:96px;transform:translateX(-50%);background:#252d45;padding:10px 16px;border-radius:12px;display:none;z-index:20;max-width:90%;text-align:center}

/* ---- style polish ---- */
*{-webkit-tap-highlight-color:transparent}
html{background:radial-gradient(1000px 440px at 50% -150px,#16294a 0%,#0b0e17 70%) no-repeat #0b0e17}body{background:transparent;padding-bottom:104px}
.top{background:rgba(11,14,23,.8);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}
.logo b{background:linear-gradient(90deg,#19e3b1,#4da3ff);-webkit-background-clip:text;background-clip:text;color:transparent}
#q{border:1px solid #232a3f;transition:box-shadow .2s}#q:focus{outline:0;box-shadow:0 0 0 2px rgba(25,227,177,.45)}
.slide{border-radius:0 0 24px 24px}.sc{-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);border:1px solid #ffffff14}
.pl{box-shadow:0 0 0 6px rgba(25,227,177,.18),0 6px 20px rgba(25,227,177,.4)}
.sec h3{position:relative;padding-left:12px}.sec h3:before{content:'';position:absolute;left:0;top:14%;height:72%;width:4px;border-radius:2px;background:linear-gradient(var(--a),#4da3ff)}.sec a{color:var(--a)}
.po{background:linear-gradient(160deg,#2a3c66,#0f1524) center/cover;box-shadow:0 8px 20px #0008;transition:transform .2s}.card:hover .po,.rw:hover .po{transform:translateY(-3px)}
.cat{border:1px solid #ffffff14;box-shadow:0 8px 18px #0006;position:relative;overflow:hidden}.cat:after{content:'';position:absolute;right:-20px;top:-20px;width:76px;height:76px;border-radius:50%;background:#ffffff14}
.btn{background:linear-gradient(135deg,#19e3b1,#2fb8ff);box-shadow:0 6px 18px rgba(25,227,177,.25)}.btn.g{background:var(--c);box-shadow:none;border:1px solid #ffffff12;color:#fff}
.chips span{border:1px solid #ffffff10}.chips .on{border-color:transparent;background:linear-gradient(135deg,#19e3b1,#2fb8ff)}
.pill{border:1px solid #ffffff12}.ec.on{box-shadow:inset 0 0 0 1px rgba(25,227,177,.5)}
.mi{transition:background .15s}.mi:active{background:#ffffff08}.stats div{border:1px solid #ffffff10}
#toast{border:1px solid #ffffff14;box-shadow:0 12px 30px #000a;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}
.bar{bottom:calc(10px + env(safe-area-inset-bottom,0px));width:calc(100% - 28px);max-width:420px;border:1px solid #ffffff16;border-radius:28px;background:rgba(18,23,38,.78);-webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px);padding:7px 6px;box-shadow:0 14px 36px #000b}
.bar span{padding:6px 0 5px;border-radius:20px;transition:background .25s,color .25s}.bar i{display:grid;place-items:center;height:26px;transition:transform .25s}
.bar svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.bar .on{color:var(--a);background:rgba(25,227,177,.13)}.bar .on i{transform:translateY(-2px)}.bar .on svg{filter:drop-shadow(0 0 6px rgba(25,227,177,.75))}

/* ---- grid fix: long titles must not stretch the columns ---- */
.grid{grid-template-columns:repeat(3,minmax(0,1fr))}.grid .card{min-width:0;width:auto}.card p,.rw b{overflow:hidden;text-overflow:ellipsis}
.watch,.wi{overflow-x:hidden}.wi{min-width:0}
@media(min-width:760px){.grid{grid-template-columns:repeat(5,minmax(0,1fr))}}

/* ---- player ---- */
.pc{position:absolute;inset:0;z-index:3;color:#fff;user-select:none;-webkit-user-select:none}.pc>*{transition:opacity .25s}
.pt{position:absolute;top:0;left:0;right:0;display:flex;align-items:center;gap:10px;padding:8px 10px;background:linear-gradient(#000c,transparent)}.pt span{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:600}
.pb{background:#0007;border:0;color:#fff;border-radius:50%;width:40px;height:40px;font-size:20px;line-height:1;display:grid;place-items:center;padding:0}.pb small{font-size:11px;margin-top:-8px}.pb.big{width:58px;height:58px;font-size:26px}
.pm{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;gap:30px;pointer-events:none}.pm .pb{pointer-events:auto}
.pbt{position:absolute;left:0;right:0;bottom:0;padding:20px 12px 8px;background:linear-gradient(transparent,#000d)}.pbar{display:flex;align-items:center;gap:8px;font-size:12px}.pbar input{flex:1;accent-color:#19e3b1;min-width:0}
.prow{display:flex;align-items:center;gap:2px;margin-top:2px}.prow i{flex:1}.prow button{background:none;border:0;color:#fff;font-size:14px;padding:8px 6px;min-width:32px}
.pc.hide .pt,.pc.hide .pm,.pc.hide .pbt,.pc.lk .pt,.pc.lk .pm,.pc.lk .pbt{opacity:0;pointer-events:none}
.plk{position:absolute;left:12px;top:50%;transform:translateY(-50%);z-index:5;background:#000b;border:1px solid #fff3;border-radius:22px;padding:10px 14px;display:none;color:#fff}.plk.on{display:block}
.ppn{position:absolute;top:0;right:0;bottom:0;width:min(80%,320px);background:#0b0e17f0;overflow:auto;padding:8px 14px;display:none}.ppn:not(:empty){display:block}.ppn h4{margin:12px 0 6px;font-size:15px}.pr{display:flex;justify-content:space-between;align-items:center;padding:11px 4px;border-bottom:1px solid #ffffff10}.pr.on{color:#19e3b1}
.sbt{position:absolute;left:6%;right:6%;bottom:58px;z-index:2;text-align:center;pointer-events:none;line-height:1.4;text-shadow:0 1px 3px #000}.sbt span{padding:2px 8px;border-radius:6px;display:inline-block}.sbt.bg span{background:#000a}.sbt.s-s{font-size:13px}.sbt.s-m{font-size:16px}.sbt.s-l{font-size:21px}.sbt.c-w{color:#fff}.sbt.c-y{color:#ffe04a}
.wv:fullscreen,.wv:-webkit-full-screen{width:100vw;height:100vh;aspect-ratio:auto}.wv:fullscreen .sbt,.wv:-webkit-full-screen .sbt{bottom:78px;font-size:1.5em}

/* ---- advanced navigation ---- */
.psw{position:relative;flex:1;min-width:0;display:flex;align-items:center}.psw input{width:100%}.mkr{position:absolute;top:50%;height:6px;transform:translateY(-50%);background:#ffd24acc;border-radius:3px;pointer-events:none;display:none}.mkr.cr{background:#ff6b8acc}
.sth{position:absolute;bottom:66px;display:none;width:160px;pointer-events:none;text-align:center}.sth canvas{display:block;width:160px;height:90px;background:#000;border:1px solid #fff5;border-radius:8px}.sth span{display:inline-block;background:#000b;border-radius:6px;padding:2px 8px;font-size:12px;margin-top:4px}
.skp{position:absolute;right:12px;bottom:90px;z-index:4;background:#fffe;color:#000;border:0;border-radius:6px;padding:10px 16px;font-weight:700}
.nxc{position:absolute;right:12px;bottom:90px;z-index:4;background:#0b0e17ee;border:1px solid #ffffff22;border-radius:12px;padding:12px;min-width:210px}.nxc b{display:block}.nxc span{color:#8b93a7;font-size:13px}.nxc div{display:flex;gap:8px;margin-top:10px}.nxc button{flex:1;border:0;border-radius:8px;padding:9px;font-weight:700;background:#19e3b1;color:#001a13}.nxc button.g{background:#2a3147;color:#fff}
.pgi{position:absolute;left:50%;top:22%;transform:translateX(-50%);z-index:5;background:#000c;border-radius:10px;padding:8px 14px;display:none;font-weight:600;pointer-events:none;white-space:nowrap}

/* ---- player look v2: neon glass ---- */
.pc{--u:1}@media(max-width:520px){.pc{--u:.8}}@media(min-width:760px){.pc{--u:1.35}}.wv:fullscreen .pc,.wv:-webkit-full-screen .pc{--u:1.45}
.pc .pb{width:calc(38px*var(--u));height:calc(38px*var(--u));padding:0;border-radius:50%;background:rgba(8,22,34,.55);border:calc(1.5px*var(--u)) solid rgba(25,227,177,.5);box-shadow:0 0 calc(14px*var(--u)) rgba(25,227,177,.28),inset 0 0 calc(12px*var(--u)) rgba(25,227,177,.1);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);color:#fff;display:grid;place-items:center}
.pc .pb svg{width:52%;height:52%;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}svg .fl{fill:currentColor;stroke:none}.ppill .tl{color:#19e3b1}
.pt{padding:calc(8px*var(--u)) calc(12px*var(--u));gap:calc(12px*var(--u))}.pt span{font-size:calc(15px*var(--u));font-weight:700}
.pm{gap:calc(26px*var(--u))}.pm .pb.skip{width:calc(48px*var(--u));height:calc(48px*var(--u));display:flex;flex-direction:column;align-items:center;justify-content:center}.pm .pb.skip svg{width:44%;height:44%}.pm .pb.skip b{font-size:calc(14px*var(--u));line-height:1;margin-top:calc(-1px*var(--u))}
.pm .pb.play{width:calc(62px*var(--u));height:calc(62px*var(--u));border-color:#19e3b1;box-shadow:0 0 calc(22px*var(--u)) rgba(25,227,177,.5),inset 0 0 calc(18px*var(--u)) rgba(25,227,177,.18)}.pm .pb.play svg{width:46%;height:46%}
.pbt{padding:calc(14px*var(--u)) calc(14px*var(--u)) calc(10px*var(--u))}.pbar{gap:calc(10px*var(--u));font-size:calc(12px*var(--u));font-weight:600}
.psw input{-webkit-appearance:none;appearance:none;background:transparent;height:calc(22px*var(--u));margin:0}
.psw input::-webkit-slider-runnable-track{height:calc(5px*var(--u));border-radius:9px;background:linear-gradient(90deg,#19e3b1 var(--p,0%),rgba(255,255,255,.22) var(--p,0%));box-shadow:0 0 10px rgba(25,227,177,.45)}
.psw input::-webkit-slider-thumb{-webkit-appearance:none;width:calc(16px*var(--u));height:calc(16px*var(--u));border-radius:50%;background:#19e3b1;margin-top:calc(-5.5px*var(--u));box-shadow:0 0 12px #19e3b1}
.psw input::-moz-range-track{height:calc(5px*var(--u));border-radius:9px;background:rgba(255,255,255,.22)}.psw input::-moz-range-progress{height:calc(5px*var(--u));border-radius:9px;background:#19e3b1}.psw input::-moz-range-thumb{width:calc(16px*var(--u));height:calc(16px*var(--u));border:0;border-radius:50%;background:#19e3b1;box-shadow:0 0 12px #19e3b1}
.mkr{height:calc(5px*var(--u))}
.pbrow{display:flex;align-items:center;gap:calc(8px*var(--u));margin-top:calc(6px*var(--u))}
.ppill{flex:1;min-width:0;display:flex;min-height:calc(44px*var(--u));background:rgba(8,22,34,.6);border:calc(1.5px*var(--u)) solid rgba(25,227,177,.4);border-radius:40px;box-shadow:0 0 18px rgba(25,227,177,.18),inset 0 0 14px rgba(25,227,177,.06);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);overflow:hidden}
.ppill button{flex:1;min-width:0;background:none;border:0;color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:calc(2px*var(--u));padding:0 2px;border-left:1px solid rgba(255,255,255,.13)}.ppill button:first-child{border-left:0}
.ppill svg{width:calc(20px*var(--u));height:calc(20px*var(--u));fill:none;stroke:#fff;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.ppill .tl svg{stroke:#19e3b1}.ppill b{font-size:calc(16px*var(--u))}
.ppill small.lb{display:none;font-size:calc(9.5px*var(--u))}.wv:fullscreen .ppill small.lb,.wv:-webkit-full-screen .ppill small.lb{display:block}@media(min-width:760px){.ppill small.lb{display:block}}
.ppn{background:rgba(8,22,34,.94);border-left:1px solid rgba(25,227,177,.35)}.pbt{background:linear-gradient(transparent,#000c)}

/* ---- watermark + notification prompt ---- */
.wm{position:absolute;z-index:2;top:15%;right:12px;font:800 13px/1 system-ui,sans-serif;color:rgba(255,255,255,.55);text-shadow:0 1px 4px #000a;pointer-events:none;user-select:none;-webkit-user-select:none;display:flex;align-items:center;gap:5px;animation:wmv 80s steps(1) infinite}
.wm i{font-style:normal;width:17px;height:17px;border-radius:5px;background:linear-gradient(135deg,#19e3b1,#4da3ff);color:#04201a;display:grid;place-items:center;font-size:12px;opacity:.85}.wm b{color:rgba(25,227,177,.8);font-weight:800;margin-left:-5px}
@keyframes wmv{0%{top:15%;right:12px;left:auto;bottom:auto}25%{top:auto;bottom:26%;right:auto;left:12px}50%{top:15%;left:12px;right:auto;bottom:auto}75%{top:auto;bottom:26%;left:auto;right:12px}}
.wv:fullscreen .wm,.wv:-webkit-full-screen .wm{font-size:22px}.wv:fullscreen .wm i,.wv:-webkit-full-screen .wm i{width:28px;height:28px;font-size:18px}
.pka{position:fixed;left:14px;right:14px;bottom:calc(88px + env(safe-area-inset-bottom,0px));z-index:12;max-width:420px;margin:auto;background:rgba(18,23,38,.97);border:1px solid #ffffff18;border-radius:16px;padding:14px;box-shadow:0 14px 36px #000b}.pka b{display:block}.pka span{display:block;color:#8b93a7;font-size:13px;margin-top:4px}.pka div{display:flex;gap:8px;margin-top:12px}.pka .btn{flex:1}

.pc{touch-action:pan-y}.wv:fullscreen .pc,.wv:-webkit-full-screen .pc{touch-action:none}.pc button,.pc input{touch-action:manipulation}
</style><!-- ADSENSE: after you apply, paste the code Google gives you here, inside the head -->
</head><body>
<div class="top"><div class="logo">Cine<b>Verse</b></div><input id="q" placeholder="Search movies, series, anime" onfocus="S.sf=true;go()" oninput="S.q=this.value.trim();go()" onkeydown="if(event.key==='Enter')rec()"></div>
<div id="tabs" class="tabs"></div><main id="app"></main><div class="foot"><a onclick="pageV('about')">About</a><a onclick="pageV('contact')">Contact</a><a onclick="pageV('privacy')">Privacy</a><a onclick="pageV('terms')">Terms &amp; Copyright</a></div>
<div class="bar"><span id="n-home" onclick="nav('home')"><i><svg viewBox="0 0 24 24"><path d="M3 11.5 12 4l9 7.5M5.5 10v9.5h13V10"/></svg></i>Home</span><span id="n-dl" onclick="nav('dl')"><i><svg viewBox="0 0 24 24"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 19.5h14"/></svg></i>Downloads</span><span id="n-me" onclick="nav('me')"><i><svg viewBox="0 0 24 24"><circle cx="12" cy="8.5" r="3.6"/><path d="M5 20c.8-3.6 3.8-5.4 7-5.4s6.2 1.8 7 5.4"/></svg></i>Me</span></div>
<div id="watch" class="watch"></div><div id="sheet" class="sheet" onclick="if(event.target===this)shut()"><div class="sb" id="sb"></div></div><div id="toast"></div>
<script>
(function(){try{const I192='data:image/png;base64,',I512='data:image/png;base64,',base=location.origin+location.pathname.replace(/[^/]*$/,''),m={name:'CineVerse',short_name:'CineVerse',description:'Movies, series and anime',start_url:base,scope:base,display:'standalone',background_color:'#0b0e17',theme_color:'#0b0e17',icons:[{src:I192,sizes:'192x192',type:'image/png',purpose:'any maskable'},{src:I512,sizes:'512x512',type:'image/png',purpose:'any maskable'}]},l=document.createElement('link');l.rel='manifest';l.href=URL.createObjectURL(new Blob([JSON.stringify(m)],{type:'application/manifest+json'}));document.head.appendChild(l)}catch(e){}})();
const sb=supabase.createClient('https://nvxwjeosbzqcehpwvvwh.supabase.co','sb_publishable_9Pg38TPKfDc9jFDlwDmGqg_yHnuuKYj');
let ST={q:'best',auto:true,next:true,pip:true,saver:false,snd:true,subOn:true,subSize:'m',subColor:'w',subBg:true,lang:'',step:10,push:false,pushAsk:0};try{Object.assign(ST,JSON.parse(localStorage.getItem('cv-st')||'{}'))}catch(e){}
const setS=(k,v)=>{ST[k]=v;try{localStorage.setItem('cv-st',JSON.stringify(ST))}catch(e){}};let EPS=[],DL={};
const S={sf:false,st:'All',fl:{},loaded:false,k:'',lb:'home',titles:[],tab:'Trending',nav:'home',list:null,q:'',user:null,admin:false,wl:new Set(),ad:null};let L={};
const AD_CLIENT='',AD_SLOT='';
const adU=()=>AD_CLIENT?`<ins class="adsbygoogle" style="display:block;margin:16px 14px 0" data-ad-client="${AD_CLIENT}" data-ad-slot="${AD_SLOT}" data-ad-format="auto" data-full-width-responsive="true"></ins>`:'';
const pushAds=()=>{if(AD_CLIENT)document.querySelectorAll('ins.adsbygoogle:not([data-done])').forEach(e=>{e.dataset.done=1;try{(window.adsbygoogle=window.adsbygoogle||[]).push({})}catch(x){}})};
const QO=['360p','480p','720p','1080p','4k'],TABS=['Trending','Movie','TV','Anime','Kids'];
const $=s=>document.querySelector(s),esc=v=>String(v==null?'':v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const bg=u=>u?`background-image:url('${esc(u)}')`:'',byId=id=>S.titles.find(t=>t.id===id);
const fire=q=>{q.then(()=>{},()=>{})};let tt;function toast(m){const e=$('#toast');e.textContent=m;e.style.display='block';clearTimeout(tt);tt=setTimeout(()=>e.style.display='none',3200)}
const meta=t=>[t.release_year,(t.genres||[])[0],t.country].filter(Boolean).join(' | ');
const card=t=>`<div class="card" onclick="openT('${t.id}')"><div class="po" style="${bg(t.poster_url)}">${t.poster_url?'':esc(t.title)}</div><p>${esc(t.title)}</p></div>`;
function row(name,items){if(!items.length)return'';const k='k'+Object.keys(L).length;L[k]={name,items};return `<div class="sec"><h3>${esc(name)}</h3><a onclick="more('${k}')">More ›</a></div><div class="row">${items.slice(0,12).map(card).join('')}</div>`}
function more(k){S.list=L[k];S.nav='list';go()}
const CATS=[['All','#1d4f7a'],['Hollywood','#2a3f8f',['us','usa','united states']],['Nollywood','#7a4a2a',['nigeria']],['Ghana','#7a6a1d',['ghana']],['Korean','#7a2a5a',['korea','south korea']],['UK','#2a6a5a',['uk','united kingdom','england']],['Anime','#5a2a8f','anime']];
const inCat=(c,t)=>!c[2]||(c[2]==='anime'?t.type==='anime':c[2].includes((t.country||'').toLowerCase()));
function cat(n){if(n==='All'){S.fl={};S.nav='filter';return go()}const c=CATS.find(x=>x[0]===n);S.list={name:n,items:S.titles.filter(t=>inCat(c,t))};S.lb='home';S.nav='list';go()}
function nav(n){S.nav=n;S.sf=false;S.q='';$('#q').value='';$('#q').blur();go();scrollTo(0,0)}
const bar=(t,b)=>`<div class="sec"><h3>${esc(t)}</h3><a onclick="nav('${b}')">Back</a></div>`;
const mi=(i,t,f,n)=>`<div class="mi" onclick="${f}"><span>${i} ${t}</span><span class="s">${n==null?'':n+' '}›</span></div>`;
function go(){const a=$('#app'),T=$('#tabs'),sub=['list','filter','set','hist','fb','adm','pg'];
 ['home','dl','me'].forEach(n=>$('#n-'+n).classList.toggle('on',!S.sf&&(S.nav===n||(sub.includes(S.nav)&&n===(['list','filter'].includes(S.nav)&&S.lb==='home'?'home':'me')))));
 T.style.display=!S.sf&&S.nav==='home'?'flex':'none';T.innerHTML=TABS.map(t=>`<span class="${t===S.tab?'on':''}" onclick="S.tab='${t}';go()">${t}</span>`).join('');
 const k=S.sf?'s':S.nav+S.tab;if(k!==S.k){S.k=k;a.classList.remove('pg');void a.offsetWidth;a.classList.add('pg')}
 if(S.sf)return a.innerHTML=searchV();
 switch(S.nav){case'home':a.innerHTML=home();pushAds();break;case'list':a.innerHTML=bar(S.list.name,S.lb)+(S.list.items.length?`<div class="grid">${S.list.items.map(card).join('')}</div>`:'<p class="msg">Nothing here yet.</p>');break;
 case'filter':a.innerHTML=filterV();break;case'dl':a.innerHTML=dl();break;case'set':a.innerHTML=setV();break;case'fb':a.innerHTML=fbV();break;case'hist':histV();break;case'adm':a.innerHTML=bar('Admin','me')+admin();admT(S.at||'ov');break;case'pg':a.innerHTML=bar(PGT[S.pg],'home')+`<div class="pad doc">${PG[S.pg]}</div>`;break;default:me()}}
function dot(h){const i=Math.round(h.scrollLeft/h.clientWidth);document.querySelectorAll('#dots i').forEach((d,j)=>d.classList.toggle('on',i===j))}
const skel=()=>`<div class="sk" style="height:240px"></div>`+[1,2].map(()=>`<div class="row" style="padding-top:20px">${[1,2,3,4].map(()=>'<div class="sk" style="flex:none;width:114px;height:170px"></div>').join('')}</div>`).join('');
function filterV(){const F=S.fl,T=S.titles,u=a=>[...new Set(a.filter(Boolean))];
 const sel=(id,l,o)=>`<select class="f sm" onchange="S.fl.${id}=this.value;go()"><option value="">${l}</option>${o.map(x=>`<option ${F[id]==x?'selected':''}>${esc(x)}</option>`).join('')}</select>`;
 const h=T.filter(t=>(!F.type||t.type===F.type)&&(!F.country||t.country===F.country)&&(!F.year||String(t.release_year)===F.year)&&(!F.genre||(t.genres||[]).includes(F.genre)));
 return bar('Filter','home')+`<div class="fl pad">${sel('type','Type',['movie','series','anime'])}${sel('country','Country',u(T.map(t=>t.country)))}${sel('year','Year',u(T.map(t=>t.release_year)).sort((a,b)=>b-a))}${sel('genre','Genre',u(T.flatMap(t=>t.genres||[])))}</div>`+(h.length?`<div class="grid">${h.map(card).join('')}</div>`:'<p class="msg">No titles match these filters.</p>')}
function home(){L={};let T=S.titles;if(S.tab==='Movie')T=T.filter(t=>t.type==='movie');if(S.tab==='TV')T=T.filter(t=>t.type==='series');if(S.tab==='Anime')T=T.filter(t=>t.type==='anime');if(S.tab==='Kids')T=T.filter(t=>/^(G|PG|TV-Y7?|TV-G)$/i.test(t.maturity_rating||'')||(t.genres||[]).some(g=>/kid|family/i.test(g)));
 if(!S.loaded)return skel();if(!S.titles.length)return `<p class="msg">No titles yet.${S.admin?' Open Me to add the first one.':' Check back soon.'}</p>`;
 const f=T.filter(t=>t.featured),h=(f.length?f:T).slice(0,5);
 let o=h.length?`<div class="hero" onscroll="dot(this)">${h.map(t=>`<div class="slide" style="${bg(t.backdrop_url||t.poster_url)}" onclick="openT('${t.id}')"><div class="sc"><div class="po" style="${bg(t.poster_url)}"></div><div><b>${esc(t.title)}</b><small>${esc(meta(t))}</small></div><span class="pl">▶</span></div></div>`).join('')}</div><div class="dots" id="dots">${h.map((_,i)=>`<i class="${i?'':'on'}"></i>`).join('')}</div>`:'';
 o+=`<div class="sec"><h3>Categories</h3></div><div class="cats">${CATS.map(c=>`<div class="cat" style="--g:${c[1]}" onclick="cat('${c[0]}')">${c[0]}</div>`).join('')}</div>`;
 o+=row(S.tab==='Trending'?'Trending':'Trending '+S.tab,[...T].sort((a,b)=>b.view_count-a.view_count));
 if(S.ad)o+=`<a class="ad" href="${esc(S.ad.click_url||'#')}" target="_blank" rel="noopener sponsored"><img src="${esc(S.ad.media_url)}" alt="${esc(S.ad.name)}"></a>`;
 o+=adU();o+=row('New releases',[...T].sort((a,b)=>b.created_at<a.created_at?-1:1));
 const g={};T.forEach(t=>(t.genres||[]).forEach(x=>(g[x]=g[x]||[]).push(t)));
 Object.entries(g).sort((a,b)=>b[1].length-a[1].length).slice(0,4).forEach(([n,i])=>o+=row(n,i));CATS.slice(2,6).forEach(c=>o+=row(c[0],T.filter(t=>inCat(c,t))));return o}
const rec=()=>{if(!S.q)return;try{const R=JSON.parse(localStorage.getItem('cv-recent')||'[]').filter(x=>x!==S.q);R.unshift(S.q);localStorage.setItem('cv-recent',JSON.stringify(R.slice(0,8)))}catch(e){}};
function sq(q){S.q=q;$('#q').value=q;rec();go()}
function endS(){S.sf=false;S.q='';$('#q').value='';$('#q').blur();go()}
function searchV(){const q=S.q.toLowerCase();let o=`<div class="sec"><h3>Search</h3><a onclick="endS()">Cancel</a></div>`;
 if(!q){let R=[];try{R=JSON.parse(localStorage.getItem('cv-recent')||'[]')}catch(e){}
  return o+(R.length?`<div class="pad s">Recent <a onclick="localStorage.removeItem('cv-recent');go()" style="float:right;color:#fff">Clear</a></div><div class="chips pad mt">${R.map(r=>`<span onclick="sq(this.dataset.q)" data-q="${esc(r)}">${esc(r)}</span>`).join('')}</div>`:'')+`<div class="sec"><h3>Everyone is searching</h3></div><div class="chips pad">${[...S.titles].sort((a,b)=>b.view_count-a.view_count).slice(0,8).map(t=>`<span onclick="sq(this.dataset.q)" data-q="${esc(t.title)}">${esc(t.title)}</span>`).join('')||'<span>No titles yet</span>'}</div>`}
 const M={Movie:'movie',Series:'series',Anime:'anime'};let h=S.titles.filter(t=>[t.title,t.country,t.director,(t.genres||[]).join(' '),(t.cast_names||[]).join(' ')].join(' ').toLowerCase().includes(q));if(S.st!=='All')h=h.filter(t=>t.type===M[S.st]);
 return o+`<div class="chips pad">${['All','Movie','Series','Anime'].map(c=>`<span class="${S.st===c?'on':''}" onclick="S.st='${c}';go()">${c}</span>`).join('')}</div>`+(h.length?h.map(t=>`<div class="rw" onclick="rec();openT('${t.id}')"><div class="po" style="${bg(t.poster_url)}"></div><div><b>${esc(t.title)}</b><p class="s">${esc(meta(t))}</p></div></div>`).join(''):`<div class="msg">No match for “${esc(S.q)}”.<br><button class="btn mt" onclick="reqT()">Request this title</button></div>`)}
async function reqT(){if(!S.user){nav('me');return toast('Sign in to request titles.')}const {error}=await sb.from('cv_title_requests').insert({user_id:S.user.id,query:S.q.slice(0,200)});toast(error?error.message:'Request sent. Thank you!')}
const DK=id=>location.origin+'/__cv_dl/'+id,DM=()=>{try{return JSON.parse(localStorage.getItem('cv-dls')||'[]')}catch(e){return[]}},sDM=l=>{try{localStorage.setItem('cv-dls',JSON.stringify(l))}catch(e){}};
function dl(){const D=DM(),T=S.titles.filter(t=>t.allow_download);setTimeout(est,0);
 return `<div class="sec"><h3>Downloads</h3></div><p class="s pad" id="est"></p>`+(D.length?D.map(d=>`<div class="rw"><div class="po" style="${bg(d.poster)}"></div><div style="flex:1;min-width:0"><b>${esc(d.title)}</b><p class="s">${esc(d.label)} · ${esc(d.q)} · ${mb(d.size)}</p></div><button class="btn" onclick="playOff('${d.id}')">▶</button><button class="btn g" onclick="rmOff('${d.id}')">✕</button></div>`).join(''):'<p class="msg">Nothing saved yet. Titles you download stay inside CineVerse, not in your phone\'s gallery or files.</p>')+
 (T.length?`<div class="sec"><h3>Available to download</h3></div>`+T.map(t=>`<div class="rw"><div class="po" style="${bg(t.poster_url)}" onclick="openT('${t.id}')"></div><div style="flex:1;min-width:0"><b>${esc(t.title)}</b><p class="s">${esc(meta(t))}</p></div><button class="btn" onclick="dlg('${t.id}')">⇩</button></div>`).join(''):'')}
async function est(){const e=$('#est');if(!e||!navigator.storage||!navigator.storage.estimate)return;try{const {usage,quota}=await navigator.storage.estimate();e.textContent='Used by CineVerse on this device: '+mb(usage)+' (about '+(quota/1073741824).toFixed(1)+' GB available)'}catch(x){}}
async function playOff(id){if(!window.caches)return;const c=await caches.open('cv-dl'),r=await c.match(DK(id)),d=DM().find(x=>x.id===id);if(!r||!d){toast('That file is gone. Removing it from the list.');return rmOff(id,1)}
 const b=await r.blob(),w=$('#watch');w.classList.add('open');w.scrollTop=0;
 w.innerHTML=`<div class="wi"><div class="wv" id="wv"><video id="vp" playsinline autoplay></video>${pcHTML(false)}</div><div class="pad"><h2 class="wh mt">${esc(d.title)}</h2><p class="s mt">${esc(d.label)} | ${esc(d.q)} | plays from your saved copy, no data used</p></div><div class="tb"><span class="on">For you</span></div><div class="grid mt">${S.titles.filter(x=>x.id!==d.tid).slice(0,24).map(card).join('')}</div></div>`;initPlayer();$('#ptl').textContent=d.title+' · '+d.label;$('#vp').src=URL.createObjectURL(b)}
async function rmOff(id,q){if(!q&&!confirm('Delete this download?'))return;try{await(await caches.open('cv-dl')).delete(DK(id))}catch(e){}sDM(DM().filter(d=>d.id!==id));if(S.nav==='dl')go()}
async function dlg(id){const t=byId(id);if(!t)return;$('#sheet').classList.add('open');$('#sb').innerHTML='<p class="msg">Loading…</p>';
 const {data:E}=await sb.from('cv_episodes').select('id,season,episode,name').eq('title_id',id).order('season').order('episode');const e=E||[];EPS=e;
 const {data:A}=e.length?await sb.from('cv_video_assets').select('id,episode_id,quality,storage_path,size_bytes,provider').in('episode_id',e.map(x=>x.id)):{data:[]};
 DL={t,e,A:A||[]};const Q=[...new Set(DL.A.map(a=>a.quality))].sort((a,b)=>QO.indexOf(a)-QO.indexOf(b));DL.Q=Q;DL.q=Q.includes(ST.q)?ST.q:Q[Q.length-1];dlr()}
function dlr(){const {t,e,A,Q,q}=DL;if(!Q.length){$('#sb').innerHTML='<div class="pad"><div class="sec"><h3>Download</h3><a onclick="shut()">Close</a></div><p class="msg">No video uploaded yet.</p></div>';return}
 $('#sb').innerHTML=`<div class="pad"><div class="sec" style="padding-left:0"><h3>Download</h3><a onclick="shut()">Close</a></div><b>${esc(t.title)}</b><div class="chips mt">${Q.map(x=>`<span class="${x===q?'on':''}" onclick="DL.q='${x}';dlr()">${x}</span>`).join('')}</div>${e.filter(x=>A.some(a=>a.episode_id===x.id&&a.quality===q)).map(x=>`<label class="ep"><span>${t.type==='movie'?'Movie':'S'+x.season+' E'+x.episode}${x.name?' · '+esc(x.name):''}</span><input type="checkbox" data-e="${x.id}" checked></label>`).join('')}<button class="btn mt" style="width:100%" onclick="dgo()">⇩ Download selected</button></div>`}
async function dgo(){const ids=[...document.querySelectorAll('[data-e]:checked')].map(x=>x.dataset.e);if(!ids.length)return toast('Select at least one.');if(!window.caches)return toast("This browser can't save downloads inside the site. Try Chrome, Edge, Firefox or Safari over https.");
 try{navigator.storage&&navigator.storage.persist&&navigator.storage.persist()}catch(e){}
 const c=await caches.open('cv-dl'),{t,e}=DL;shut();
 for(const id of ids){const a=DL.A.find(x=>x.episode_id===id&&x.quality===DL.q),ep=e.find(x=>x.id===id);if(!a)continue;const did=a.id;if(DM().some(d=>d.id===did)){toast('Already downloaded.');continue}
  try{const u=await vurl(a);if(!u)continue;const r=await fetch(u);if(!r.ok||!r.body)throw new Error('could not fetch the file');const tot=+r.headers.get('content-length')||a.size_bytes||0;let n=0,lt=0;
   const body=typeof TransformStream==='function'?r.body.pipeThrough(new TransformStream({transform(ch,ctl){n+=ch.length;if(tot&&Date.now()-lt>700){lt=Date.now();toast('Downloading '+t.title+'… '+Math.floor(n*100/tot)+'%')}ctl.enqueue(ch)}})):r.body;
   await c.put(DK(did),new Response(body,{headers:{'Content-Type':r.headers.get('Content-Type')||'video/mp4'}}));
   const l=DM();l.push({id:did,tid:t.id,title:t.title,poster:t.poster_url,label:t.type==='movie'?'Movie':'S'+ep.season+' E'+ep.episode,q:DL.q,size:n||a.size_bytes||0});sDM(l);toast('Saved in Downloads ✅')}
  catch(x){try{await c.delete(DK(did))}catch(y){}toast('Download failed: '+(x.message||x))}}
 if(S.nav==='dl')go()}
function shut(){const v=$('#sb #vp');if(v)v.pause();$('#sheet').classList.remove('open')}
function closeW(){clearInterval(P.t);const v=$('#vp');if(v){v.pause();v.removeAttribute('src');v.load()}if(document.fullscreenElement)document.exitFullscreen().catch(()=>{});try{screen.orientation.unlock()}catch(e){}$('#watch').classList.remove('open')}
let CUR=null,A=[],last=0;
const p2=n=>String(n).padStart(2,'0'),big=a=>{const m=Math.max(0,...a.map(x=>x.size_bytes||0));return m?mb(m):''};
async function openT(id){const t=byId(id);if(!t)return;CUR=t;S.wt='fy';const w=$('#watch');w.classList.add('open');w.scrollTop=0;
 w.innerHTML=`<div class="wi"><div class="wv" style="${bg(t.backdrop_url||t.poster_url)}"><button class="bk" onclick="closeW()">‹</button><video id="vp" playsinline></video></div><div class="pad"><h2 class="wh mt">${esc(t.title)}</h2><p class="s">Loading…</p></div></div>`;
 const {data:E}=await sb.from('cv_episodes').select('*').eq('title_id',id).order('season').order('episode');const e=E||[];EPS=e;
 const {data:A0}=e.length?await sb.from('cv_video_assets').select('episode_id,size_bytes').in('episode_id',e.map(x=>x.id)):{data:[]};
 const ser=t.type!=='movie'&&e.length>1,ns=new Set(e.map(x=>x.season)).size;
 const mt=[t.type==='movie'?'Movie':t.type==='anime'?'Anime':'TV',t.release_year,t.country,(t.genres||[])[0],ser?ns+(ns>1?' seasons':' season'):(t.runtime_minutes?t.runtime_minutes+' min':''),t.maturity_rating].filter(Boolean).map(esc).join(' | ');
 w.innerHTML=`<div class="wi"><div class="wv" id="wv" style="${bg(t.backdrop_url||t.poster_url)}"><video id="vp" playsinline></video>${e.length?pcHTML(t.allow_download):'<button class="bk" onclick="closeW()">‹</button><div class="nv">No video uploaded yet</div>'}</div>
 <div class="pad"><h2 class="wh mt">${esc(t.title)}</h2><p class="s mt">${mt}</p>
 <div class="wb"><button class="pill" onclick="tgD()"><span class="mi2" style="${bg(t.poster_url)}"></span>Details</button>${t.allow_download&&e.length?`<button class="pill" onclick="dlg('${id}')">⇩ Download more</button>`:''}<button class="pill" id="wb" onclick="wl('${id}')">${S.wl.has(id)?'✓ My List':'+ My List'}</button></div>
 <div id="dt" class="doc" style="display:none">${t.description?`<p>${esc(t.description)}</p>`:''}${t.director?`<p>Director: ${esc(t.director)}</p>`:''}${(t.cast_names||[]).length?`<p>Cast: ${esc(t.cast_names.join(', '))}</p>`:''}${t.maturity_rating?`<p>Age rating: ${esc(t.maturity_rating)}</p>`:''}</div><div id="qs"></div>
 ${e.length>1?`<h3 class="mt">${ser?'Episodes':'Parts'}</h3><div class="row mt" style="padding:0">${e.map(x=>`<div class="ec" id="ec-${x.id}" onclick="play('${x.id}')">S${p2(x.season)} E${p2(x.episode)}<small>${big((A0||[]).filter(a=>a.episode_id===x.id))||'&nbsp;'}</small></div>`).join('')}</div>`:''}</div>
 <div class="tb"><span id="t-fy" class="on" onclick="wtab('fy')">For you</span><span id="t-cm" onclick="wtab('cm')">Comments</span></div><div id="wc"></div></div>`;wtab('fy');initPlayer();
 if(e.length){let f=e[0];if(S.user&&e.length>1){const {data:h}=await sb.from('cv_my_history').select('episode_id,completed').eq('title_id',id).limit(1);if(h&&h[0]){const k=e.findIndex(x=>x.id===h[0].episode_id);if(k>=0)f=h[0].completed&&e[k+1]?e[k+1]:e[k]}}play(f.id)}}
const tgD=()=>{const d=$('#dt');d.style.display=d.style.display==='none'?'block':'none'};
function wtab(k){S.wt=k;['fy','cm'].forEach(x=>{const e=$('#t-'+x);if(e)e.classList.toggle('on',x===k)});const el=$('#wc');if(!el)return;
 if(k==='cm')return loadC();const L=S.titles.filter(x=>x.id!==(CUR&&CUR.id)).sort((a,b)=>(b.type===CUR.type)-(a.type===CUR.type)||b.view_count-a.view_count).slice(0,24);
 el.innerHTML=L.length?`<div class="grid">${L.map(card).join('')}</div>`:'<p class="msg">No other titles yet.</p>'}
async function loadC(){const el=$('#wc');el.innerHTML='<p class="msg">Loading…</p>';const {data}=await sb.from('cv_comments').select('*').eq('title_id',CUR.id).order('created_at',{ascending:false}).limit(50);if(S.wt!=='cm')return;
 el.innerHTML=(S.user?`<div class="pad"><textarea class="f" id="cb" maxlength="500" placeholder="Write a comment…"></textarea><button class="btn mt" onclick="postC()">Post</button></div>`:'<p class="msg">Sign in to comment.</p>')+(data&&data.length?data.map(c=>`<div class="cmt"><b>${esc(c.name)}</b> <span class="s">${esc(new Date(c.created_at).toLocaleDateString())}</span><p>${esc(c.body)}</p>${S.user&&(c.user_id===S.user.id||S.admin)?`<a class="s" onclick="delC('${c.id}')">Delete</a>`:''}</div>`).join(''):'<p class="msg">No comments yet. Be the first.</p>')}
async function postC(){const b=$('#cb').value.trim();if(!b)return;const nm=((S.user.user_metadata||{}).name||(S.user.email||'').split('@')[0]).slice(0,50);const {error}=await sb.from('cv_comments').insert({title_id:CUR.id,user_id:S.user.id,name:nm,body:b});if(error)return toast(error.message);loadC()}
async function delC(id){if(!confirm('Delete this comment?'))return;await sb.from('cv_comments').delete().eq('id',id);loadC()}
async function vurl(a){if(a.provider==='b2'){const {data,error}=await sb.functions.invoke('cv-b2',{body:{action:'get',asset_id:a.id}});if(error||!data||!data.url){toast('Could not load video.');return''}return data.url}return(await src(a.storage_path))||''}
async function rmA(l){const sp=l.filter(a=>a.provider!=='b2').map(a=>a.storage_path);await rmF('cv-media',sp);for(const a of l.filter(a=>a.provider==='b2')){const {data,error}=await sb.functions.invoke('cv-b2',{body:{action:'delete',key:a.storage_path}});if(error||!(data&&data.ok))throw new Error('could not delete the file from Backblaze B2')}}
function putB2(u,f){return new Promise((ok,no)=>{const x=new XMLHttpRequest();x.open('PUT',u);x.setRequestHeader('Content-Type',f.type||'video/mp4');x.upload.onprogress=e=>{if(e.lengthComputable)upUI('Uploading '+Math.floor(e.loaded*100/e.total)+'%… keep this page open',e.loaded*100/e.total)};x.onload=()=>x.status<300?ok():no(new Error('storage error '+x.status));x.onerror=()=>no(new Error('network or CORS error. Check the bucket CORS setting'));x.send(f)})}
async function assets(eid){const {data}=await sb.from('cv_video_assets').select('id,quality,storage_path,provider').eq('episode_id',eid);return(data||[]).sort((a,b)=>QO.indexOf(b.quality)-QO.indexOf(a.quality))}
async function src(p,t,opt){const {data,error}=await sb.storage.from('cv-media').createSignedUrl(p,3600,opt);if(error)return toast('Could not load video.');return data.signedUrl}
async function play(eid){A=await assets(eid);if(!A.length){toast('No video uploaded yet.');return}const v=$('#vp');if(!v)return;v.style.display='block';document.querySelectorAll('.ec').forEach(c=>c.classList.toggle('on',c.id==='ec-'+eid));pLoad(eid);
 let i0=0;if(ST.saver||(navigator.connection&&(navigator.connection.saveData||/2g|3g/.test(navigator.connection.effectiveType||'')))){const j=A.findIndex(a=>QO.indexOf(a.quality)<=1);if(j>=0)i0=j}
 $('#qs').innerHTML=A.length>1?`<select class="f" id="ql">${A.map((a,i)=>`<option value="${i}" ${i===i0?'selected':''}>${a.quality}</option>`).join('')}</select>`:'';
 let start=0;if(S.user){const {data}=await sb.from('cv_watch_progress').select('position_seconds,completed').eq('user_id',S.user.id).eq('episode_id',eid).maybeSingle();if(data&&!data.completed&&ST.auto)start=data.position_seconds;fire(sb.rpc('cv_record_view',{p_title:CUR.id}))}
 const set=async(i,at)=>{v.src=await vurl(A[i]);v.onloadedmetadata=()=>{if(at)v.currentTime=at;v.play().catch(()=>{})}};
 if($('#ql'))$('#ql').onchange=e=>{P.qi=+e.target.value;set(P.qi,v.currentTime)};P.A=A;P.qi=i0;P.setQ=i=>{P.qi=i;const q=$('#ql');if(q)q.value=i;set(i,v.currentTime)};set(i0,start);
 const save=done=>{if(S.user)fire(sb.from('cv_watch_progress').upsert({user_id:S.user.id,episode_id:eid,position_seconds:Math.floor(v.currentTime),completed:!!done}))};
 v.ontimeupdate=()=>{if(Date.now()-last>15000){last=Date.now();save()}};v.onpause=()=>save();v.onended=()=>{save(true);const i=EPS.findIndex(x=>x.id===eid);if(ST.next&&!P.noNext&&EPS[i+1])play(EPS[i+1].id)}}
async function down(eid){const a=await assets(eid);if(!a.length)return toast('No video uploaded yet.');const u=await src(a[0].storage_path,0,{download:true});if(u)location.href=u}
async function wl(id){if(!S.user){closeW();nav('me');return toast('Sign in to save titles.')}
 if(S.wl.has(id)){await sb.from('cv_watchlist').delete().eq('user_id',S.user.id).eq('title_id',id);S.wl.delete(id)}else{await sb.from('cv_watchlist').insert({user_id:S.user.id,title_id:id});S.wl.add(id)}
 $('#wb').textContent=S.wl.has(id)?'✓ My List':'+ My List'}
function openWL(){S.list={name:'My List',items:S.titles.filter(t=>S.wl.has(t.id))};S.lb='me';S.nav='list';go()}
async function me(){const a=$('#app');
 if(!S.user)return a.innerHTML=`<div class="pad"><div class="sec" style="padding-left:0"><h3>Sign in</h3></div><input class="f" id="em" type="email" placeholder="Email" autocomplete="email"><div class="pwr"><input class="f" id="pw" type="password" placeholder="Password (6+ characters)" autocomplete="current-password"><button type="button" class="eye" onclick="tp(this)">Show</button></div><input class="f" id="nm" placeholder="Your name (only needed for Create account)" autocomplete="name"><button class="btn mt" style="width:100%" onclick="auth('in')">Sign in</button><button class="btn g mt" style="width:100%" onclick="auth('up')">Create account</button><p class="s" style="text-align:center"><a onclick="forgot()" style="color:var(--a)">Forgot password?</a></p><p class="s">Sign in to keep a watchlist and continue watching where you stopped.</p></div><div class="mt">${mi('⚙','Settings',"nav('set')")}</div>`;
 const nm=(S.user.user_metadata||{}).name||(S.user.email||'').split('@')[0];a.innerHTML=`<div class="prof"><div class="av">${esc(nm.charAt(0).toUpperCase())}</div><div><b>${esc(nm)}</b><p class="s">ID: ${esc(S.user.id.slice(0,8))}</p></div></div>`+(S.admin?'<div class="pad" id="stats"><p class="s">Loading stats…</p></div>':'')+mi('☰','My List',"openWL()",S.wl.size)+mi('⏱','Watch History',"nav('hist')")+mi('✎','Change name',"chName()")+mi('✉','Feedback',"nav('fb')")+mi('⚙','Settings',"nav('set')")+(S.admin?mi('🎬','Admin: add titles and videos',"nav('adm')"):'');if(S.admin)stats()}
async function histV(){const a=$('#app');a.innerHTML=bar('Watch History','me')+'<p class="msg">Loading…</p>';const {data:H}=await sb.from('cv_my_history').select('*').limit(50);
 a.innerHTML=bar('Watch History','me')+(H&&H.length?H.map(h=>`<div class="rw" onclick="openT('${h.title_id}')"><div class="po" style="${bg(h.poster_url)}"></div><div><b>${esc(h.title)}</b><p class="s">${h.type==='movie'?'':'S'+h.season+' E'+h.episode+' · '}${h.completed?'Watched':'Stopped at '+Math.floor(h.position_seconds/60)+':'+String(h.position_seconds%60).padStart(2,'0')}</p></div></div>`).join(''):'<p class="msg">Nothing watched yet.</p>')}
function setV(){const tg=(k,l,d)=>`<div class="mi"><span>${l}<p class="s">${d}</p></span><label class="sw"><input type="checkbox" ${ST[k]?'checked':''} onchange="setS('${k}',this.checked)"><i></i></label></div>`;
 return bar('Settings',S.user?'me':'me')+`<div class="mi"><span>Download quality<p class="s">Default for downloads</p></span><select class="f sm" style="width:110px" onchange="setS('q',this.value)">${[['best','Highest'],['720p','720p'],['480p','480p'],['360p','360p']].map(o=>`<option value="${o[0]}" ${ST.q===o[0]?'selected':''}>${o[1]}</option>`).join('')}</select></div>`+
 tg('saver','Data saver','Start playback at 480p or lower')+tg('auto','Resume where you stopped','Continue from your last position')+tg('next','Play next episode','Automatically start the next episode')+tg('pip','Mini player','Keep playing in a small window when you leave the page (where your browser supports it)')+
 pushRow()+tg('snd','Intro sound','Play a short sound with the welcome animation')+mi('↻','Check for update',"location.reload()")+mi('ⓘ','About us',"pageV('about')")+mi('🔒','Privacy Policy',"pageV('privacy')")+mi('📄','User Agreement',"pageV('terms')")+
 mi('✕','Clear search history',"localStorage.removeItem('cv-recent');toast('Search history cleared.')")+(S.user?mi('🗑','Clear watch history',"clearH()")+mi('⎋','Log out',"out();nav('home')"):'')}
async function clearH(){if(!confirm('Clear your watch history?'))return;await sb.from('cv_watch_progress').delete().eq('user_id',S.user.id);toast('Watch history cleared.')}
const fbV=()=>bar('Feedback','me')+`<div class="pad"><textarea class="f" id="fbT" maxlength="2000" placeholder="Tell us what to fix or add"></textarea><button class="btn mt" onclick="fbSend()">Send feedback</button></div>`;
async function fbSend(){const m=gv('fbT');if(!m)return toast('Write a message first.');const {error}=await sb.from('cv_feedback').insert({user_id:S.user.id,message:m});toast(error?error.message:'Thank you! Feedback sent.');if(!error)nav('me')}
function upForms(){return `<div class="pad"><div class="sec" style="padding-left:0"><h3>Add title</h3></div>
 <input class="f" id="aT" placeholder="Title"><select class="f" id="aY"><option value="movie">Movie</option><option value="series">Series</option><option value="anime">Anime</option></select>
 <input class="f" id="aC" placeholder="Country (e.g. Ghana, Nigeria, Korea, US, UK)"><input class="f" id="aG" placeholder="Genres, comma separated"><input class="f" id="aR" type="number" placeholder="Release year">
 <input class="f" id="aM" placeholder="Age rating (e.g. PG-13)"><input class="f" id="aL" type="number" placeholder="Runtime in minutes"><input class="f" id="aD" placeholder="Description"><input class="f" id="aDr" placeholder="Director"><input class="f" id="aCa" placeholder="Cast, comma separated">
 <p class="s">Poster</p><input class="f" id="aP" type="file" accept="image/*"><p class="s">Backdrop (wide)</p><input class="f" id="aB" type="file" accept="image/*">
 <input class="f" id="aLn" placeholder="License note (who gave you the rights)"><p class="s"><label><input type="checkbox" id="aF"> Featured on home</label> &nbsp; <label><input type="checkbox" id="aDl"> Allow downloads</label></p>
 <p class="s"><label><input type="checkbox" id="aRt"> I confirm CineVerse has the rights to distribute this title.</label></p><button class="btn mt" onclick="addT()">Publish title</button>
 <div class="sec" style="padding-left:0"><h3>Add video</h3></div><select class="f" id="eT">${S.titles.map(t=>`<option value="${t.id}">${esc(t.title)}</option>`).join('')}</select>
 <input class="f" id="eS" type="number" value="1" placeholder="Season"><input class="f" id="eN" type="number" value="1" placeholder="Episode"><input class="f" id="eNm" placeholder="Episode name (optional)">
 <select class="f" id="eQ"><option>1080p</option><option>720p</option><option>480p</option><option>360p</option><option>4k</option></select><input class="f" id="eF" type="file" accept="video/*">
 <p class="s">Big files go to Backblaze B2 in small pieces, so there is no practical size limit once it is connected (check the System tab). Until then Supabase's 50MB limit applies. Movies use Season 1, Episode 1.</p><button class="btn mt" onclick="addE()">Upload video</button><div id="upb" class="upb"><i id="upi"></i><span id="upt"></span></div>
 <div class="sec" style="padding-left:0"><h3>Add subtitles</h3></div><p class="s">Upload an .srt or .vtt file for an episode that already has a video.</p>
 <select class="f" id="sT">${S.titles.map(t=>`<option value="${t.id}">${esc(t.title)}</option>`).join('')}</select><input class="f" id="sS" type="number" value="1" placeholder="Season"><input class="f" id="sN" type="number" value="1" placeholder="Episode"><input class="f" id="sL" placeholder="Language (for example English)"><input class="f" id="sF" type="file" accept=".srt,.vtt,text/vtt,text/plain"><button class="btn mt" onclick="addSub()">Upload subtitles</button><p class="s" id="sMsg"></p></div>`}
const gv=i=>$('#'+i).value.trim(),csv=i=>gv(i).split(',').map(x=>x.trim()).filter(Boolean);
async function upImg(f){if(!f)return null;const p=Date.now()+'-'+f.name.replace(/[^\w.-]/g,'_');const r=await sb.storage.from('cv-posters').upload(p,f);if(r.error)throw r.error;return sb.storage.from('cv-posters').getPublicUrl(p).data.publicUrl}
async function addT(){if(!gv('aT'))return toast('Enter a title.');if(!$('#aRt').checked)return toast('Confirm you have the distribution rights first.');if(!gv('aLn'))return toast('Fill in the license note: who gave you the right to show this title?');toast('Saving…');
 try{const row={title:gv('aT'),type:gv('aY'),country:gv('aC')||null,genres:csv('aG'),release_year:+gv('aR')||null,maturity_rating:gv('aM')||null,runtime_minutes:+gv('aL')||null,description:gv('aD')||null,director:gv('aDr')||null,cast_names:csv('aCa'),
 poster_url:await upImg($('#aP').files[0]),backdrop_url:await upImg($('#aB').files[0]),license_note:gv('aLn')||null,featured:$('#aF').checked,allow_download:$('#aDl').checked,rights_confirmed:true,published:true};
 const {error}=await sb.from('cv_titles').insert(row);if(error)throw error;toast('Title published ✅');await load();me()}catch(e){toast('Could not save: '+(e.message||e))}}
async function addE(){const f=$('#eF').files[0],tid=$('#eT').value;if(!tid||!f)return upUI('Choose a title and a video file first.',0,1);
 const s=+gv('eS')||1,n=+gv('eN')||1,q=$('#eQ').value;upUI('Preparing…',2);let WL=null;try{WL=await navigator.wakeLock.request('screen')}catch(e){}
 window.onbeforeunload=e=>{e.preventDefault();return''};
 try{let {data:ep}=await sb.from('cv_episodes').select('id').eq('title_id',tid).eq('season',s).eq('episode',n).maybeSingle();
  if(!ep){const r=await sb.from('cv_episodes').insert({title_id:tid,season:s,episode:n,name:gv('eNm')||null,published:true}).select('id').single();if(r.error)throw r.error;ep=r.data}
  const {data:old}=await sb.from('cv_video_assets').select('storage_path,provider').eq('episode_id',ep.id).eq('quality',q).maybeSingle();let prov='supabase',p;
  try{if(f.size>100*1048576){p=await mpUp(f,ep.id,q);prov='b2'}
   else{const sg=await sb.functions.invoke('cv-b2',{body:{action:'put',episode_id:ep.id,quality:q,filename:f.name}});
    if(sg.data&&sg.data.url){p=sg.data.key;prov='b2';await putB2(sg.data.url,f)}else if(sg.data&&sg.data.reason==='not_configured')throw new Error('not_configured');else throw new Error((sg.data&&sg.data.error)||(sg.error&&sg.error.message)||'not allowed')}}
  catch(x){if(x.message!=='not_configured')throw x;
   if(f.size>50*1048576){upUI("Backblaze B2 isn't connected yet, and Supabase can't take files over 50MB. Open the System tab to check the Backblaze setup.",0,1);return}
   upUI('Uploading to Supabase…',30);p=ep.id+'/'+q+'-'+Date.now()+'-'+f.name.replace(/[^\w.-]/g,'_');const u=await sb.storage.from('cv-media').upload(p,f,{contentType:f.type});if(u.error)throw u.error;prov='supabase'}
  const r=await sb.from('cv_video_assets').upsert({episode_id:ep.id,quality:q,storage_path:p,size_bytes:f.size,provider:prov},{onConflict:'episode_id,quality'});if(r.error)throw r.error;
  if(old&&old.storage_path!==p)await rmA([old]).catch(()=>{});upUI((old?'Video replaced':'Video uploaded')+' ✅ ('+mb(f.size)+')',100);$('#eF').value=''}
 catch(x){upUI('Upload failed: '+(x.message||x),0,1)}finally{window.onbeforeunload=null;if(WL)WL.release().catch(()=>{})}}

let M={T:[],E:[],A:[]};
const mb=n=>n?(n/1048576).toFixed(1)+' MB':'';
async function mgr(){const el=$('#mgr');if(!el)return;const [t,e,a,sx]=await Promise.all([sb.from('cv_titles').select('id,title,poster_url,backdrop_url,published,featured,view_count,license_expires_on').order('created_at',{ascending:false}),sb.from('cv_episodes').select('id,title_id,season,episode,intro_start,intro_end,credits_start').order('season').order('episode'),sb.from('cv_video_assets').select('id,episode_id,quality,storage_path,size_bytes,provider'),sb.from('cv_subtitles').select('id,episode_id,language')]);M={T:t.data||[],E:e.data||[],A:a.data||[],S:sx.data||[]};mgrR()}
function mgrR(){const el=$('#mgr');if(!el)return;const q=S.tq.toLowerCase(),L=M.T.filter(t=>t.title.toLowerCase().includes(q)&&(S.tf==='All'||(S.tf==='Published'&&t.published)||(S.tf==='Hidden'&&!t.published)||(S.tf==='Featured'&&t.featured))),tot=M.A.reduce((x,y)=>x+(y.size_bytes||0),0),n=S.sel.size,bk=$('#bk');
 if(bk)bk.innerHTML=`<p class="s mt">${M.T.length} titles · ${M.A.length} videos · ${mb(tot)||'0 MB'} stored</p>`+(n?`<div class="chips"><span class="on">${n} selected</span><span onclick="bulk('pub')">Publish</span><span onclick="bulk('hide')">Hide</span><span onclick="bulk('feat')">Feature</span><span onclick="bulk('unf')">Unfeature</span><span onclick="bulk('del')" style="color:#ff8a8a">Delete</span></div>`:'');
 el.innerHTML=L.length?L.map(t=>{const x=t.license_expires_on&&new Date(t.license_expires_on)<new Date(Date.now()+30*864e5);return `<div class="mi" style="display:block"><div style="display:flex;gap:10px;align-items:center"><input type="checkbox" ${S.sel.has(t.id)?'checked':''} onchange="sel('${t.id}',this.checked)"><b style="flex:1;min-width:0">${esc(t.title)}${t.published?'':'<span class="tag">Hidden</span>'}${t.featured?'<span class="tag">★</span>':''}${x?'<span class="tag" style="color:#ff9a9a">License</span>':''}</b></div>
 <div class="chips mt"><span onclick="tg('${t.id}','published',${!t.published})">${t.published?'Hide':'Publish'}</span><span onclick="tg('${t.id}','featured',${!t.featured})">${t.featured?'Unfeature':'Feature'}</span><span onclick="editT('${t.id}')">Edit</span><span onclick="delT('${t.id}')" style="color:#ff8a8a">Delete</span></div>
 ${M.E.filter(e=>e.title_id===t.id).map(e=>`<div class="s">S${e.season} E${e.episode}: ${M.A.filter(a=>a.episode_id===e.id).map(a=>`<span onclick="delA('${a.id}')" style="color:#fff;padding:6px 8px 6px 0;display:inline-block">${a.quality} ${mb(a.size_bytes)} ✕</span>`).join('')||'<span style="color:#ff9a9a">no video </span>'}<span onclick="mk('${e.id}')" style="color:#ffe08a;padding:6px 8px 6px 0;display:inline-block">${e.intro_end!=null||e.credits_start!=null?'markers ✓':'markers'}</span>${(M.S||[]).filter(z=>z.episode_id===e.id).map(z=>`<span onclick="delS('${z.id}')" style="color:#9fd8ff;padding:6px 8px 6px 0;display:inline-block">CC ${esc(z.language)} ✕</span>`).join('')}<span onclick="delE('${e.id}')" style="color:#ff8a8a;padding:6px;display:inline-block">remove episode</span></div>`).join('')}</div>`}).join(''):'<p class="msg">No titles match.</p>'}
const sel=(id,on)=>{on?S.sel.add(id):S.sel.delete(id);mgrR()};
async function tg(id,f,v){const {error}=await sb.from('cv_titles').update({[f]:v}).eq('id',id);if(error)return toast(error.message);toast('Updated.');await load();mgr()}
async function bulk(op){const ids=[...S.sel];if(!ids.length)return;if(op==='del'){if(!confirm('Delete '+ids.length+' titles with all their videos? This cannot be undone.'))return;for(const id of ids)await delT(id,1)}
 else{const u={pub:{published:true},hide:{published:false},feat:{featured:true},unf:{featured:false}}[op],{error}=await sb.from('cv_titles').update(u).in('id',ids);if(error)return toast(error.message);toast('Done.')}S.sel.clear();await load();mgr()}
const pth=(u,b)=>{if(!u)return null;const i=u.indexOf('/'+b+'/');return i<0?null:decodeURIComponent(u.slice(i+b.length+2).split('?')[0])};
async function rmF(b,p){p=p.filter(Boolean);if(p.length){const r=await sb.storage.from(b).remove(p);if(r.error)throw r.error}}
async function delT(id,nc){const t=M.T.find(x=>x.id===id);if(!t||(!nc&&!confirm('Delete "'+t.title+'" with all its episodes, videos and posters? This cannot be undone.')))return;
 try{const ep=M.E.filter(e=>e.title_id===id).map(e=>e.id);await rmA(M.A.filter(a=>ep.includes(a.episode_id)));await rmF('cv-posters',[pth(t.poster_url,'cv-posters'),pth(t.backdrop_url,'cv-posters')]);
 const {error}=await sb.from('cv_titles').delete().eq('id',id);if(error)throw error;toast('Title deleted.');await load();mgr()}catch(e){toast('Could not delete: '+(e.message||e))}}
async function delA(id){const a=M.A.find(x=>x.id===id);if(!a||!confirm('Delete this '+a.quality+' video?'))return;
 try{await rmA([a]);const {error}=await sb.from('cv_video_assets').delete().eq('id',id);if(error)throw error;toast('Video deleted.');mgr()}catch(e){toast('Could not delete: '+(e.message||e))}}
async function delE(id){if(!confirm('Remove this episode and its videos?'))return;
 try{await rmA(M.A.filter(a=>a.episode_id===id));const {error}=await sb.from('cv_episodes').delete().eq('id',id);if(error)throw error;toast('Episode removed.');mgr()}catch(e){toast('Could not delete: '+(e.message||e))}}
const OWNER='[OWNER NAME]',EMAIL='[CONTACT EMAIL]';
const PGT={about:'About CineVerse',contact:'Contact',privacy:'Privacy Policy',terms:'Terms & Copyright'};
const PG={
about:`<p>CineVerse is a streaming website for films, series and anime. We feature titles that we own, have produced, or have written permission to show, with a focus on Ghanaian and African stories alongside titles from around the world.</p><h4>What you can do</h4><p>Browse the catalogue, search by title, country or genre, save titles to your list, and continue where you stopped. Creating an account is free.</p><h4>Who runs it</h4><p>CineVerse is run by ${OWNER}, based in Ghana.</p><h4>Our content promise</h4><p>We only publish content we have the right to show. If you are a rights holder and see something that should not be here, contact us and we will act quickly.</p>`,
contact:`<p>For questions, feedback, account help or takedown requests, email <a href="mailto:${EMAIL}">${EMAIL}</a>. We aim to reply within 3 working days.</p><h4>Rights holders</h4><p>To report content you own, follow the steps in Terms &amp; Copyright.</p><h4>Owner</h4><p>${OWNER}, Ghana.</p>`,
privacy:`<p>Last updated: 12 October 2026.</p><h4>What we collect</h4><p>If you create an account: your email address, your name, and your password (stored securely by our provider, never visible to us). When you use the site: titles saved to My List and your watch progress. If you request a title or send feedback, we keep it. We also count visits using a random ID stored in your browser, not linked to your name or email. Downloads you save stay in your browser's storage for this site on your device.</p><h4>How we use it</h4><p>To run your account, remember your list and progress, show the catalogue, and keep the site secure. We do not sell your personal data.</p><h4>Service providers</h4><p>CineVerse uses Supabase for accounts, the database and files, and GitHub Pages to serve the website.</p><h4>Cookies and advertising</h4><p>We use browser storage to keep you signed in and remember your settings. If we show ads in future, third-party vendors including Google may use cookies to serve ads based on your visits to this and other sites. You can opt out of personalised ads at <a href="https://adssettings.google.com">Google Ads Settings</a> or <a href="https://www.aboutads.info">aboutads.info</a>.</p><h4>Your choices</h4><p>Ask us to access, correct or delete your account and data at <a href="mailto:${EMAIL}">${EMAIL}</a>. You can clear site data in your browser at any time.</p><h4>Children</h4><p>CineVerse is not directed at children under 13, and we do not knowingly collect their data.</p>`,
terms:`<p>Last updated: 12 October 2026. By using CineVerse you agree to these terms.</p><h4>Using the site</h4><p>Use CineVerse for personal, non-commercial viewing. Do not copy, record, resell or re-upload content, try to break the site, or use someone else's account. We may suspend accounts that break these rules.</p><h4>Content and rights</h4><p>We publish only titles we own, have produced, or are licensed to show. Titles and artwork belong to their owners.</p><h4>Report a copyright problem</h4><p>Email <a href="mailto:${EMAIL}">${EMAIL}</a> with: your name and contact details; the title and where it appears; proof that you own or represent the rights; and a statement that your information is accurate. We will review it promptly and remove content that is not authorised.</p><h4>Availability and liability</h4><p>CineVerse is provided as is. We do not guarantee uninterrupted service and are not liable for losses from using it, to the extent the law allows.</p><h4>Contact</h4><p>${OWNER}, Ghana. <a href="mailto:${EMAIL}">${EMAIL}</a>.</p>`};
function pageV(k){S.pg=k;S.nav='pg';S.sf=false;go();scrollTo(0,0)}
let ET=null;
async function editT(id){const {data:t}=await sb.from('cv_titles').select('*').eq('id',id).single();if(!t)return;ET=t;$('#sheet').classList.add('open');
 const v=(i,x)=>`id="${i}" value="${esc(x==null?'':x)}"`;
 $('#sb').innerHTML=`<div class="pad"><div class="sec" style="padding-left:0"><h3>Edit title</h3><a onclick="shut()">Close</a></div>
 <input class="f" ${v('xT',t.title)} placeholder="Title"><select class="f" id="xY">${['movie','series','anime'].map(o=>`<option ${t.type===o?'selected':''}>${o}</option>`).join('')}</select>
 <input class="f" ${v('xC',t.country)} placeholder="Country"><input class="f" ${v('xG',(t.genres||[]).join(', '))} placeholder="Genres, comma separated"><input class="f" type="number" ${v('xR',t.release_year)} placeholder="Release year"><input class="f" ${v('xM',t.maturity_rating)} placeholder="Age rating"><input class="f" type="number" ${v('xL',t.runtime_minutes)} placeholder="Runtime in minutes"><input class="f" ${v('xD',t.description)} placeholder="Description"><input class="f" ${v('xDr',t.director)} placeholder="Director"><input class="f" ${v('xCa',(t.cast_names||[]).join(', '))} placeholder="Cast, comma separated">
 <p class="s">New poster (leave empty to keep the current one)</p><input class="f" id="xP" type="file" accept="image/*"><p class="s">New backdrop</p><input class="f" id="xB" type="file" accept="image/*">
 <p class="s"><label><input type="checkbox" id="xF" ${t.featured?'checked':''}> Featured</label> &nbsp; <label><input type="checkbox" id="xDl" ${t.allow_download?'checked':''}> Allow downloads</label> &nbsp; <label><input type="checkbox" id="xPb" ${t.published?'checked':''}> Published</label></p>
 <button class="btn mt" style="width:100%" onclick="saveT()">Save changes</button><p class="s">To replace a video, use Add video with the same title, season, episode and quality. The old file is removed automatically.</p></div>`}
async function saveT(){const g=i=>$('#'+i).value.trim(),cs=i=>g(i).split(',').map(x=>x.trim()).filter(Boolean);if(!g('xT'))return toast("Title can't be empty.");toast('Saving…');
 try{const o={title:g('xT'),type:$('#xY').value,country:g('xC')||null,genres:cs('xG'),release_year:+g('xR')||null,maturity_rating:g('xM')||null,runtime_minutes:+g('xL')||null,description:g('xD')||null,director:g('xDr')||null,cast_names:cs('xCa'),featured:$('#xF').checked,allow_download:$('#xDl').checked,published:$('#xPb').checked};
 const p=await upImg($('#xP').files[0]),b=await upImg($('#xB').files[0]);if(p){o.poster_url=p;await rmF('cv-posters',[pth(ET.poster_url,'cv-posters')])}if(b){o.backdrop_url=b;await rmF('cv-posters',[pth(ET.backdrop_url,'cv-posters')])}
 const {error}=await sb.from('cv_titles').update(o).eq('id',ET.id);if(error)throw error;toast('Saved ✅');shut();await load();mgr()}catch(e){toast('Could not save: '+(e.message||e))}}
async function stats(){const el=$('#stats');if(!el)return;const {data}=await sb.rpc('cv_visit_stats');el.innerHTML=data?`<div class="stats" style="padding:0"><div><b>${data.unique_visitors}</b><span>Visitors</span></div><div><b>${data.today}</b><span>Visits today</span></div><div><b>${data.members}</b><span>Members</span></div></div>`:''}
async function chName(){const n=(prompt('Your name',(S.user.user_metadata||{}).name||'')||'').trim().slice(0,50);if(!n)return;const {data,error}=await sb.auth.updateUser({data:{name:n}});if(error)return toast(error.message);S.user=data.user;await sb.from('cv_profiles').update({display_name:n}).eq('user_id',S.user.id);toast('Name updated.');go()}
function introSound(){if(!ST.snd)return;try{const A=new(window.AudioContext||window.webkitAudioContext)(),t=A.currentTime,m=A.createGain(),f=A.createBiquadFilter();f.type='lowpass';f.frequency.setValueAtTime(500,t);f.frequency.exponentialRampToValueAtTime(2400,t+3.2);m.gain.value=.9;f.connect(m);m.connect(A.destination);
 [[130.81,.05],[196,.04],[261.63,.045],[329.63,.035],[392,.03]].forEach(([fr,v],i)=>{const o=A.createOscillator(),g=A.createGain();o.type='sine';o.frequency.value=fr;o.detune.value=i%2?4:-4;g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(v,t+1.8);g.gain.setValueAtTime(v,t+3.4);g.gain.exponentialRampToValueAtTime(.0008,t+6.2);o.connect(g);g.connect(f);o.start(t);o.stop(t+6.3)});
 [[783.99,3.1],[1046.5,3.28]].forEach(([fr,at])=>{const o=A.createOscillator(),g=A.createGain();o.type='sine';o.frequency.value=fr;g.gain.setValueAtTime(0,t+at);g.gain.linearRampToValueAtTime(.07,t+at+.03);g.gain.exponentialRampToValueAtTime(.0008,t+at+2.6);o.connect(g);g.connect(A.destination);o.start(t+at);o.stop(t+at+2.7)})}catch(e){}}
function welcome(n){const d=document.createElement('div');d.className='in';d.innerHTML=`<canvas class="ic"></canvas><div class="il">C</div><div class="iw"><small>Welcome to</small><em>CineVerse</em>${n?`<b>${esc(n)}</b>`:''}</div>`;document.body.append(d);
 let raf,done=false;const rmv=()=>{if(done)return;done=true;cancelAnimationFrame(raf);d.classList.add('out');setTimeout(()=>d.remove(),420)};d.onclick=rmv;introSound();
 if(matchMedia('(prefers-reduced-motion:reduce)').matches){d.classList.add('rm');setTimeout(rmv,3200);return}
 const c=d.querySelector('canvas'),x=c.getContext('2d'),W=c.width=innerWidth,H=c.height=innerHeight,cols=['#19e3b1','#4da3ff','#ff4d9d','#ffffff','#7a5cff','#19e3b1'];
 const bars=[...Array(Math.ceil(W/8))].map((_,k,a)=>({x:k/a.length*W+Math.random()*6,w:2+Math.random()*9,c:cols[Math.random()*cols.length|0],a:.35+Math.random()*.65,s:Math.random()-.5}));
 let P=[];const burst=()=>{const cx=W*(.15+Math.random()*.7),cy=H*(.12+Math.random()*.4),h=Math.random()*360;for(let i=0;i<48;i++){const a=Math.PI*2*i/48,v=2+Math.random()*3.6;P.push({x:cx,y:cy,vx:Math.cos(a)*v,vy:Math.sin(a)*v,l:1,h})}};
 const t0=performance.now(),lp=t=>{const e=(t-t0)/1000;
  if(e<3.1){x.clearRect(0,0,W,H);const p=Math.min(1,Math.max(0,(e-1.5)/1.6));
   if(p>0&&p<1){const k=p<.5?2*p*p:1-Math.pow(-2*p+2,2)/2,al=Math.sin(Math.PI*p);x.globalCompositeOperation='lighter';
    bars.forEach(b=>{const bx=W/2+(b.x-W/2)*(.15+.85*k)+b.s*k*80,w=b.w*(.4+1.6*k),g=x.createLinearGradient(bx-w,0,bx+w,0);g.addColorStop(0,'rgba(0,0,0,0)');g.addColorStop(.5,b.c);g.addColorStop(1,'rgba(0,0,0,0)');x.globalAlpha=Math.min(1,al*b.a*1.25);x.fillStyle=g;x.fillRect(bx-w,0,w*2,H)});x.globalAlpha=1;x.globalCompositeOperation='source-over'}}
  else{x.fillStyle='rgba(0,0,0,.22)';x.fillRect(0,0,W,H);P.forEach(p=>{p.x+=p.vx;p.y+=p.vy;p.vy+=.045;p.vx*=.985;p.l-=.011;x.fillStyle=`hsla(${p.h},100%,62%,${Math.max(p.l,0)})`;x.fillRect(p.x,p.y,2.8,2.8)});P=P.filter(p=>p.l>0);if(e<5.6&&Math.random()<.09)burst();if(e>3.15&&!P.length&&e<3.4)burst()}
  if(e>6.4)return rmv();raf=requestAnimationFrame(lp)};lp(t0)}
try{let v=localStorage.getItem('cv-vid');if(!v){v=crypto.randomUUID();localStorage.setItem('cv-vid',v)}fire(sb.from('cv_visits').insert({visitor_id:v}))}catch(e){}
Object.assign(S,{at:'ov',tf:'All',tq:'',sel:new Set()});
const upUI=(t,p,e)=>{const b=$('#upb');if(!b)return;b.style.display='block';$('#upt').textContent=t;if(p!=null)$('#upi').style.width=p+'%';b.classList.toggle('er',!!e)},sleep=ms=>new Promise(r=>setTimeout(r,ms));
function putPart(u,blob,pr){return new Promise((ok,no)=>{const x=new XMLHttpRequest();x.open('PUT',u);x.timeout=900000;x.upload.onprogress=e=>e.lengthComputable&&pr(e.loaded);x.onload=()=>x.status<300?ok():no(new Error('part rejected ('+x.status+')'));x.onerror=()=>no(new Error('network or CORS error'));x.ontimeout=()=>no(new Error('timed out'));x.send(blob)})}
async function errMsg(er){if(!er)return'';try{const j=await er.context.json();return j.error||j.reason||er.message}catch(e){return er.message||''}}
async function mpUp(f,ep,q){const cl=a=>sb.functions.invoke('cv-b2',{body:a});const {data:st,error:se}=await cl({action:'mp_start',episode_id:ep,quality:q,filename:f.name});
 if(st&&st.reason==='not_configured')throw new Error('not_configured');if(!st||!st.uploadId)throw new Error((st&&st.error)||await errMsg(se)||'could not start the upload');
 const PS=64*1048576,N=Math.ceil(f.size/PS),L=new Array(N+1).fill(0);let nx=1,fail=null;
 const tick=()=>{const t=L.reduce((a,b)=>a+b,0);upUI('Uploading '+Math.floor(t*100/f.size)+'% ('+mb(t)+' of '+mb(f.size)+'). Keep this page open and your screen on.',t*100/f.size)};
 const w=async()=>{while(!fail){const n=nx++;if(n>N)return;const b=f.slice((n-1)*PS,Math.min(n*PS,f.size));
  for(let a=1;;a++){try{const {data:g,error:ge}=await cl({action:'mp_part',key:st.key,uploadId:st.uploadId,n});if(!g||!g.url)throw new Error(await errMsg(ge)||'no upload link');await putPart(g.url,b,l=>{L[n]=l;tick()});L[n]=b.size;tick();break}
   catch(e){L[n]=0;if(a>=4){fail=e;return}upUI('Part '+n+' of '+N+' failed ('+e.message+'). Retrying '+a+'/3…');await sleep(2000*a)}}}};
 await Promise.all([w(),w(),w()]);if(fail){await cl({action:'mp_abort',key:st.key,uploadId:st.uploadId});throw fail}
 upUI('Finishing upload…',99);const {data:d,error:de}=await cl({action:'mp_done',key:st.key,uploadId:st.uploadId,n:N});if(!d||!d.ok)throw new Error((d&&d.error)||await errMsg(de)||'could not finish the upload');return st.key}
function admin(){return `<div class="chips pad mt">${[['ov','Overview'],['ti','Titles'],['up','Upload'],['in','Inbox'],['ad','Ads'],['mb','Members'],['nt','Notify'],['sy','System']].map(x=>`<span id="at-${x[0]}" onclick="admT('${x[0]}')">${x[1]}</span>`).join('')}</div><div id="adm"></div>`}
function admT(k){S.at=k;document.querySelectorAll('[id^=at-]').forEach(e=>e.classList.toggle('on',e.id==='at-'+k));const el=$('#adm');if(!el)return;({ov:ovV,ti:tiV,up:()=>{el.innerHTML=upForms()},in:inV,ad:adsV,mb:mbV,nt:notV,sy:syV})[k]()}
function tiV(){$('#adm').innerHTML=`<div class="pad"><input class="f" placeholder="Search titles" value="${esc(S.tq)}" oninput="S.tq=this.value;mgrR()"><div class="chips mt">${['All','Published','Hidden','Featured'].map(c=>`<span class="${S.tf===c?'on':''}" onclick="S.tf='${c}';tiV()">${c}</span>`).join('')}</div><div id="bk"></div></div><div id="mgr"><p class="s pad">Loading…</p></div>`;mgr()}
async function ovV(){const el=$('#adm');el.innerHTML='<p class="msg">Loading…</p>';const {data:d}=await sb.rpc('cv_admin_overview');if(!d){el.innerHTML='<p class="msg">Could not load the stats.</p>';return}
 const mx=Math.max(1,...d.daily.map(x=>x.n)),c=(n,l)=>`<div><b>${n}</b><span>${l}</span></div>`;
 el.innerHTML=`<div class="stats">${c(d.unique_visitors,'Visitors')}${c(d.today,'Visits today')}${c(d.members,'Members')}${c(d.titles,'Titles')}${c(d.videos,'Videos')}${c(mb(d.bytes)||'0 MB','Stored')}${c(d.requests_open,'Open requests')}${c(d.comments,'Comments')}${c(d.feedback,'Feedback')}</div>
 <div class="pad"><div class="sec" style="padding-left:0"><h3>Visits, last 14 days</h3></div><div class="bars">${d.daily.map(x=>`<div><i style="height:${Math.round(x.n/mx*80)+2}px"></i><span>${esc(String(x.d).slice(8))}</span></div>`).join('')}</div>
 <div class="sec" style="padding-left:0"><h3>Most watched</h3></div>${d.top.length?d.top.map(t=>`<div class="mi"><span>${esc(t.title)}</span><span class="s">${t.view_count} views</span></div>`).join(''):'<p class="s">No views yet.</p>'}
 ${d.expiring.length?`<div class="sec" style="padding-left:0"><h3>Licenses ending soon</h3></div>${d.expiring.map(t=>`<div class="mi"><span>${esc(t.title)}</span><span class="s" style="color:#ff9a9a">${esc(t.license_expires_on)}</span></div>`).join('')}`:''}</div>`}
async function inV(){const el=$('#adm');el.innerHTML='<p class="msg">Loading…</p>';const [r,f,c]=await Promise.all([sb.from('cv_title_requests').select('*').order('created_at',{ascending:false}).limit(30),sb.from('cv_feedback').select('*').order('created_at',{ascending:false}).limit(20),sb.from('cv_comments').select('*').order('created_at',{ascending:false}).limit(20)]);
 const dt=x=>esc(new Date(x).toLocaleDateString()),nm=id=>{const t=byId(id);return t?esc(t.title):'a title'},H=t=>`<div class="sec" style="padding-left:0"><h3>${t}</h3></div>`;
 el.innerHTML=`<div class="pad">${H('Title requests')}${(r.data||[]).map(x=>`<div class="mi" style="display:block"><b>${esc(x.query)}</b> <span class="s">${dt(x.created_at)}</span><select class="f sm mt" onchange="rq('${x.id}',this.value)">${['open','reviewing','added','declined'].map(o=>`<option ${x.status===o?'selected':''}>${o}</option>`).join('')}</select></div>`).join('')||'<p class="s">None yet.</p>'}
 ${H('Feedback')}${(f.data||[]).map(x=>`<div class="cmt" style="padding-left:0"><span class="s">${dt(x.created_at)}</span><p>${esc(x.message)}</p></div>`).join('')||'<p class="s">None yet.</p>'}
 ${H('Latest comments')}${(c.data||[]).map(x=>`<div class="cmt" style="padding-left:0"><b>${esc(x.name)}</b> <span class="s">on ${nm(x.title_id)} · ${dt(x.created_at)}</span><p>${esc(x.body)}</p><a class="s" onclick="delCm('${x.id}')">Delete</a></div>`).join('')||'<p class="s">None yet.</p>'}</div>`}
async function rq(id,v){const {error}=await sb.from('cv_title_requests').update({status:v}).eq('id',id);toast(error?error.message:'Saved.')}
async function delCm(id){if(!confirm('Delete this comment?'))return;await sb.from('cv_comments').delete().eq('id',id);inV()}
async function adsV(){const el=$('#adm'),{data:A}=await sb.from('cv_ads').select('*').order('created_at',{ascending:false});
 el.innerHTML=`<div class="pad"><div class="sec" style="padding-left:0"><h3>Add banner ad</h3></div><select class="f" id="dS">${['home_banner','between_rows','pre_roll','title_page','footer'].map(x=>`<option>${x}</option>`).join('')}</select><input class="f" id="dN" placeholder="Sponsor or ad name"><input class="f" id="dU" placeholder="Click link (https://…)"><p class="s">Banner image</p><input class="f" id="dI" type="file" accept="image/*"><p class="s">Starts (optional)</p><input class="f" id="dA" type="date"><p class="s">Ends (optional)</p><input class="f" id="dE" type="date"><button class="btn mt" onclick="addAd()">Add ad</button>
 <div class="sec" style="padding-left:0"><h3>Your ads</h3></div>${(A||[]).map(a=>`<div class="rw" style="padding-left:0"><div class="po" style="width:90px;aspect-ratio:16/9;flex:none;${bg(a.media_url)}"></div><div style="flex:1;min-width:0"><b>${esc(a.name)}</b><p class="s">${esc(a.slot)} · ${a.active?'On':'Off'}</p></div><button class="btn g" onclick="adTg('${a.id}',${!a.active})">${a.active?'Off':'On'}</button><button class="btn g" data-u="${esc(a.media_url)}" onclick="adDel('${a.id}',this.dataset.u)">✕</button></div>`).join('')||'<p class="s">No ads yet.</p>'}<p class="s">Only the home_banner slot shows on the site right now.</p></div>`}
async function addAd(){const n=gv('dN'),f=$('#dI').files[0],u=gv('dU');if(!n||!f)return toast('Add a name and a banner image.');if(u&&!/^https?:\/\//.test(u))return toast('The link must start with https://');
 try{const url=await upImg(f),{error}=await sb.from('cv_ads').insert({slot:$('#dS').value,kind:'banner',name:n,media_url:url,click_url:u||null,starts_at:gv('dA')||null,ends_at:gv('dE')||null});if(error)throw error;toast('Ad added.');adsV()}catch(e){toast('Could not add: '+(e.message||e))}}
async function adTg(id,v){await sb.from('cv_ads').update({active:v}).eq('id',id);adsV()}
async function adDel(id,u){if(!confirm('Delete this ad?'))return;try{await rmF('cv-posters',[pth(u,'cv-posters')])}catch(e){}await sb.from('cv_ads').delete().eq('id',id);adsV()}
async function mbV(){const el=$('#adm');el.innerHTML='<p class="msg">Loading…</p>';const {data,error}=await sb.functions.invoke('cv-admin',{body:{action:'members'}});
 if(!data||!data.members){el.innerHTML='<p class="msg">Could not load members: '+esc((data&&data.error)||await errMsg(error)||'unknown error')+'</p>';return}
 const dt=x=>x?esc(new Date(x).toLocaleDateString()):'never';
 el.innerHTML=`<div class="pad"><div class="sec" style="padding-left:0"><h3>Members (${data.members.length})</h3></div><p class="s">A friend can't sign in? Tap <b>Confirm</b>, or <b>Set password</b> and send them the new password privately.</p>${data.members.map(m=>`<div class="mi" style="display:block"><b>${esc(m.name||'(no name)')}</b><span class="tag" style="${m.confirmed?'':'color:#ff9a9a'}">${m.confirmed?'Confirmed':'Not confirmed'}</span><p class="s">${esc(m.email)}<br>Joined ${dt(m.created_at)} · last sign-in ${dt(m.last)}</p><div class="chips mt">${m.confirmed?'':`<span onclick="mAct('confirm','${m.id}')">Confirm</span>`}<span onclick="mAct('set_password','${m.id}')">Set password</span></div></div>`).join('')||'<p class="s">No members yet.</p>'}</div>`}
async function mAct(a,id){let pw;if(a==='set_password'){pw=(prompt('New password for this member (6+ characters). Send it to them privately.')||'').trim();if(!pw)return}
 const {data,error}=await sb.functions.invoke('cv-admin',{body:{action:a,user_id:id,password:pw}});toast(data&&data.ok?(a==='confirm'?'Account confirmed.':'Password updated.'):((data&&data.error)||await errMsg(error)||'Something went wrong'));mbV()}
async function syV(){const el=$('#adm');el.innerHTML=`<div class="pad"><div class="sec" style="padding-left:0"><h3>Backblaze B2 connection</h3></div><p class="s" id="b2r">Checking…</p><button class="btn mt" onclick="syV()">Test again</button><div class="sec" style="padding-left:0"><h3>Upload tests</h3></div><button class="btn g" onclick="tUp()">Test upload (1 KB)</button><p class="s" id="tur" style="white-space:pre-line"></p><button class="btn g" onclick="tCors()">Check CORS</button> <button class="btn g" onclick="tFix()">Fix CORS</button><p class="s" id="tcr" style="white-space:pre-line"></p><div class="sec" style="padding-left:0"><h3>Storage plans</h3></div><p class="s">Supabase Free: 50MB per file and about 1 GB of files. Large movies need Backblaze B2.</p></div>`;
 const {data,error}=await sb.functions.invoke('cv-b2',{body:{action:'status'}}),r=$('#b2r');if(!r)return;
 r.style.whiteSpace='pre-line';r.textContent=(data&&data.detail?data.detail+'\n\n':'')+(data&&data.endpoint?'Endpoint used: '+data.endpoint+'\nBucket used: '+data.bucket+'\n\n':'')+(data&&data.reason==='not_configured'?'❌ Not connected. The four B2 secrets are missing or misspelled in Supabase (B2_KEY_ID, B2_APP_KEY, B2_BUCKET, B2_ENDPOINT).':data&&data.ok?'✅ Connected. Big uploads go to Backblaze.':data&&data.status===403?'❌ Backblaze refused the key. Check B2_KEY_ID and B2_APP_KEY, and that the key can access this bucket.':data&&data.status===404?'❌ Bucket or endpoint not found. Check B2_BUCKET and B2_ENDPOINT.':'❌ Could not check: '+((data&&(data.error||data.status))||(error&&error.message)||'unknown'))}
async function forgot(){const e=gv('em');if(!e)return toast('Type your email in the email box first, then tap Forgot password.');
 const {error}=await sb.auth.resetPasswordForEmail(e,{redirectTo:location.origin+location.pathname});
 toast(error?'We could not send a reset email. Please ask the site owner to reset your password.':'If that email has an account, a reset link is on its way. If nothing arrives in a few minutes, ask the site owner to reset your password.')}
const P={subs:[],cues:[],lang:'',delay:0,locked:false,fit:'contain',speed:1,seek:false,hid:null,t:null,eid:null};
const fmt=x=>{x=Math.max(0,Math.floor(x||0));const h=Math.floor(x/3600),m=Math.floor(x%3600/60),c=x%60;return(h?h+':'+String(m).padStart(2,'0'):m)+':'+String(c).padStart(2,'0')};
function parseSub(t){t=String(t||'').replace(/\r/g,'').replace(/^\uFEFF/,'');const tm=q=>{const m=q.trim().match(/(?:(\d+):)?(\d+):(\d+)[.,](\d+)/);return m?(+(m[1]||0))*3600+(+m[2])*60+(+m[3])+(+('0.'+m[4])):0};
 return t.split(/\n\s*\n/).map(b=>{const L=b.split('\n'),i=L.findIndex(l=>l.includes('-->'));if(i<0)return null;const [a,z]=L[i].split('-->');return{s:tm(a),e:tm(z.trim().split(/\s+/)[0]),t:L.slice(i+1).join('\n').replace(/<[^>]+>/g,'').replace(/\{[^}]*\}/g,'').replace(/&nbsp;/g,' ').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&amp;/g,'&').trim()}}).filter(c=>c&&c.t)}
const IC={back:'<svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg>',dv:'<svg viewBox="0 0 24 24"><circle class="fl" cx="12" cy="5" r="1.9"/><circle class="fl" cx="12" cy="12" r="1.9"/><circle class="fl" cx="12" cy="19" r="1.9"/></svg>',dh:'<svg viewBox="0 0 24 24"><circle class="fl" cx="5" cy="12" r="1.9"/><circle class="fl" cx="12" cy="12" r="1.9"/><circle class="fl" cx="19" cy="12" r="1.9"/></svg>',
 rw:'<svg viewBox="0 0 24 24"><path d="M9 5L4.5 9.5 9 14"/><path d="M4.5 9.5H14a6 6 0 0 1 6 6v1"/></svg>',fw:'<svg viewBox="0 0 24 24"><path d="M15 5l4.5 4.5L15 14"/><path d="M19.5 9.5H10a6 6 0 0 0-6 6v1"/></svg>',
 play:'<svg viewBox="0 0 24 24"><path class="fl" d="M8 5.2v13.6L19 12z"/></svg>',pause:'<svg viewBox="0 0 24 24"><rect class="fl" x="6.5" y="5" width="4" height="14" rx="1"/><rect class="fl" x="13.5" y="5" width="4" height="14" rx="1"/></svg>',
 cc:'<svg viewBox="0 0 24 24"><rect x="3" y="5.5" width="18" height="13" rx="3"/><path d="M10.3 10.2a2.2 2.2 0 1 0 0 3.6M16.3 10.2a2.2 2.2 0 1 0 0 3.6"/></svg>',fit:'<svg viewBox="0 0 24 24"><path d="M4 8.5V5.5a1.5 1.5 0 0 1 1.5-1.5h3M15.5 4h3A1.5 1.5 0 0 1 20 5.5v3M20 15.5v3a1.5 1.5 0 0 1-1.5 1.5h-3M8.5 20h-3A1.5 1.5 0 0 1 4 18.5v-3"/></svg>',
 dl:'<svg viewBox="0 0 24 24"><rect x="5" y="10.5" width="14" height="9.5" rx="2"/><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5M12 12.8v4.2m0 0l-2-2m2 2l2-2"/></svg>',lock:'<svg viewBox="0 0 24 24"><rect x="5" y="10.5" width="14" height="9.5" rx="2"/><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5"/><circle class="fl" cx="12" cy="15.2" r="1.2"/></svg>',
 pip:'<svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="14" rx="2.5"/><rect x="11.5" y="11.5" width="7" height="5" rx="1.2"/></svg>',fs:'<svg viewBox="0 0 24 24"><path d="M4 9V5.5A1.5 1.5 0 0 1 5.5 4H9M15 4h3.5A1.5 1.5 0 0 1 20 5.5V9M20 15v3.5a1.5 1.5 0 0 1-1.5 1.5H15M9 20H5.5A1.5 1.5 0 0 1 4 18.5V15"/></svg>'};
const setPP=on=>['#ppp','#pp2'].forEach(q=>{const e=$(q);if(e)e.innerHTML=on?IC.pause:IC.play});
const pPos=()=>{const k=$('#psk');if(k)k.style.setProperty('--p',k.value/10+'%')};
const pTop=()=>pPanel(EPS.length>1?'eps':'help');
function pDl(){if(document.fullscreenElement)document.exitFullscreen();if(CUR)dlg(CUR.id)}
function pcHTML(dl){return `<div class="wm"><i>C</i>Cine<b>Verse</b></div><div class="sbt" id="sbt"></div><div class="pc hide" id="pc"><div class="pt"><button class="pb" onclick="closeW()">${IC.back}</button><span id="ptl"></span><button class="pb" onclick="pTop()">${IC.dv}</button></div>
<div class="pm"><button class="pb skip" onclick="pSeek(-ST.step)">${IC.rw}<b class="stp">10</b></button><button class="pb play" id="ppp" onclick="pTog()">${IC.play}</button><button class="pb skip" onclick="pSeek(ST.step)">${IC.fw}<b class="stp">10</b></button></div>
<div class="pbt"><div class="pbar"><span id="pct">0:00</span><div class="psw"><input type="range" id="psk" min="0" max="1000" value="0"><div class="mkr" id="mki"></div><div class="mkr cr" id="mkc"></div></div><span id="pdu">0:00</span></div><div class="sth" id="sth"><canvas id="stc" width="160" height="90"></canvas><span id="stt">0:00</span></div>
<div class="pbrow"><button class="pb" id="pp2" onclick="pTog()">${IC.play}</button><div class="ppill"><button onclick="pPanel('sub')">${IC.cc}<small class="lb">CC</small></button><button onclick="pPanel('spd')"><b id="pspb">1×</b><small class="lb">Speed</small></button><button onclick="pFit()">${IC.fit}<small class="lb">Fit</small></button>${dl?`<button class="tl" onclick="pDl()">${IC.dl}<small class="lb">Download</small></button>`:`<button class="tl" onclick="pLock()">${IC.lock}<small class="lb">Lock</small></button>`}<button onclick="pPip()">${IC.pip}<small class="lb">PiP</small></button><button onclick="pFs()">${IC.fs}<small class="lb">Fullscreen</small></button></div><button class="pb" onclick="pPanel('more')">${IC.dh}</button></div></div>
<button class="skp" id="pskp" onclick="pSkip()" style="display:none">Skip intro ›</button><div class="nxc" id="pnc" style="display:none"></div><div class="pgi" id="pgi"></div><div class="ppn" id="ppn"></div></div><div class="plk" id="plk" onclick="pUnlock()">🔒 Tap to unlock</div>`}
function initPlayer(){const v=$('#vp'),pc=$('#pc');if(!v||!pc)return;P.locked=false;P.delay=0;P.speed=1;P.fit='contain';P.subs=[];P.cues=[];P.lang='';P.eid=null;P.A=null;P.qi=0;P.hinted=0;
 const show=()=>{const was=pc.classList.contains('hide');pc.classList.remove('hide');if(was)P.sa=Date.now();clearTimeout(P.hid);if(!v.paused&&!$('#ppn').innerHTML)P.hid=setTimeout(()=>pc.classList.add('hide'),4500)};P.show=show;let lt=0,tap=null;
 const onTap=e=>{if(Date.now()-(P.gt||0)<450)return;
  if(P.locked){const k=$('#plk');k.classList.add('on');clearTimeout(P.ul);P.ul=setTimeout(()=>k.classList.remove('on'),2500);return}
  if($('#ppn').innerHTML){pPanel();return}
  const r=pc.getBoundingClientRect(),x=e.clientX-r.left,n=Date.now();
  if(n-lt<300){pSeek(x<r.width/2?-ST.step:ST.step);lt=0;show();return}
  lt=n;if(pc.classList.contains('hide'))show();else if(n-(P.sa||0)>700){pc.classList.add('hide');clearTimeout(P.hid)}else show()};
 pc.addEventListener('pointerdown',e=>{tap={x:e.clientX,y:e.clientY,t:Date.now(),ok:!e.target.closest('button,input,.ppn,.nxc,.skp')};if(!pc.classList.contains('hide'))show()});
 pc.addEventListener('pointerup',e=>{const q=tap;tap=null;if(!q||!q.ok)return;if(Math.abs(e.clientX-q.x)>16||Math.abs(e.clientY-q.y)>16||Date.now()-q.t>600)return;onTap(e)});
 pc.addEventListener('pointercancel',()=>{tap=null});
 pc.addEventListener('pointermove',e=>{if(e.pointerType==='mouse'&&!P.locked)show()});
 v.addEventListener('play',()=>{setPP(true);show()});v.addEventListener('pause',()=>{setPP(false);if(!P.locked)pc.classList.remove('hide');clearTimeout(P.hid)});
 v.addEventListener('loadedmetadata',()=>{$('#pdu').textContent=fmt(v.duration)});
 v.addEventListener('timeupdate',()=>{if(!P.seek&&v.duration){$('#psk').value=v.currentTime/v.duration*1000;pPos()}$('#pct').textContent=fmt(v.currentTime)});
 const sk=$('#psk');sk.addEventListener('input',()=>{pPos();P.seek=true;if(v.duration)$('#pct').textContent=fmt(sk.value/1000*v.duration)});sk.addEventListener('change',()=>{if(v.duration)v.currentTime=sk.value/1000*v.duration;P.seek=false});
 clearInterval(P.t);P.t=setInterval(subTick,100);applySty();pExtras(v,pc);show()}
const pTog=()=>{const v=$('#vp');if(v)v.paused?v.play().catch(()=>{}):v.pause()};
const pSeek=d=>{const v=$('#vp');if(v&&v.duration)v.currentTime=Math.min(v.duration,Math.max(0,v.currentTime+d))};
function pNext(){const i=EPS.findIndex(x=>x.id===P.eid);if(EPS[i+1])play(EPS[i+1].id)}
function pFit(){const v=$('#vp');P.fit={contain:'cover',cover:'fill',fill:'contain'}[P.fit];v.style.objectFit=P.fit;toast('Fit: '+{contain:'Original',cover:'Fill the screen',fill:'Stretch'}[P.fit])}
function pLock(){P.locked=true;pPanel();$('#pc').classList.add('lk','hide');const k=$('#plk');k.classList.add('on');clearTimeout(P.ul);P.ul=setTimeout(()=>k.classList.remove('on'),2500)}
function pUnlock(){P.locked=false;$('#pc').classList.remove('lk');$('#plk').classList.remove('on');P.show()}
async function pPip(){const v=$('#vp');try{document.pictureInPictureElement?await document.exitPictureInPicture():await v.requestPictureInPicture()}catch(e){toast('Mini player is not supported in this browser.')}}
function pFs(){const w=$('#wv'),v=$('#vp');if(document.fullscreenElement){document.exitFullscreen();try{screen.orientation.unlock()}catch(e){}return}const f=w.requestFullscreen||w.webkitRequestFullscreen;
 if(f)Promise.resolve(f.call(w)).then(()=>{try{screen.orientation.lock('landscape').catch(()=>{})}catch(e){}}).catch(()=>{});else if(v.webkitEnterFullscreen)v.webkitEnterFullscreen()}
function pRot(){pPanel();if(!document.fullscreenElement)return pFs();try{screen.orientation.lock(screen.orientation.type.startsWith('landscape')?'portrait':'landscape').catch(()=>toast('Rotation is not supported here.'))}catch(e){toast('Rotation is not supported here.')}}
function pPanel(k){const el=$('#ppn');if(!el)return;if(!k||el.dataset.k===k){el.innerHTML='';el.dataset.k='';P.show&&P.show();return}el.dataset.k=k;$('#pc').classList.remove('hide');clearTimeout(P.hid);
 const row=(t,on,f)=>`<div class="pr${on?' on':''}" onclick="${f}"><span>${t}</span>${on?'<b>✓</b>':''}</div>`,H=t=>`<h4>${t}</h4>`,ch=(a,key,cur)=>`<div class="chips mt">${a.map(x=>`<span class="${cur===x[0]?'on':''}" onclick="pSty('${key}','${x[0]}')">${x[1]}</span>`).join('')}</div>`;
 if(k==='spd')el.innerHTML=H('Speed')+[.5,.75,1,1.25,1.5,2].map(x=>row(x+'×',P.speed===x,`pSpd(${x})`)).join('');
 else if(k==='sub')el.innerHTML=H('Subtitles')+`<div class="pr"><span>Show subtitles</span><label class="sw"><input type="checkbox" ${ST.subOn?'checked':''} onchange="setS('subOn',this.checked);subTick()"><i></i></label></div>`+(P.subs.length?P.subs.map((q,i)=>row(esc(q.language),P.lang===q.language,`pLang(${i})`)).join(''):'<p class="s">No subtitles for this video yet.</p>')+H('Style')+ch([['s','Small'],['m','Medium'],['l','Large']],'subSize',ST.subSize)+ch([['w','White'],['y','Yellow']],'subColor',ST.subColor)+`<div class="chips mt"><span class="${ST.subBg?'on':''}" onclick="pSty('subBg',${!ST.subBg})">Background</span></div>`+H('Delay')+`<div class="chips"><span onclick="pDly(-.5)">− 0.5s</span><span class="on">${P.delay>0?'+':''}${P.delay.toFixed(1)}s</span><span onclick="pDly(.5)">+ 0.5s</span><span onclick="pDly(0)">Reset</span></div>`;
 else if(k==='more')el.innerHTML=H('More')+row('Lock screen',false,'pLock()')+(P.A&&P.A.length>1?row('Quality: '+P.A[P.qi].quality,false,"pPanel('qual')"):'')+(EPS.length>1?row('Episodes',false,"pPanel('eps')")+(EPS.findIndex(x=>x.id===P.eid)>0?row('Previous episode',false,'pPanel();pPrev()'):'')+(EPS.findIndex(x=>x.id===P.eid)<EPS.length-1?row('Next episode',false,'pPanel();pNext()'):''):'')+row('Audio: Default',true,'')+row('Seek step: '+ST.step+'s',false,"pPanel('step')")+row('Sleep timer'+(P.sl?': '+P.sl+' min':''),false,"pPanel('sleep')")+(CUR&&CUR.allow_download?row('Download',false,'pPanel();pDl()'):'')+row('Mini player',false,'pPip()')+row('Rotate screen',false,'pRot()')+row('Help',false,"pPanel('help')");
 else if(k==='qual')el.innerHTML=H('Quality')+(P.A||[]).map((a,i)=>row(a.quality,i===P.qi,`pQ(${i})`)).join('');
 else if(k==='eps')el.innerHTML=H('Episodes')+EPS.map(x=>row('S'+p2(x.season)+' E'+p2(x.episode)+(x.name?' · '+esc(x.name):''),x.id===P.eid,`pPanel();play('${x.id}')`)).join('');
 else if(k==='step')el.innerHTML=H('Seek step')+[5,10,15,30].map(n=>row(n+' seconds',ST.step===n,`pStep(${n})`)).join('');
 else if(k==='sleep')el.innerHTML=H('Sleep timer')+[[0,'Off'],[15,'15 minutes'],[30,'30 minutes'],[60,'1 hour']].map(x=>row(x[1],(P.sl||0)===x[0],`pSleep(${x[0]})`)).join('');
 else el.innerHTML=H('Help')+'<p class="s">Double-tap the left or right side to jump. Swipe left or right to scrub. Hold the screen for 2× speed. In fullscreen, swipe up or down on the left for brightness and on the right for volume. Drag the seek bar to preview frames. Yellow and pink bar sections are the intro and credits. Computer keys: Space play, arrows seek, J and L jump 10 seconds, 0 to 9 jump to 0 to 90 percent, comma and period step frames, less-than and greater-than change speed, F fullscreen, M mute.</p>'}
const rePanel=()=>{const el=$('#ppn'),k=el&&el.dataset.k;if(k){el.dataset.k='';pPanel(k)}};
function pSpd(x){const v=$('#vp');P.speed=x;v.playbackRate=x;$('#pspb').textContent=x+'×';rePanel()}
function pSty(k,v){setS(k,v);applySty();rePanel()}
function pDly(d){P.delay=d===0?0:Math.round((P.delay+d)*10)/10;rePanel();subTick()}
function pLang(i){const q=P.subs[i];if(!q)return;P.lang=q.language;setS('lang',q.language);setS('subOn',true);setCues();rePanel()}
function applySty(){const e=$('#sbt');if(e)e.className='sbt s-'+ST.subSize+' c-'+ST.subColor+(ST.subBg?' bg':'')}
function subTick(){const e=$('#sbt'),v=$('#vp');if(!e||!v)return;let k='';if(ST.subOn&&P.cues.length){const t=v.currentTime-P.delay,c=P.cues.find(c=>t>=c.s&&t<=c.e);k=c?c.t:''}if(e.dataset.t!==k){e.dataset.t=k;e.innerHTML=k?`<span>${esc(k).replace(/\n/g,'<br>')}</span>`:''}}
function setCues(){const q=P.subs.find(x=>x.language===P.lang);P.cues=q?parseSub(q.content):[];subTick()}
async function pLoad(eid){P.eid=eid;const ep=EPS.find(x=>x.id===eid),l=$('#ptl'),i=EPS.findIndex(x=>x.id===eid),nx=$('#pnx'),v=$('#vp');
 if(l)l.textContent=(CUR?CUR.title:'')+(ep&&EPS.length>1?' · S'+p2(ep.season)+' E'+p2(ep.episode):'');if(nx)nx.style.display=EPS[i+1]?'':'none';const pv=$('#ppv'),pe=$('#pep');if(pv)pv.style.display=EPS[i-1]?'':'none';if(pe)pe.style.display=EPS.length>1?'':'none';P.ep=ep;P.noNext=false;const nc=$('#pnc'),sk=$('#pskp');if(nc)nc.style.display='none';if(sk)sk.style.display='none';markBar();if(v)v.playbackRate=P.speed;
 const {data}=await sb.from('cv_subtitles').select('language,content').eq('episode_id',eid);if(P.eid!==eid)return;P.subs=data||[];const pk=P.subs.find(x=>x.language===ST.lang)||P.subs.find(x=>/english/i.test(x.language))||P.subs[0];P.lang=pk?pk.language:'';setCues()}
document.addEventListener('keydown',e=>{if(!$('#watch').classList.contains('open')||/INPUT|TEXTAREA|SELECT/.test(e.target.tagName||''))return;const k=e.key;if(k===' '){e.preventDefault();pTog()}else if(k==='ArrowRight')pSeek(ST.step);else if(k==='ArrowLeft')pSeek(-ST.step);else if(k==='l'||k==='L')pSeek(10);else if(k==='j'||k==='J')pSeek(-10);else if(/^[0-9]$/.test(k)){const v=$('#vp');if(v&&v.duration)v.currentTime=v.duration*(+k)/10}else if(k==='.'||k===','){const v=$('#vp');if(v&&v.paused)v.currentTime+=k==='.'?1/30:-1/30}else if(k==='>'||k==='<'){const L=[.5,.75,1,1.25,1.5,2],i=Math.max(0,L.indexOf(P.speed));pSpd(L[Math.min(5,Math.max(0,i+(k==='>'?1:-1)))])}else if(k==='f'||k==='F')pFs();else if(k==='m'||k==='M'){const v=$('#vp');if(v)v.muted=!v.muted}});
const stepLbl=()=>document.querySelectorAll('.stp').forEach(e=>e.textContent=ST.step);
function pQ(i){if(P.setQ&&P.A&&P.A[i]){P.setQ(i);toast('Switching to '+P.A[i].quality+'…')}pPanel()}
function pStep(n){setS('step',n);stepLbl();rePanel()}
function pSleep(m){clearTimeout(P.slt);P.sl=m;if(m)P.slt=setTimeout(()=>{const v=$('#vp');if(v)v.pause();P.sl=0;toast('Sleep timer: paused. Sleep well.')},m*60000);toast(m?'Sleep timer set for '+m+' minutes.':'Sleep timer off.');rePanel()}
function pPrev(){const i=EPS.findIndex(x=>x.id===P.eid);if(EPS[i-1])play(EPS[i-1].id)}
function pSkip(){const e=P.ep,v=$('#vp');if(e&&e.intro_end!=null&&v)v.currentTime=e.intro_end}
function markBar(){const v=$('#vp'),e=P.ep,a=$('#mki'),c=$('#mkc');if(!a||!v||!v.duration)return;const d=v.duration,seg=(el,s,z)=>{if(s!=null&&z!=null&&z>s){el.style.display='block';el.style.left=s/d*100+'%';el.style.width=Math.min(100-s/d*100,(z-s)/d*100)+'%'}else el.style.display='none'};seg(a,e&&e.intro_start,e&&e.intro_end);seg(c,e&&e.credits_start,d)}
function mkTick(){const v=$('#vp'),e=P.ep,k=$('#pskp'),n=$('#pnc');if(!v||!e||!k||!n)return;const t=v.currentTime,d=v.duration||0;
 k.style.display=e.intro_end!=null&&t>=(e.intro_start||0)&&t<e.intro_end-.5&&!P.locked?'block':'none';
 const i=EPS.findIndex(x=>x.id===e.id),nx=EPS[i+1],cs=e.credits_start!=null?e.credits_start:d-12;
 if(nx&&ST.next&&!P.noNext&&d&&t>=cs&&t<d){const left=Math.ceil(d-t);n.style.display='block';n.innerHTML=`<b>Next episode</b><span>S${p2(nx.season)} E${p2(nx.episode)}${left<=20?' · in '+left+'s':''}</span><div><button onclick="pNext()">Play now</button><button class="g" onclick="P.noNext=true;$('#pnc').style.display='none'">Cancel</button></div>`}else n.style.display='none'}
function pExtras(v,pc){stepLbl();if(P.bri)v.style.filter='brightness('+P.bri+')';
 const sk=$('#psk'),th=$('#sth'),tc=$('#stc'),tt=$('#stt'),cx=tc.getContext('2d'),hide=()=>{th.style.display='none'};
 const prev=f=>{if(!v.duration)return;const t=f*v.duration,r=sk.getBoundingClientRect(),w=$('.pbt').getBoundingClientRect();tt.textContent=fmt(t);th.style.display='block';th.style.left=Math.min(Math.max(r.left-w.left+f*r.width-80,4),Math.max(4,w.width-164))+'px';
  if(ST.saver||!v.currentSrc||matchMedia('(pointer:coarse)').matches){tc.style.display='none';return}tc.style.display='block';
  if(!P.tv){const x=document.createElement('video');x.muted=true;x.preload='metadata';x.playsInline=true;x.src=v.currentSrc;P.tv=x;x.addEventListener('seeked',()=>{try{cx.drawImage(x,0,0,160,90)}catch(e){}P.tb=false;if(P.tq!=null){const q=P.tq;P.tq=null;P.tb=true;x.currentTime=q}})}
  if(P.tb)P.tq=t;else{P.tb=true;P.tv.currentTime=t}};
 sk.addEventListener('input',()=>prev(sk.value/1000));sk.addEventListener('change',hide);sk.addEventListener('touchend',hide);sk.addEventListener('mouseleave',hide);
 sk.addEventListener('mousemove',e=>{const r=sk.getBoundingClientRect();prev(Math.min(1,Math.max(0,(e.clientX-r.left)/r.width)))});
 v.addEventListener('loadstart',()=>{P.tv=null;P.tb=false;P.tq=null});v.addEventListener('waiting',()=>{clearTimeout(P.wt);P.wt=setTimeout(()=>{if(P.A&&P.qi<P.A.length-1&&!P.hinted){P.hinted=1;toast('Slow connection? Open the ⋯ menu, tap Quality and pick a lower one.')}},4000)});['playing','canplay','pause'].forEach(ev=>v.addEventListener(ev,()=>clearTimeout(P.wt)));v.addEventListener('loadedmetadata',markBar);v.addEventListener('timeupdate',mkTick);
 let g=null,lp=null;const gi=$('#pgi'),show=t=>{gi.textContent=t;gi.style.display='block';clearTimeout(P.gh);P.gh=setTimeout(()=>gi.style.display='none',800)};
 pc.addEventListener('touchstart',e=>{g=null;if(P.locked||e.target.closest('button,input,.ppn,.nxc,.skp')||e.touches.length>1)return;const t=e.touches[0],r=pc.getBoundingClientRect();g={x:t.clientX,y:t.clientY,w:r.width,h:r.height,left:t.clientX-r.left<r.width/2,t0:v.currentTime,v0:v.volume,b0:P.bri||1,mode:'',to:null,sp:v.playbackRate};
  lp=setTimeout(()=>{if(g&&!g.mode){g.mode='fast';v.playbackRate=2;show('2× speed')}},500)},{passive:true});
 pc.addEventListener('touchmove',e=>{if(!g||P.locked)return;const t=e.touches[0],dx=t.clientX-g.x,dy=t.clientY-g.y;
  if(!g.mode&&(Math.abs(dx)>24||Math.abs(dy)>20)){clearTimeout(lp);g.mode=Math.abs(dx)>Math.abs(dy)?'seek':(document.fullscreenElement?(g.left?'bri':'vol'):'none')}
  if(g.mode==='seek'&&v.duration){e.preventDefault();g.to=Math.min(v.duration,Math.max(0,g.t0+dx/g.w*120));show((dx>=0?'+':'−')+fmt(Math.abs(g.to-g.t0))+' · '+fmt(g.to))}
  else if(g.mode==='vol'){e.preventDefault();v.volume=Math.min(1,Math.max(0,g.v0-dy/g.h*1.3));show('Volume '+Math.round(v.volume*100)+'%')}
  else if(g.mode==='bri'){e.preventDefault();P.bri=Math.min(1.6,Math.max(.3,g.b0-dy/g.h*1.3));v.style.filter='brightness('+P.bri+')';show('Brightness '+Math.round(P.bri*100)+'%')}},{passive:false});
 pc.addEventListener('touchend',()=>{clearTimeout(lp);if(!g)return;if(g.mode==='seek'&&g.to!=null)v.currentTime=g.to;if(g.mode==='fast')v.playbackRate=g.sp;if(g.mode&&g.mode!=='none')P.gt=Date.now();g=null})}
function tsec(x){x=String(x||'').trim();if(!x)return null;const p=x.split(':').map(Number);if(p.some(isNaN))return undefined;return p.length===1?p[0]:p.length===2?p[0]*60+p[1]:p[0]*3600+p[1]*60+p[2]}
async function mk(id){const e=M.E.find(x=>x.id===id);if(!e)return;const f=v=>v==null?'':fmt(v),a=prompt('Intro starts at (like 0:05, or seconds). Leave empty for no intro.',f(e.intro_start));if(a===null)return;
 const b=prompt('Intro ends at (like 1:30)',f(e.intro_end));if(b===null)return;const c=prompt('Credits start at (like 42:10). Leave empty to use the last 12 seconds.',f(e.credits_start));if(c===null)return;
 const A=tsec(a),B=tsec(b),C=tsec(c);if([A,B,C].includes(undefined))return toast('Use a time like 1:30 or 90.');if((A==null)!==(B==null)||(A!=null&&B<=A))return toast('Set both intro times, with the end after the start.');
 const {error}=await sb.from('cv_episodes').update({intro_start:A,intro_end:B,credits_start:C}).eq('id',id);toast(error?error.message:'Markers saved.');mgr()}
async function addSub(){const f=$('#sF').files[0],lg=gv('sL'),m=$('#sMsg');if(!$('#sT').value||!f||!lg){m.textContent='Choose a title, type the language, and pick a subtitle file.';return}if(f.size>1500000){m.textContent='That file is too big for subtitles.';return}
 const {data:ep}=await sb.from('cv_episodes').select('id').eq('title_id',$('#sT').value).eq('season',+gv('sS')||1).eq('episode',+gv('sN')||1).maybeSingle();if(!ep){m.textContent='That episode does not exist yet. Upload its video first.';return}
 const txt=await f.text();if(!parseSub(txt).length){m.textContent='Could not read any subtitle lines in that file.';return}
 const {error}=await sb.from('cv_subtitles').upsert({episode_id:ep.id,language:lg.slice(0,40),content:txt,storage_path:null},{onConflict:'episode_id,language'});m.textContent=error?'Failed: '+error.message:'Subtitles added ✅';if(!error)$('#sF').value=''}
async function delS(id){if(!confirm('Delete these subtitles?'))return;await sb.from('cv_subtitles').delete().eq('id',id);mgr()}
const VAPID='BPMQynz0Qy1xGVYZVY9S6VSoZJrP4hNq771Y2SYWm-yNiap-um9rN54pGU-xu53MWVzuYY6-BmzeZIIsuY_Ihuw';
const b64=x=>{const r=atob((x+'='.repeat((4-x.length%4)%4)).replace(/-/g,'+').replace(/_/g,'/'));return Uint8Array.from(r,c=>c.charCodeAt(0))};
const LN=(()=>{try{return window.Capacitor&&Capacitor.isNativePlatform&&Capacitor.isNativePlatform()&&Capacitor.Plugins&&Capacitor.Plugins.LocalNotifications||null}catch(e){return null}})();
const LN_IDS=[9001,9002,9003,9004,9005,9006,9007];
const pushOK=()=>!!LN||('serviceWorker' in navigator&&'PushManager' in window&&'Notification' in window);
async function lnSchedule(){try{const pool=S.titles.filter(t=>t&&t.id&&t.title);if(!pool.length)return;await LN.cancel({notifications:LN_IDS.map(id=>({id}))});
 const pick=[...pool].sort(()=>Math.random()-.5).slice(0,7),now=new Date(),list=pick.map((t,i)=>{const d=new Date(now.getFullYear(),now.getMonth(),now.getDate()+i,18,0,0);if(d<=now)d.setDate(d.getDate()+7);return{id:LN_IDS[i],title:'Pick for tonight 🎬',body:t.title+' is waiting for you. Tap to watch.',schedule:{at:d},extra:{t:t.id}}});
 await LN.schedule({notifications:list})}catch(e){}}
async function lnOn(){try{let p=await LN.checkPermissions();if(p.display!=='granted')p=await LN.requestPermissions();if(p.display!=='granted'){toast('Notifications are blocked. Allow them for CineVerse in your phone settings.');return false}setS('push',true);await lnSchedule();toast('Notifications are on 🔔');return true}catch(e){toast('Could not turn notifications on: '+(e.message||e));return false}}
if(LN){try{LN.addListener('localNotificationActionPerformed',e=>{const t=e.notification&&e.notification.extra&&e.notification.extra.t;if(t&&byId(t))openT(t)})}catch(e){}setTimeout(()=>{if(ST.push)lnSchedule()},8000)}
function pushRow(){const ok=pushOK()&&(LN||SWOK!==false);return `<div class="mi"><span>Movie suggestions<p class="s">${ok?'Get a notification with new picks, even when the site is closed':(SWOK===false?'Not available yet: the site owner must upload sw.js next to index.html.':'Not supported in this browser. On iPhone, add CineVerse to your Home Screen first.')}</p></span><label class="sw"><input type="checkbox" ${ok&&ST.push&&(LN||Notification.permission==='granted')?'checked':''} ${ok?'':'disabled'} onchange="pushToggle(this)"><i></i></label></div>`}
async function pushOn(){if(LN)return lnOn();if(!pushOK()){toast('This browser does not support notifications. On iPhone, add CineVerse to your Home Screen first.');return false}
 const perm=await Notification.requestPermission();if(perm!=='granted'){toast('Notifications are blocked. Allow them for this site in your browser settings.');return false}
 try{const reg=await navigator.serviceWorker.ready;let sub=await reg.pushManager.getSubscription();if(!sub)sub=await reg.pushManager.subscribe({userVisibleOnly:true,applicationServerKey:b64(VAPID)});
  const {data,error}=await sb.functions.invoke('cv-push',{body:{action:'subscribe',subscription:sub.toJSON()}});if(!(data&&data.ok))throw new Error((data&&data.error)||await errMsg(error)||'could not save');setS('push',true);toast('Notifications are on 🔔');return true}
 catch(e){toast('Could not turn notifications on: '+(e.message||e));return false}}
async function pushOff(){if(LN){try{await LN.cancel({notifications:LN_IDS.map(id=>({id}))})}catch(e){}setS('push',false);toast('Notifications are off.');return}try{const reg=await navigator.serviceWorker.ready,sub=await reg.pushManager.getSubscription();if(sub){await sb.functions.invoke('cv-push',{body:{action:'unsubscribe',endpoint:sub.endpoint}});await sub.unsubscribe()}}catch(e){}setS('push',false);toast('Notifications are off.')}
async function pushToggle(el){if(el.checked){if(!await pushOn())el.checked=false}else pushOff()}
function pushAsk(){if(!pushOK()||(!LN&&SWOK===false)||ST.push||(!LN&&Notification.permission!=='default')||Date.now()-(ST.pushAsk||0)<7*864e5||document.querySelector('.pka')||document.querySelector('.in')||$('#watch').classList.contains('open'))return;
 const d=document.createElement('div');d.className='pka';d.innerHTML='<b>Get movie picks on your phone?</b><span>We will suggest something good, even when the site is closed.</span><div><button class="btn" id="pkY">Turn on</button><button class="btn g" id="pkN">Not now</button></div>';document.body.append(d);
 $('#pkY').onclick=async()=>{d.remove();await pushOn()};$('#pkN').onclick=()=>{setS('pushAsk',Date.now());d.remove()}}
function deepLink(){const id=new URLSearchParams(location.search).get('t');if(id&&byId(id)){history.replaceState(null,'',location.pathname);openT(id)}}
let SWOK=null;if('serviceWorker' in navigator){navigator.serviceWorker.register('sw.js').then(()=>{SWOK=true}).catch(()=>{SWOK=false});navigator.serviceWorker.addEventListener('message',e=>{if(e.data&&e.data.t&&byId(e.data.t))openT(e.data.t)})}
setTimeout(pushAsk,15000);
async function notV(){const el=$('#adm');el.innerHTML='<p class="msg">Loading…</p>';const {data:d}=await sb.functions.invoke('cv-push',{body:{action:'stats'}});
 el.innerHTML=`<div class="pad"><div class="sec" style="padding-left:0"><h3>Notifications</h3></div><div class="stats" style="padding:0"><div><b>${d&&d.subs!=null?d.subs:'?'}</b><span>Subscribers</span></div><div><b>${d&&d.last?esc(new Date(d.last).toLocaleDateString()):'never'}</b><span>Last sent</span></div><div><b>6 pm</b><span>Daily pick</span></div></div>
 <p class="s">A suggestion goes out by itself every day at 6 pm. Members with an unfinished movie get "Pick up where you stopped". People can switch it off in Settings.</p><button class="btn mt" onclick="nSug()">Send a suggestion now</button>
 <div class="sec" style="padding-left:0"><h3>Send your own</h3></div><select class="f" id="nT"><option value="">No title (opens the home page)</option>${S.titles.map(t=>`<option value="${t.id}">${esc(t.title)}</option>`).join('')}</select><input class="f" id="nM" maxlength="140" placeholder="Message (up to 140 characters)"><button class="btn mt" onclick="nSend()">Send to everyone</button><p class="s" id="nR"></p></div>`}
async function nSend(){const text=gv('nM');if(!text)return toast('Write a message first.');const {data,error}=await sb.functions.invoke('cv-push',{body:{action:'send',text,title_id:$('#nT').value||null}});
 $('#nR').textContent=data&&data.subscribers!=null?'Sent to '+data.subscribers+' device(s): '+data.ok+' delivered, '+data.failed+' failed'+(data.removed?', '+data.removed+' dead ones removed':'')+'.':'Failed: '+((data&&data.error)||await errMsg(error)||'unknown')}
async function nSug(){const {data,error}=await sb.functions.invoke('cv-push',{body:{action:'suggest'}});$('#nR').textContent=data&&data.picked?'Sent "'+data.picked+'" to '+data.subscribers+' device(s).':(data&&data.note)||'Failed: '+((data&&data.error)||'unknown')}
function tp(b){const p=$('#pw'),h=p.type==='password';p.type=h?'text':'password';b.textContent=h?'Hide':'Show'}
async function auth(m){const email=gv('em'),password=$('#pw').value;if(!email||password.length<6)return toast('Enter your email and a password of 6+ characters.');
 S.welcome=1;const fail=t=>(S.welcome=0,toast(t));
 try{if(m==='up'){const {data,error}=await sb.functions.invoke('cv-auth',{body:{action:'signup',email,password,name:(gv('nm')||email.split('@')[0]).slice(0,50)}});
   if(!(data&&data.ok)&&!(data&&data.error==='exists'))return fail((data&&data.error)||await errMsg(error)||'Could not create the account. Please try again.')}
  let r=await sb.auth.signInWithPassword({email,password});
  if(r.error&&/not confirmed/i.test(r.error.message)){await sb.functions.invoke('cv-auth',{body:{action:'activate',email}});r=await sb.auth.signInWithPassword({email,password})}
  if(r.error){const x=r.error.message;return fail(/invalid login/i.test(x)?(m==='up'?'This email already has an account and that password does not match it. Tap Forgot password, or ask the site owner to reset it.':'Wrong email or password. Check the spelling of your email, or tap Forgot password.'):/not confirmed/i.test(x)?'We could not activate this account. Please try again in a minute.':x)}
  toast('Signing you in…')}
 catch(e){fail('Could not reach the server. Check your internet and try again.')}}
async function out(){await sb.auth.signOut();toast('Signed out.')}
async function who(){const {data:{session}}=await sb.auth.getSession();S.user=session?session.user:null;if(S.ready&&S.uid===(S.user&&S.user.id))return;S.admin=false;S.wl=new Set();
 if(S.user){const [a,w]=await Promise.all([sb.rpc('cv_is_admin'),sb.from('cv_watchlist').select('title_id').eq('user_id',S.user.id)]);S.admin=a.data===true;(w.data||[]).forEach(x=>S.wl.add(x.title_id));
 fire(sb.from('cv_profiles').upsert({user_id:S.user.id,display_name:((S.user.user_metadata||{}).name||(S.user.email||'').split('@')[0]).slice(0,50)},{onConflict:'user_id',ignoreDuplicates:true}))}
 if(S.uid!==(S.user&&S.user.id)||!S.ready){S.uid=S.user&&S.user.id;S.ready=1;go()}
 if(S.welcome||!sessionStorage.getItem('cv-w')){S.welcome=0;try{sessionStorage.setItem('cv-w',1)}catch(e){}welcome(S.user?((S.user.user_metadata||{}).name||(S.user.email||'').split('@')[0]):'')}}
async function load(){const {data}=await sb.from('cv_titles').select('*').eq('published',true).order('created_at',{ascending:false});S.titles=data||[];S.loaded=true;go();deepLink()}
document.addEventListener('visibilitychange',()=>{const v=$('#vp');if(document.hidden&&ST.pip&&v&&!v.paused&&document.pictureInPictureEnabled)v.requestPictureInPicture().catch(()=>{})});
sb.auth.onAuthStateChange(ev=>{if(ev==='PASSWORD_RECOVERY')setTimeout(async()=>{const p=(prompt('Choose a new password (6+ characters)')||'').trim();if(p.length<6)return toast('Password not changed.');const {error}=await sb.auth.updateUser({password:p});toast(error?error.message:'Password updated. You are signed in.')},400);who()});load();who();
sb.from('cv_ads').select('*').eq('slot','home_banner').eq('kind','banner').limit(1).then(r=>{if(r.data&&r.data[0]&&/^https?:/.test(r.data[0].media_url)){S.ad=r.data[0];go()}});
setInterval(()=>{const h=$('.hero');if(h&&h.children.length>1){const w=h.clientWidth;h.scrollTo({left:h.scrollLeft+w>=h.scrollWidth-5?0:h.scrollLeft+w,behavior:'smooth'})}},4500);
</script></body></html>
