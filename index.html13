    halloween: u => `<defs><linearGradient id="a${u}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#4a1a05"/><stop offset="1" stop-color="#0f0805"/></linearGradient><radialGradient id="m${u}" cx=".5" cy=".5" r=".5"><stop offset=".4" stop-color="#ffcf6b" stop-opacity=".9"/><stop offset="1" stop-color="#ffcf6b" stop-opacity="0"/></radialGradient></defs><rect width="360" height="150" fill="url(#a${u})"/><circle cx="296" cy="46" r="62" fill="url(#m${u})"/><circle cx="296" cy="46" r="32" fill="#ffd978"/><circle cx="286" cy="38" r="6" fill="#f0b94a" opacity=".6"/><circle cx="304" cy="56" r="4" fill="#f0b94a" opacity=".6"/><path d="M0 150V120q60-10 120 4t240-4v30z" fill="#0a0503"/><g fill="#0a0503"><rect x="238" y="82" width="74" height="54"/><path d="M230 84l45-34 45 34z"/><rect x="296" y="52" width="14" height="34"/></g><g fill="#ffb347"><rect x="248" y="94" width="10" height="14"/><rect x="270" y="94" width="10" height="14"/><rect x="294" y="106" width="10" height="14"/><rect x="262" y="116" width="10" height="20"/></g><path d="M200 140q-4-30 4-52M204 108q-14-8-22-22M204 96q12-6 18-20" stroke="#0a0503" stroke-width="4" fill="none" stroke-linecap="round"/><g fill="#0a0503"><path d="M0 0q7-9 14 0q7-9 14 0q-7 4-14 9q-7-5-14-9z" transform="translate(190 34)"/><path d="M0 0q7-9 14 0q7-9 14 0q-7 4-14 9q-7-5-14-9z" transform="translate(222 18) scale(.8)"/><path d="M0 0q7-9 14 0q7-9 14 0q-7 4-14 9q-7-5-14-9z" transform="translate(340 92) scale(.9)"/></g><circle cx="222" cy="126" r="16" fill="#ff7a1a"/><path d="M214 120l5 7-10 0zM230 120l5 7-10 0zM213 132q9 7 18 0" fill="#2a1200" stroke="#2a1200" stroke-width="1.5"/>`,
