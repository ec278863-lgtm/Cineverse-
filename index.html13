  };
  const FX_PICK = [['auto', 'Auto'], ['snow', '❄️ Snow'], ['hearts', '💖 Hearts'], ['petals', '🌸 Petals'], ['stars', '✦ Stars'], ['gold', '✨ Sparkle'], ['bubbles', '🫧 Bubbles'], ['bats', '🦇 Spooky'], ['confetti', '🎉 Confetti'], ['none', 'Off']];

  /* ================= SEASON (auto mode) ================= */
  function easterDate(y) { const a = y % 19, b = Math.floor(y / 100), c = y % 100, d = Math.floor(b / 4), e = b % 4, f = Math.floor((b + 8) / 25), g = Math.floor((b - f + 1) / 3), h = (19 * a + b - d - g + 15) % 30, i = Math.floor(c / 4), k = c % 4, l = (32 + 2 * e + 2 * i - h - k) % 7, m = Math.floor((a + 11 * h + 22 * l) / 451), mo = Math.floor((h + l - 7 * m + 114) / 31), da = ((h + l - 7 * m + 114) % 31) + 1; return new Date(y, mo - 1, da); }
  function season(d) {
    d = d || new Date(); const m = d.getMonth() + 1, day = d.getDate(), D = new Date(d.getFullYear(), m - 1, day);
    if ((m === 12 && day >= 28) || (m === 1 && day <= 3)) return 'newyear';
    if (m === 12 && day >= 1) return 'christmas';
    if (m === 2 && day >= 10 && day <= 15) return 'valentine';
    if (m === 10 && day >= 20 || (m === 11 && day <= 1)) return 'halloween';
    const E = easterDate(d.getFullYear()), diff = Math.round((D - E) / 864e5); if (diff >= -4 && diff <= 2) return 'easter';
    try { const p = new Intl.DateTimeFormat('en-u-ca-islamic-umalqura', { month: 'numeric', day: 'numeric' }).formatToParts(d), mm = +p.find(x => x.type === 'month').value, dd = +p.find(x => x.type === 'day').value; if ((mm === 10 && dd <= 3) || (mm === 12 && dd >= 9 && dd <= 12)) return 'newyear'; } catch (e) { }
    return '';
  }
  const SEASON_NAME = { newyear: 'Eid / New Year', christmas: 'Christmas', valentine: "Valentine's Day", halloween: 'Halloween', easter: 'Easter' };
  const eff = () => (ST.cvAuto && season()) || ST.cvTheme || 'classic';

  /* ================= COLOUR HELPERS ================= */
  const hx = n => ('0' + Math.round(n).toString(16)).slice(-2);
  function hsl2hex(h, s, l) { h = ((h % 360) + 360) % 360; s = Math.max(0, Math.min(1, s)); l = Math.max(0, Math.min(1, l)); const k = n => (n + h / 30) % 12, a = s * Math.min(l, 1 - l), f = n => l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1))); return '#' + hx(f(0) * 255) + hx(f(8) * 255) + hx(f(4) * 255); }
  function hex2hsl(h) { const r = parseInt(h.slice(1, 3), 16) / 255, g = parseInt(h.slice(3, 5), 16) / 255, b = parseInt(h.slice(5, 7), 16) / 255, mx = Math.max(r, g, b), mn = Math.min(r, g, b), l = (mx + mn) / 2; let H = 0, s = 0; if (mx !== mn) { const d = mx - mn; s = l > .5 ? d / (2 - mx - mn) : d / (mx + mn); H = mx === r ? (g - b) / d + (g < b ? 6 : 0) : mx === g ? (b - r) / d + 2 : (r - g) / d + 4; H *= 60; } return [H, s, l]; }
  const lum = h => (0.299 * parseInt(h.slice(1, 3), 16) + 0.587 * parseInt(h.slice(3, 5), 16) + 0.114 * parseInt(h.slice(5, 7), 16)) / 255;
  const onCol = h => lum(h) > .6 ? '#111111' : '#ffffff';
  function palFromCanvas(c) {
    const s = document.createElement('canvas'); s.width = s.height = 40; const x = s.getContext('2d'); x.drawImage(c, 0, 0, 40, 40); const d = x.getImageData(0, 0, 40, 40).data, bins = [];
    for (let i = 0; i < 24; i++) bins.push({ w: 0, r: 0, g: 0, b: 0 });
    for (let i = 0; i < d.length; i += 4) { const r = d[i], g = d[i + 1], b = d[i + 2], mx = Math.max(r, g, b), mn = Math.min(r, g, b), v = mx / 255, sat = mx ? (mx - mn) / mx : 0; if (v < .22 || sat < .25) continue; let h = 0; const dd = mx - mn; h = mx === r ? ((g - b) / dd + (g < b ? 6 : 0)) : mx === g ? (b - r) / dd + 2 : (r - g) / dd + 4; h *= 60; const k = Math.floor(h / 15) % 24, w = sat * v; bins[k].w += w; bins[k].r += r * w; bins[k].g += g * w; bins[k].b += b * w; }
    let best = bins.reduce((p, q) => q.w > p.w ? q : p, bins[0]), H;
    if (best.w < 1) H = 215; else { const hh = '#' + hx(best.r / best.w) + hx(best.g / best.w) + hx(best.b / best.w); H = hex2hsl(hh)[0]; }
    const gray = best.w < 1;
    return { a: gray ? '#e3e9f5' : hsl2hex(H, .8, .58), a2: gray ? '#8fb4ff' : hsl2hex(H + 40, .82, .66), bg: hsl2hex(H, gray ? .08 : .45, .06), c: hsl2hex(H, gray ? .08 : .35, .12), m: hsl2hex(H, .2, .72), line: hsl2hex(H, .3, .22), bar: hsl2hex(H, .4, .07) + 'f2' };
  }

  /* ================= STORAGE (photos live in IndexedDB) ================= */
  const IMG = { bg: null, logo: null };
  const idb = {
    open() { return new Promise((res, rej) => { try { const r = indexedDB.open('cv-themes', 1); r.onupgradeneeded = () => r.result.createObjectStore('k'); r.onsuccess = () => res(r.result); r.onerror = () => rej(r.error); } catch (e) { rej(e); } }); },
    async get(k) { const db = await this.open(); return new Promise(res => { const q = db.transaction('k').objectStore('k').get(k); q.onsuccess = () => res(q.result || null); q.onerror = () => res(null); }); },
    async set(k, v) { const db = await this.open(); return new Promise((res, rej) => { const tx = db.transaction('k', 'readwrite'); tx.objectStore('k').put(v, k); tx.oncomplete = () => res(); tx.onerror = () => rej(tx.error); }); },
    async del(k) { const db = await this.open(); return new Promise(res => { const tx = db.transaction('k', 'readwrite'); tx.objectStore('k').delete(k); tx.oncomplete = () => res(); tx.onerror = () => res(); }); }
  };
  async function saveImg(k, v) { try { await idb.set(k, v); return true; } catch (e) { try { localStorage.setItem('cv-img-' + k, v); return true; } catch (e2) { return false; } } }
  async function loadImgs() {
    for (const k of ['bg', 'logo']) { let v = null; try { v = await idb.get(k); } catch (e) { } if (!v) { try { v = localStorage.getItem('cv-img-' + k); } catch (e) { } } IMG[k] = v || null; }
    try { const vb = await idb.get('vid'); if (vb && vb.size) IMG.vid = URL.createObjectURL(vb); } catch (e) { }
    paint();
  }
  function readImg(file, max, type, q) {
    return new Promise((res, rej) => {
      const url = URL.createObjectURL(file), im = new Image();
      im.onload = () => { const s = Math.min(1, max / Math.max(im.naturalWidth, im.naturalHeight)), c = document.createElement('canvas'); c.width = Math.max(1, Math.round(im.naturalWidth * s)); c.height = Math.max(1, Math.round(im.naturalHeight * s)); c.getContext('2d').drawImage(im, 0, 0, c.width, c.height); URL.revokeObjectURL(url); let u = c.toDataURL(type, q); if (type === 'image/webp' && u.indexOf('image/webp') < 0) u = c.toDataURL('image/png'); res({ url: u, c }); };
      im.onerror = () => { URL.revokeObjectURL(url); rej(new Error('bad image')); };
      im.src = url;
    });
  }

  /* ================= CSS ================= */
  const HAT_SVG = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 44 36'><path d='M5 31C6 13 17 4 33 6c-5 5-3 12 3 20z' fill='#e8404c'/><path d='M5 31C8 17 15 9 24 7' stroke='#ff8a93' stroke-width='2' fill='none'/><rect x='2' y='26' width='36' height='9' rx='4.5' fill='#fff'/><circle cx='35' cy='6' r='5.5' fill='#fff'/></svg>";
  const css = `
:root{--a2:#2fb8ff;--bar:#0f1320f2;--line:#232a3f;--t:#fff;--on:#001a13;--gk:22}
body[data-cvtheme]{color:var(--t);background-color:var(--bg);background-image:var(--bgi,none);background-attachment:fixed}
body[data-cvtheme] .top{background:var(--bg);background:color-mix(in srgb,var(--bg) 86%,transparent);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}
body[data-cvtheme] .logo{position:relative;flex:none;display:flex;align-items:center}
body[data-cvtheme] .logo b{background:linear-gradient(90deg,var(--a),var(--a2));-webkit-background-clip:text;background-clip:text;color:transparent}
body[data-cvtheme] .logo:not(.cv-img):after{content:var(--ico,'');margin-left:5px;font-size:16px;-webkit-text-fill-color:initial}
body[data-cvtheme].cv-hat .logo:before{content:'';position:absolute;left:-7px;top:-11px;width:25px;height:21px;background:var(--hat) center/contain no-repeat;transform:rotate(-14deg);z-index:2;pointer-events:none}
.cvlogo{height:30px;width:auto;display:block;max-width:150px;object-fit:contain;filter:drop-shadow(0 2px 6px #0006)}
body[data-cvtheme] #q,body[data-cvtheme] .f{color:var(--t);border:1px solid var(--line)}
body[data-cvtheme] #q::placeholder,body[data-cvtheme] .f::placeholder{color:var(--m)}
body[data-cvtheme] #q:focus{box-shadow:0 0 0 2px color-mix(in srgb,var(--a) 45%,transparent)}
body[data-cvtheme] .bar{background:var(--bar);border:1px solid var(--line)}
body[data-cvtheme] .bar .on{background:color-mix(in srgb,var(--a) 16%,transparent)}body[data-cvtheme] .bar .on svg{filter:drop-shadow(0 0 6px color-mix(in srgb,var(--a) 70%,transparent))}
body[data-cvtheme] .btn,body[data-cvtheme] .chips .on{color:var(--on);background:linear-gradient(135deg,var(--a),var(--a2));box-shadow:0 6px 18px color-mix(in srgb,var(--a) 28%,transparent)}
body[data-cvtheme] .btn.g{background:var(--c);color:var(--t);box-shadow:none}
body[data-cvtheme] .pl,body[data-cvtheme] .av{color:var(--on);background:var(--a)}body[data-cvtheme] .pl{box-shadow:0 0 0 6px color-mix(in srgb,var(--a) 18%,transparent),0 6px 20px color-mix(in srgb,var(--a) 40%,transparent)}
body[data-cvtheme] .sec h3:before{background:linear-gradient(var(--a),var(--a2))}
body[data-cvtheme] .pill,body[data-cvtheme] .ec{background:var(--c);color:var(--t)}
body[data-cvtheme] .ec.on{background:color-mix(in srgb,var(--a) 24%,var(--c));color:var(--a);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--a) 50%,transparent)}
body[data-cvtheme] .tag{background:var(--c)}
body[data-cvtheme] .mi{border-bottom-color:var(--line)}body[data-cvtheme] .mi a{color:var(--t)}
body[data-cvtheme] .tabs .on,body[data-cvtheme] .tb .on{color:var(--t);border-bottom-color:var(--a)}
body[data-cvtheme] .sw i{background:var(--line)}body[data-cvtheme] .sw input:checked+i{background:var(--a)}
body[data-cvtheme] .cat,body[data-cvtheme] .sc,body[data-cvtheme] .nv{color:#fff}
body[data-cvtheme] .sc small{color:#c9d0e0}
body[data-cvtheme] .doc,body[data-cvtheme] .doc h4,body[data-cvtheme] .rw b,body[data-cvtheme] .wh,body[data-cvtheme] .sec h3{color:var(--t)}
body[data-cvtheme] .po{border:1px solid var(--line);box-shadow:0 0 16px color-mix(in srgb,var(--a) calc(var(--gk,22)*1%),transparent)}
body[data-cvtheme] .cmt{border-bottom-color:var(--line)}
body[data-cvtheme] .pbar input{accent-color:var(--a)}body[data-cvtheme] .pr.on,body[data-cvtheme] .ppill .tl{color:var(--a)}body[data-cvtheme] .ppill .tl svg{stroke:var(--a)}
body[data-cvtheme] .pc .pb,body[data-cvtheme] .ppill{border-color:color-mix(in srgb,var(--a) 50%,transparent)}body[data-cvtheme] .pm .pb.play{border-color:var(--a)}body[data-cvtheme] .ppn{border-left-color:color-mix(in srgb,var(--a) 40%,transparent)}
body[data-cvtheme] .psw input::-webkit-slider-runnable-track{background:linear-gradient(90deg,var(--a) var(--p,0%),rgba(255,255,255,.22) var(--p,0%))}body[data-cvtheme] .psw input::-webkit-slider-thumb{background:var(--a);box-shadow:0 0 12px var(--a)}body[data-cvtheme] .psw input::-moz-range-progress,body[data-cvtheme] .psw input::-moz-range-thumb{background:var(--a)}
body[data-cvtheme] .nxc button{background:var(--a);color:var(--on)}body[data-cvtheme] .nxc button.g{background:#2a3147;color:#fff}body[data-cvtheme] .wm i{background:linear-gradient(135deg,var(--a),var(--a2))}
body[data-cvtheme]::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:1;background:var(--bgi,none);opacity:.28}
body.cv-motion[data-cvtheme] .btn:hover{box-shadow:0 0 20px color-mix(in srgb,var(--a) 45%,transparent)}
body.cv-raised .card .po,body.cv-raised .cat,body.cv-raised .btn,body.cv-raised .pill,body.cv-raised .mi{box-shadow:0 10px 18px #000c,0 1px 0 #ffffff26 inset,0 -6px 10px #0009 inset}
body.cv-raised .card .po{transform:perspective(520px) rotateX(2deg)}
body.cv-raised .btn{background:linear-gradient(180deg,#fff,#b9c2d4)}
body.cv-light .bar{box-shadow:0 -6px 18px #0000000f}
body.cv-r .po,body.cv-r .cat,body.cv-r .btn,body.cv-r .sc,body.cv-r .mi,body.cv-r .f,body.cv-r #q,body.cv-r .cvb,body.cv-r .pill{border-radius:var(--r)}
body.cv-r .sc .po{border-radius:calc(var(--r)*.6)}
html.cv-ph,body.cv-ph{background:transparent!important}
body.cv-ph .top{background:color-mix(in srgb,var(--bg) 45%,transparent)}
#cvbg{position:fixed;inset:-24px;z-index:-1;background:var(--img) center/cover no-repeat,var(--bgc,#000);filter:blur(var(--blur,6px));pointer-events:none}
#cvbg:after{content:'';position:absolute;inset:0;background:color-mix(in srgb,var(--bg) calc(var(--dim,.55)*100%),transparent)}
#cvfx{position:fixed;inset:0;overflow:hidden;pointer-events:none;z-index:2}
#cvfx span{position:absolute;left:var(--x);top:0;font-size:var(--s);opacity:.62;will-change:transform,opacity;animation-duration:var(--d);animation-delay:var(--dl);animation-iteration-count:infinite;animation-timing-function:linear}
#cvfx.fall span{animation-name:cvfall}#cvfx.rise span{animation-name:cvrise}#cvfx.float span{animation-name:cvfloat;animation-timing-function:ease-in-out;animation-direction:alternate;top:var(--y)}#cvfx.twinkle span{animation-name:cvtw;animation-timing-function:ease-in-out;top:var(--y)}
@keyframes cvfall{from{transform:translate3d(0,-8vh,0) rotate(0)}to{transform:translate3d(var(--dx),108vh,0) rotate(300deg)}}
@keyframes cvrise{from{transform:translate3d(0,108vh,0) scale(.8);opacity:0}15%{opacity:.62}to{transform:translate3d(var(--dx),-10vh,0) scale(1.1);opacity:0}}
@keyframes cvfloat{from{transform:translate3d(0,0,0) rotate(-8deg)}to{transform:translate3d(var(--dx),-5vh,0) rotate(8deg)}}
@keyframes cvtw{0%,100%{opacity:.12;transform:scale(.7)}50%{opacity:.85;transform:scale(1.15)}}
@keyframes cvkb{from{transform:scale(1)}to{transform:scale(1.07)}}
@media(prefers-reduced-motion:reduce){#cvfx{display:none}.cvb-art svg,.cvb-art.ph{animation:none!important}}
#cvbadge{flex:none;width:38px;height:38px;border-radius:50%;border:1px solid var(--line);background:var(--c);color:var(--t);font-size:18px;line-height:1;display:grid;place-items:center;padding:0;box-shadow:0 0 14px color-mix(in srgb,var(--a) 30%,transparent)}
.cvb{position:relative;margin:4px 14px 8px;height:150px;border-radius:18px;overflow:hidden;border:1px solid var(--line);background:var(--c);box-shadow:0 8px 22px #0006}
.cvb-art{position:absolute;inset:0;overflow:hidden}.cvb-art svg{width:100%;height:100%;display:block}
body.cv-motion .cvb-art svg,body.cv-motion .cvb-art.ph{animation:cvkb 18s ease-in-out infinite alternate;transform-origin:78% 50%}
.cvb-art.ph{background:var(--img) center/cover no-repeat}
.cvb:before{content:'';position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,color-mix(in srgb,var(--bg) 92%,transparent) 0%,color-mix(in srgb,var(--bg) 72%,transparent) 46%,transparent 82%)}
.cvb-t{position:absolute;z-index:2;left:14px;top:0;bottom:0;width:62%;display:flex;flex-direction:column;justify-content:center;gap:5px}
.cvb-t small{font-size:10px;letter-spacing:1.4px;text-transform:uppercase;color:var(--a);font-weight:800}
.cvb-t b{font-size:21px;line-height:1.12;color:var(--t);text-shadow:0 2px 12px color-mix(in srgb,var(--bg) 80%,transparent)}
.cvb-t span.s2{font-size:12px;color:var(--t);opacity:.82;line-height:1.3}
.cvb-t .btn{align-self:flex-start;padding:8px 14px;font-size:12px;margin-top:3px}
@media(min-width:760px){.cvb{height:230px;margin:6px 20px 10px}.cvb-t b{font-size:30px}}
.cvs-h{padding:20px 14px 4px}.cvs-h b{display:block;font-size:17px}.cvs-h small{display:block;color:var(--m);margin-top:3px;line-height:1.4}
.cvs-group{padding:12px 14px 0;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--m);font-weight:700}
.cvs-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;padding:8px 14px}
.cvs-card{position:relative;overflow:hidden;height:112px;border-radius:16px;padding:0;text-align:left;border:1px solid #ffffff22;color:#fff;background:#111;cursor:pointer;font:inherit}
.cvs-card .art{position:absolute;inset:0}.cvs-card .art svg{width:100%;height:100%;display:block}
.cvs-card .art.ph{background:var(--img) center/cover}
.cvs-card .shade{position:absolute;inset:0;background:linear-gradient(0deg,#000d 0%,#0003 55%,transparent 100%)}
.cvs-card b,.cvs-card small{position:absolute;left:10px;right:8px;color:#fff;text-shadow:0 1px 6px #000}
.cvs-card b{bottom:22px;font-size:14px}.cvs-card small{bottom:7px;font-size:11px;opacity:.85;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cvs-card.on{border-color:var(--k-a);box-shadow:0 0 0 2px var(--k-a)}
.cvs-card.on:after{content:'✓ ACTIVE';position:absolute;right:8px;top:8px;font-size:9px;font-weight:800;letter-spacing:.7px;color:#fff;background:var(--k-a);padding:3px 7px;border-radius:9px}
.cvs-card.add{background:repeating-linear-gradient(45deg,#1a2033,#1a2033 10px,#151b2c 10px,#151b2c 20px);display:grid;place-items:center;border-style:dashed}
.cvs-card.add span{font-size:30px}
.cvs-prev{margin:12px 14px 4px;border-radius:20px;overflow:hidden;background:var(--bg);background-image:var(--bgi,none);border:1px solid var(--line);box-shadow:0 10px 30px #0006}
.cvs-prev .hd{display:flex;align-items:center;gap:10px;padding:10px 12px}.cvs-prev .hd i{flex:1;height:30px;border-radius:12px;background:var(--c);border:1px solid var(--line)}
.cvs-prev .hd .logo{flex:none}.cvs-prev .cvb{margin:2px 10px 6px;height:130px}.cvs-prev .cvb-t b{font-size:18px}
.cvs-prev .rw2{display:flex;gap:8px;padding:6px 12px 12px}.cvs-prev .rw2 i{flex:1;aspect-ratio:2/3;border-radius:9px;background:var(--c);border:1px solid var(--line)}
.cvs-prev .nb{display:flex;justify-content:space-around;padding:9px;background:var(--bar);border-top:1px solid var(--line);font-size:11px;color:var(--m)}.cvs-prev .nb .on{color:var(--a);font-weight:700}
.cvs-lg{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;padding:8px 14px}
.cvs-lt{position:relative;height:84px;border-radius:14px;border:1px solid var(--line);background:var(--c);display:grid;place-items:center;color:var(--t);font:inherit;padding:8px;cursor:pointer}
.cvs-lt img{max-width:100%;max-height:48px;object-fit:contain}.cvs-lt .logo{font-size:20px}.cvs-lt small{position:absolute;bottom:4px;left:0;right:0;text-align:center;font-size:10px;color:var(--m)}
.cvs-lt.on{border-color:var(--a);box-shadow:0 0 0 2px var(--a)}
.cvs-chips{display:flex;flex-wrap:wrap;gap:8px;padding:8px 14px}
.cvs-chips button{border:1px solid var(--line);background:var(--c);color:var(--t);border-radius:18px;padding:8px 13px;font:inherit;font-size:13px}
.cvs-chips button.on{background:var(--a);color:var(--on);border-color:transparent;font-weight:700}
.cvs-sw{display:flex;flex-wrap:wrap;gap:10px;padding:8px 14px;align-items:center}
.cvs-sw i{width:30px;height:30px;border-radius:50%;border:2px solid #ffffff55;background:var(--c0);cursor:pointer}
.cvs-sw i.on{border-color:#fff;box-shadow:0 0 0 2px var(--c0)}
.cvs-sw input[type=color]{width:34px;height:34px;border:0;background:none;padding:0}
.cvs-sl{padding:6px 14px 2px}.cvs-sl label{display:flex;justify-content:space-between;font-size:13px;color:var(--m)}.cvs-sl input[type=range]{width:100%;accent-color:var(--a)}
.cvs-ph{display:flex;gap:12px;align-items:center;padding:8px 14px}.cvs-ph .th{width:74px;height:74px;border-radius:14px;background:var(--c) center/cover;border:1px solid var(--line);flex:none;display:grid;place-items:center;font-size:26px}
.cvs-ph .bt{display:flex;flex-direction:column;gap:8px;flex:1;min-width:0}.cvs-ph .btn{padding:10px 12px;font-size:13px}
textarea.cvs-code{width:calc(100% - 28px);margin:8px 14px 0;min-height:64px;font-size:11px;word-break:break-all;resize:vertical}
.cvs-row{display:flex;gap:8px;padding:8px 14px}.cvs-row .btn{flex:1;padding:11px 8px;font-size:13px}
#cvgate{position:fixed;inset:0;z-index:60;background:#000b;display:grid;place-items:center;padding:20px}
.cvg-card{background:var(--c,#161b2a);color:var(--t,#fff);border:1px solid var(--line,#232a3f);border-radius:20px;padding:22px 18px;max-width:340px;width:100%;text-align:center;display:flex;flex-direction:column;gap:10px;box-shadow:0 20px 50px #000a}
.cvg-card .cvg-i{font-size:38px}.cvg-card b{font-size:18px}.cvg-card p{margin:0 0 6px;color:var(--m,#8b93a7);font-size:13px;line-height:1.4}
.ad{position:relative}.adl{position:absolute;right:8px;top:8px;font-size:9px;letter-spacing:.6px;text-transform:uppercase;background:#000a;color:#fff;border-radius:6px;padding:2px 6px}
#cvbg[data-mode="video"]{filter:none;background:var(--bgc)}
#cvbg video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;background:#000}
#cvbg video.cvv-src{inset:auto;left:0;top:0;width:2px;height:2px;opacity:.01;pointer-events:none}
#cvbg canvas{position:absolute;inset:0;width:100%;height:100%}
#cvbg .vbk{display:none;position:absolute;inset:-30px;background:var(--img) center/cover;filter:blur(28px) brightness(.7)}
#cvbg[data-fit="fit"] .vbk{display:block}#cvbg[data-fit="fit"] video{object-fit:contain;background:transparent}
#cvbg.live{inset:0;display:flex;gap:10px;justify-content:center;padding:0 6px;background:var(--bgc);filter:none;overflow:hidden}
#cvbg.live:after{background:none}
#cvbg.live .lc{flex:1;min-width:0;overflow:hidden;opacity:.6;transform:rotate(-7deg) scale(1.3)}
#cvbg.live .lc>div{display:flex;flex-direction:column;gap:10px;animation:cvlive var(--d,40s) linear infinite;animation-direction:var(--o,normal);will-change:transform}
#cvbg.live .lc i{display:block;aspect-ratio:2/3;border-radius:12px;background-size:cover;background-position:center;box-shadow:0 8px 20px #0008}
#cvbg.live .lv{position:absolute;inset:0;background:linear-gradient(180deg,color-mix(in srgb,var(--bgc) 80%,transparent),color-mix(in srgb,var(--bgc) 45%,transparent) 38%,color-mix(in srgb,var(--bgc) 88%,transparent));overflow:hidden}
#cvbg.live .lv:after{content:'';position:absolute;inset:0;background:linear-gradient(110deg,transparent 30%,#19e3b122 45%,transparent 60%);animation:cvsweep 7s ease-in-out infinite}
#cvbg.live .lw{position:absolute;left:0;right:0;top:46%;text-align:center;font-weight:900;font-size:46px;letter-spacing:10px;color:#fff;opacity:.07;animation:cvpulse 5s ease-in-out infinite}
@keyframes cvlive{from{transform:translateY(0)}to{transform:translateY(-50%)}}
@keyframes cvsweep{0%{transform:translateX(-60%)}100%{transform:translateX(60%)}}
@keyframes cvpulse{0%,100%{opacity:.04;transform:scale(1)}50%{opacity:.1;transform:scale(1.04)}}
body:not(.cv-motion) #cvbg.live .lc>div,body:not(.cv-motion) #cvbg.live .lv:after,body:not(.cv-motion) #cvbg.live .lw{animation:none}
@media(prefers-reduced-motion:reduce){#cvbg.live .lc>div,#cvbg.live .lv:after,#cvbg.live .lw{animation:none!important}}
.cvs-live{position:absolute;left:8px;top:8px;z-index:2;font-size:9px;font-weight:800;letter-spacing:.8px;color:#fff;background:#e11d48;border-radius:8px;padding:3px 7px}
.li{background-image:var(--u)}
*{-webkit-backdrop-filter:none!important;backdrop-filter:none!important}
body[data-cvtheme] .top{background:var(--bg)}
html{overscroll-behavior-y:none}.row,.hero{overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch}
body.cv-smooth .po{box-shadow:none!important}
body.cv-smooth .btn,body.cv-smooth .pl{box-shadow:none!important}
body.cv-smooth .cvb-art svg,body.cv-smooth .cvb-art.ph{animation:none!important}
body.cv-smooth.cv-raised .card .po{transform:none}
.dlh{display:flex;align-items:center;gap:10px;padding:8px 14px 0}.dlh h2{margin:0;font-size:24px;flex:1}.dlh .dlg{background:none;border:0;color:var(--t);font-size:22px;padding:6px}
.dlc{margin:12px 14px;padding:16px;border-radius:18px;border:1px solid var(--line);background:var(--c);display:flex;gap:16px;align-items:center}
.dlr{width:84px;height:84px;border-radius:50%;background:conic-gradient(var(--a) calc(var(--p)*1%),color-mix(in srgb,var(--m) 25%,transparent) 0);display:grid;place-items:center;flex:none}
.dlr div{width:66px;height:66px;border-radius:50%;background:var(--c);display:grid;place-items:center;font-weight:800;font-size:18px}
.dlc .st{flex:1;min-width:0}.dlc small{color:var(--m)}.dlc .big{font-size:20px;font-weight:700;margin:2px 0}
.dlbar{height:6px;border-radius:4px;background:color-mix(in srgb,var(--m) 25%,transparent);overflow:hidden;margin-top:8px}.dlbar i{display:block;height:100%;background:linear-gradient(90deg,var(--a),var(--a2));border-radius:4px;width:0;transition:width .3s}
.dlf{display:flex;gap:8px;padding:4px 14px 10px;overflow-x:auto;scrollbar-width:none}.dlf span{padding:9px 20px;border-radius:20px;background:var(--c);border:1px solid var(--line);white-space:nowrap}.dlf span.on{background:var(--a);color:var(--on);font-weight:700;border-color:transparent}
.dli{display:flex;gap:12px;padding:12px 14px;border-bottom:1px solid var(--line);align-items:center}
.dli .po{width:72px;flex:none;border-radius:10px;position:relative}
.dli .mid{flex:1;min-width:0}.dli .mid b{display:block;font-size:16px}.dli .m2{color:var(--m);font-size:12px;margin-top:2px}
.dli .stt{font-size:12px;margin-top:7px;display:flex;justify-content:space-between;gap:8px;align-items:center}
.dli .ok{color:#39df91;font-weight:600}.dli .wt{color:var(--a);font-weight:600}.dli .er2{color:#ff9a9a}
.dli .ib{width:40px;height:40px;border-radius:50%;border:1px solid var(--line);background:var(--c);color:var(--t);display:grid;place-items:center;font-size:16px;flex:none;padding:0}
.dli .ib.p{border-color:var(--a);color:var(--a)}
.cvb.tall{height:230px}.cvb.tall .cvb-t{width:50%}.cvb.tall .cvb-t b{font-size:24px}
.cvs-prev .cvb.tall{height:190px}
@media(min-width:760px){.cvb.tall{height:320px}}
#cvundo{position:fixed;left:50%;bottom:92px;transform:translateX(-50%);z-index:21;background:var(--c);color:var(--t);border:1px solid var(--line);border-radius:14px;padding:9px 10px 9px 14px;display:none;align-items:center;gap:12px;box-shadow:0 12px 30px #000a;max-width:92%}
#cvundo button{background:var(--a);color:var(--on);border:0;border-radius:9px;padding:7px 12px;font-weight:700}
`;
  const st = document.createElement('style'); st.id = 'cv-theme-css';
  st.textContent = css + T.map(t => `body[data-cvtheme="${t.id}"]{--bg:${t.bg};--c:${t.c};--a:${t.a};--a2:${t.a2};--m:${t.m};--t:${t.t};--on:${t.on};--bar:${t.bar};--line:${t.line};--bgi:${t.bgi || 'none'};--ico:'${t.ico}'}`).join('\n') + `\nbody{--hat:url("data:image/svg+xml,${encodeURIComponent(HAT_SVG)}")}`;
  document.head.appendChild(st);

  /* ================= PAINT ================= */
  const reduced = () => { try { return matchMedia('(prefers-reduced-motion:reduce)').matches } catch (e) { return false } };
  const VARS = ['--bg', '--c', '--a', '--a2', '--m', '--t', '--on', '--bar', '--line'];
  const vib = () => { try { navigator.vibrate && navigator.vibrate(8) } catch (e) { } };
  function themeNow() {
    const t = Object.assign({}, thById(eff()));
    if (t.id === 'photo' && ST.cvPal) Object.assign(t, ST.cvPal);
    if (ST.cvAcc && /^#[0-9a-f]{6}$/i.test(ST.cvAcc)) { const h = hex2hsl(ST.cvAcc)[0]; t.a = ST.cvAcc; t.a2 = hsl2hex(h + 38, .8, .64); t.on = onCol(ST.cvAcc); }
    return t;
  }
  function buildFx(t) {
    let fx = document.getElementById('cvfx'); if (fx) fx.remove();
    const key = ST.cvFx && ST.cvFx !== 'auto' ? ST.cvFx : t.fx, def = FX[key];
    if (!def || ST.cvMotion === false || ST.saver || reduced()) return;
    fx = document.createElement('div'); fx.id = 'cvfx'; fx.className = def.mode;
    const n = Math.round(def.n * (ST.cvFxN || 1) * (ST.cvSmooth !== false ? 0.5 : 1));
    for (let i = 0; i < n; i++) {
      const s = document.createElement('span'), r = Math.random;
      s.textContent = def.ch[i % def.ch.length];
      s.style.cssText = `--x:${(r() * 96).toFixed(1)}%;--y:${(r() * 88 + 4).toFixed(1)}%;--s:${(10 + r() * 14).toFixed(0)}px;--d:${(def.mode === 'twinkle' ? 2.5 + r() * 4 : def.mode === 'float' ? 5 + r() * 6 : 9 + r() * 12).toFixed(1)}s;--dl:${(-r() * 12).toFixed(1)}s;--dx:${((r() - .5) * 90).toFixed(0)}px`;
      fx.appendChild(s);
    }
    document.body.appendChild(fx);
  }
  function paintLogo(t) {
    const L = document.querySelector('.top .logo'); if (!L) return;
    const m = ST.cvLogo || 'text', src = m === 'own' ? IMG.logo : LOGOS[m];
    if (m !== 'text' && src) { L.classList.add('cv-img'); const cur = L.querySelector('img'); if (!cur || cur.getAttribute('src') !== src) L.innerHTML = '<img class="cvlogo" alt="CineVerse" src="' + src + '">'; }
    else { L.classList.remove('cv-img'); if (L.querySelector('img') || !L.querySelector('b')) L.innerHTML = 'Cine<b>Verse</b>'; }
  }
  function paintBadge(t) {
    let b = document.getElementById('cvbadge'); const top = document.querySelector('.top');
    if (!top) return;
    if (!b) { b = document.createElement('button'); b.id = 'cvbadge'; b.type = 'button'; b.setAttribute('aria-label', 'Theme Studio'); b.onclick = () => cvOpen(); top.appendChild(b); }
    b.textContent = t.bad || '🎨';
  }
  const IS_NATIVE = (() => { try { return !!(window.Capacitor && Capacitor.isNativePlatform && Capacitor.isNativePlatform()); } catch (e) { return false; } })();
  const vidCompat = () => ST.cvVidCompat == null ? IS_NATIVE : !!ST.cvVidCompat;    // in the Android app the video is drawn frame by frame so it never looks frozen
  function startCanvas(v, cv) {
    const ctx = cv.getContext('2d'); let W = 0, H = 0, frames = 0, last = 0;
    const size = () => { const w = Math.min(540, Math.round(innerWidth * Math.min(devicePixelRatio || 1, 1.5))); W = cv.width = w; H = cv.height = Math.max(1, Math.round(w * innerHeight / Math.max(1, innerWidth))); };
    size(); window.addEventListener('resize', size);
    const draw = () => {
      if (!document.body.contains(cv)) return;
      if (v.readyState >= 2 && v.videoWidth) {
        const vw = v.videoWidth, vh = v.videoHeight, fit = (document.getElementById('cvbg') || cv).getAttribute('data-fit') !== 'fill';
        let sx = 0, sy = 0, sw = vw, sh = vh, dx = 0, dy = 0, dw = W, dh = H;
        if (fit) { const r = Math.min(W / vw, H / vh); dw = vw * r; dh = vh * r; dx = (W - dw) / 2; dy = (H - dh) / 2; } else { const r = Math.max(W / vw, H / vh); sw = W / r; sh = H / r; sx = (vw - sw) / 2; sy = (vh - sh) / 2; }
        try { ctx.drawImage(v, sx, sy, sw, sh, dx, dy, dw, dh); frames++; cv.dataset.f = String(frames); } catch (e) { }
      }
      last = Date.now(); next();
    };
    const next = () => { if (v.requestVideoFrameCallback) v.requestVideoFrameCallback(draw); else requestAnimationFrame(draw); };
    next();
    const wd = setInterval(() => { if (!document.body.contains(cv)) return clearInterval(wd); if (!document.hidden && Date.now() - last > 1500) { last = Date.now(); next(); } }, 1000);
  }
  function buildLive(el) {
    const posters = (S.titles || []).map(t => t && t.poster_url).filter(u => /^https?:/.test(u || '')).slice(0, 9);
    const useImg = posters.length >= 3 && !ST.saver;
    let h = '';
    for (let c = 0; c < 3; c++) {
      let cells = '';
      for (let r = 0; r < 6; r++) { const k = c * 3 + r, u = useImg ? posters[(k * 2 + c) % posters.length] : ''; cells += u ? `<i style="background-image:url('${esc(u)}')"></i>` : `<i style="background:linear-gradient(135deg,hsl(${(k * 47) % 360} 55% 32%),hsl(${(k * 47 + 70) % 360} 60% 18%))"></i>`; }
      h += `<div class="lc" style="--d:${36 + c * 10}s;--o:${c % 2 ? 'reverse' : 'normal'}"><div>${cells}${cells}</div></div>`;
    }
    el.innerHTML = h + '<div class="lv"></div><div class="lw">CINEVERSE</div>';
    el.setAttribute('data-n', String((S.titles || []).length));
  }
  function paintBg() {
    const live = thById(eff()).id === 'live', motionOk = ST.cvMotion !== false && !ST.saver && !reduced();
    const vid = !live && ST.cvBgOn && IMG.vid && ST.cvVidOn !== false && motionOk, img = !live && ST.cvBgOn && IMG.bg;
    const mode = live ? 'live' : vid ? 'video' : img ? 'image' : '';
    document.body.classList.toggle('cv-ph', !!mode); document.documentElement.classList.toggle('cv-ph', !!mode);
    let e = document.getElementById('cvbg');
    if (!mode) { if (e) e.remove(); return; }
    if (e && (e.getAttribute('data-mode') !== mode || (mode === 'video' && e.getAttribute('data-compat') !== String(vidCompat())))) { e.remove(); e = null; }
    if (!e) {
      e = document.createElement('div'); e.id = 'cvbg'; e.setAttribute('data-mode', mode); document.body.prepend(e);
      if (mode === 'live') buildLive(e);
      else if (mode === 'video') { const bk = document.createElement('div'); bk.className = 'vbk'; e.appendChild(bk); const v = document.createElement('video'); v.id = 'cvbgv'; if (vidCompat()) v.className = 'cvv-src'; v.src = IMG.vid; v.muted = true; v.defaultMuted = true; v.loop = true; v.autoplay = true; v.setAttribute('playsinline', ''); v.setAttribute('webkit-playsinline', ''); v.setAttribute('disablepictureinpicture', ''); e.appendChild(v); if (vidCompat()) { const cv = document.createElement('canvas'); cv.id = 'cvbgc'; e.appendChild(cv); startCanvas(v, cv); } try { v.play().catch(() => { }); } catch (x) { } }
    }
    e.className = mode === 'live' ? 'live' : ''; e.setAttribute('data-compat', String(vidCompat()));
    e.setAttribute('data-fit', ST.cvVidFit === 'fill' ? 'fill' : 'fit');
    e.style.cssText = `--bgc:${themeNow().bg};--img:url("${IMG.bg || ''}");--dim:${(ST.cvDim == null ? 55 : ST.cvDim) / 100};--blur:${mode === 'video' ? (ST.cvBlur == null ? 0 : ST.cvBlur) : (ST.cvBlur == null ? 6 : ST.cvBlur)}px`;
  }
  document.addEventListener('visibilitychange', () => { const v = document.getElementById('cvbgv'); if (v) { if (document.hidden) v.pause(); else v.play().catch(() => { }); } });
  /* if the phone blocks autoplay, start the video on the first touch, and keep nudging it */
  ['touchend', 'click'].forEach(ev => document.addEventListener(ev, () => { const v = document.getElementById('cvbgv'); if (v && v.paused && !document.hidden) v.play().catch(() => { }); }, { passive: true }));
  setInterval(() => { const v = document.getElementById('cvbgv'); if (v && v.paused && !document.hidden && v.readyState >= 2) v.play().catch(() => { }); }, 3000);
  const vidState = () => { const v = document.getElementById('cvbgv'); if (!IMG.vid) return ''; if (ST.cvVidOn === false) return 'Video is switched off.'; if (ST.saver) return 'Paused: Data saver is on.'; if (ST.cvMotion === false) return 'Paused: animated effects are off.'; if (!v) return 'Video is ready.'; const cv = document.getElementById('cvbgc'); if (cv) { const f = +(cv.dataset.f || 0), pf = cv.__pf || 0; cv.__pf = f; if (f > pf) return 'Playing ✓'; } else if (!v.paused && v.currentTime > 0) return 'Playing ✓'; return 'Waiting. Tap the screen once to start it.'; };
  setInterval(() => { const e = document.getElementById('vidStat'); if (e) e.textContent = vidState(); }, 1500);
  function paint() {
    const t = themeNow(), b = document.body;
    b.dataset.cvtheme = thById(eff()).id;
    VARS.forEach(v => b.style.removeProperty(v));
    const over = (t.custom && ST.cvPal) || ST.cvAcc;
    if (over) { b.style.setProperty('--a', t.a); b.style.setProperty('--a2', t.a2); b.style.setProperty('--on', t.on); }
    if (t.custom && ST.cvPal) ['bg', 'c', 'm', 'bar', 'line'].forEach(k => b.style.setProperty('--' + k, t[k]));
    b.classList.toggle('cv-light', !!t.light); b.classList.toggle('cv-raised', !!t.raised); b.classList.toggle('cv-hat', !!t.hat);
    b.classList.toggle('cv-motion', ST.cvMotion !== false); b.classList.toggle('cv-smooth', ST.cvSmooth !== false);
    const R = { sharp: '3px', soft: '22px' }[ST.cvR]; b.classList.toggle('cv-r', !!R); if (R) b.style.setProperty('--r', R); else b.style.removeProperty('--r');
    b.style.setProperty('--gk', ST.cvGk == null ? 22 : ST.cvGk);
    try { const m = document.querySelector('meta[name="theme-color"]'); if (m) m.content = (t.custom && ST.cvPal ? t.bg : t.bg); } catch (e) { }
    paintBg(); paintLogo(t); paintBadge(t); buildFx(t);
    try { cvBanner(); } catch (e) { }
    try { syncIcon(); } catch (e) { }
  }
  window.applyCVTheme = (id) => { setS('cvTheme', id); paint(); };

  /* ================= HOME BANNER ================= */
  let UID = 0; const uid = () => 'u' + (++UID);
  function artFor(t, cls) {
    if (t.id === 'photo') return IMG.bg ? `<div class="${cls} ph" style="--img:url('${IMG.bg}')"></div>` : `<div class="${cls}"><svg viewBox="0 0 360 150" preserveAspectRatio="xMaxYMid slice">${ART.classic(uid())}</svg></div>`;
    return `<div class="${cls}"><svg viewBox="${t.vb || '0 0 360 150'}" preserveAspectRatio="xMaxYMid slice">${(ART[t.id] || ART.classic)(uid())}</svg></div>`;
  }
  function bannerHTML(t, inStudio) {
    const title = t.id === 'photo' ? (ST.cvTitle || t.bt) : t.bt;
    return `<div class="cvb${t.tall ? ' tall' : ''}" ${inStudio ? '' : 'onclick="cvBannerGo()"'}>${artFor(t, 'cvb-art')}<div class="cvb-t"><small>${esc(t.id === 'photo' ? 'My theme' : t.name)}</small><b>${esc(title)}</b><span class="s2">${esc(t.bs)}</span>${inStudio ? '' : '<button class="btn" type="button">Browse</button>'}</div></div>`;
  }
  function cvBanner() {
    const a = document.getElementById('app'); if (!a) return;
    const old = a.querySelector(':scope > .cvb'); if (old) old.remove();
    if (S.nav !== 'home' || S.sf || ST.cvBanner === false) return;
    const t = themeNow(); if (t.id === 'classic') return;
    if (t.id === 'photo' && !IMG.bg) return;
    a.insertAdjacentHTML('afterbegin', bannerHTML(t));
  }
  window.cvBannerGo = function () {
    const t = themeNow();
    if (t.tab) { S.tab = t.tab; S.nav = 'home'; S.sf = false; go(); scrollTo(0, 0); return; }
    if (t.kw) { const q = document.getElementById('q'); q.value = t.kw; S.q = t.kw; S.sf = true; go(); return; }
    scrollBy({ top: 260, behavior: 'smooth' });
  };

  /* ================= STUDIO UI ================= */
  const secH = (t, d) => `<div class="cvs-h"><b>${t}</b>${d ? `<small>${d}</small>` : ''}</div>`;
  const chips = (list, cur, fn) => `<div class="cvs-chips">${list.map(x => `<button type="button" class="${String(x[0]) === String(cur) ? 'on' : ''}" onclick="${fn}('${x[0]}')">${x[1]}</button>`).join('')}</div>`;
  const slider = (lab, k, min, max, val, unit) => `<div class="cvs-sl"><label><span>${lab}</span><span id="v-${k}">${val}${unit || ''}</span></label><input type="range" min="${min}" max="${max}" value="${val}" oninput="cvSl('${k}',this.value,'${unit || ''}')"></div>`;
  const toggle = (lab, d, on, fn) => `<div class="mi"><span>${lab}<p class="s">${d}</p></span><label class="sw"><input type="checkbox" ${on ? 'checked' : ''} onchange="${fn}(this.checked)"><i></i></label></div>`;
  function themeCard(t, cur) {
    if (t.id === 'photo') {
      if (!IMG.bg) return `<button type="button" class="cvs-card add" onclick="cvPickFile('bg')"><span>＋</span><b>Add my photo</b><small>From your gallery</small></button>`;
      return `<button type="button" class="cvs-card ${cur === 'photo' ? 'on' : ''}" style="--k-a:${(ST.cvPal || t).a}" onclick="cvPick('photo')">${artFor(t, 'art')}<span class="shade"></span><b>🖼️ My Photo</b><small>${esc(ST.cvTitle || 'Your gallery, your style')}</small></button>`;
    }
    return `<button type="button" class="cvs-card ${t.id === cur ? 'on' : ''}" style="--k-a:${t.a}" onclick="cvPick('${t.id}')">${artFor(t, 'art')}<span class="shade"></span>${t.live ? '<span class="cvs-live">● LIVE</span>' : ''}<b>${t.bad} ${esc(t.name)}</b><small>${esc(t.tag)}</small></button>`;
  }
  function logoTile(k, cur) {
