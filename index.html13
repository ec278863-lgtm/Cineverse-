<g fill="#ffe86b" opacity=".8"><rect x="172" y="108" width="3" height="3"/><rect x="178" y="118" width="3" height="3"/><rect x="296" y="122" width="3" height="3"/><rect x="334" y="114" width="3" height="3"/><rect x="340" y="126" width="3" height="3"/></g>
<g stroke="#12031f" stroke-width="5" fill="none" stroke-linecap="round"><path d="M22 214Q26 150 44 96"/><path d="M342 214Q338 160 322 110"/></g><g fill="#12031f"><path d="M44 96q-30-10-44 14 22-8 44-14z"/><path d="M44 96q-6-30-32-34 14 14 32 34z"/><path d="M44 96q22-22 52-14-26 4-52 14z"/><path d="M44 96q30 2 44 28-22-16-44-28z"/><path d="M322 110q-30-8-44 14 22-8 44-14z"/><path d="M322 110q8-30 34-32-16 12-34 32z"/><path d="M322 110q30 0 38 26-20-14-38-26z"/></g>
