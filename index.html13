    const inner = k === 'text' ? '<span class="logo">Cine<b>Verse</b></span>' : `<img src="${k === 'own' ? IMG.logo : LOGOS[k]}" alt="">`;
    return `<button type="button" class="cvs-lt ${k === cur ? 'on' : ''}" onclick="cvLogo('${k}')">${inner}<small>${k === 'own' ? 'My logo' : LOGO_NAMES[k]}</small></button>`;
  }
  window.cvStudio = function () {
    const a = document.getElementById('app'), t = themeNow(), curId = thById(eff()).id, logoCur = ST.cvLogo || 'text';
    S.nav = 'set';
    const groups = []; T.forEach(x => { let g = groups.find(y => y[0] === x.grp); if (!g) groups.push(g = [x.grp, []]); g[1].push(x); });
    const logoPrev = (ST.cvLogo && ST.cvLogo !== 'text' && (ST.cvLogo === 'own' ? IMG.logo : LOGOS[ST.cvLogo])) ? `<span class="logo cv-img"><img class="cvlogo" src="${ST.cvLogo === 'own' ? IMG.logo : LOGOS[ST.cvLogo]}" alt=""></span>` : '<span class="logo">Cine<b>Verse</b></span>';
    const sea = season(), accs = ['#19e3b1', '#4da3ff', '#b44bff', '#ff4d7d', '#ff7a1a', '#f0b94a', '#39df91', '#e8404c', '#ffffff'];
    a.innerHTML = bar('Theme Studio', 'set') +
      `<div class="pad"><p class="s">Tap anything to change the whole app instantly. Your choices are saved on this phone.</p></div>
      <div class="cvs-prev"><div class="hd">${logoPrev}<i></i><span class="cvbadge2" style="width:38px;height:38px;border-radius:50%;border:1px solid var(--line);background:var(--c);display:grid;place-items:center;font-size:18px;flex:none">${t.bad}</span></div>${t.id === 'classic' ? '' : bannerHTML(t, true)}<div class="rw2"><i></i><i></i><i></i><i></i></div><div class="nb"><span class="on">Home</span><span>Downloads</span><span>Me</span></div></div>` +
