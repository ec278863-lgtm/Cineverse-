  ];
  const thById = id => T.find(x => x.id === id) || T[0];
  const FX = {
    snow: { ch: ['❄️', '❅', '❆'], mode: 'fall', n: 18 }, hearts: { ch: ['💖', '❤️', '💗', '💕'], mode: 'rise', n: 16 },
    petals: { ch: ['🌸', '🌷', '🌼', '🦋'], mode: 'float', n: 12 }, stars: { ch: ['✦', '⭐', '✧', '·'], mode: 'twinkle', n: 20 },
    gold: { ch: ['✨', '✦', '·'], mode: 'twinkle', n: 16 }, gems: { ch: ['💎', '✦', '✧'], mode: 'twinkle', n: 14 },
    bubbles: { ch: ['🫧', '🐚', '☀️'], mode: 'rise', n: 12 }, bats: { ch: ['🦇', '🎃', '🕷️', '👻'], mode: 'float', n: 12 },
    confetti: { ch: ['🎉', '🎊', '✨', '🎁'], mode: 'fall', n: 16 }, bolts: { ch: ['⚡', '✦', '🌸'], mode: 'fall', n: 14 },
    moon: { ch: ['✨', '⭐', '🌙', '🎆'], mode: 'twinkle', n: 16 }, space: { ch: ['✦', '·', '⭐', '🪐'], mode: 'twinkle', n: 22 },
