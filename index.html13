    pink: u => `<defs><linearGradient id="a${u}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffc0dd"/><stop offset="1" stop-color="#ffeef6"/></linearGradient></defs><rect width="360" height="150" fill="url(#a${u})"/><g fill="#fff" opacity=".9"><ellipse cx="200" cy="118" rx="38" ry="14"/><ellipse cx="225" cy="110" rx="26" ry="14"/><ellipse cx="320" cy="30" rx="30" ry="11"/><ellipse cx="338" cy="24" rx="18" ry="10"/></g><g transform="translate(262 74)"><path d="M0 0C-34-34-60-18-52 4-60 26-34 38 0 0z" fill="#ff5fa2" stroke="#ff2f87" stroke-width="2"/><path d="M0 0C34-34 60-18 52 4 60 26 34 38 0 0z" fill="#ff5fa2" stroke="#ff2f87" stroke-width="2"/><path d="M-4 6L-26 44 -12 40-8 50z" fill="#ff7fb8"/><path d="M4 6L26 44 12 40 8 50z" fill="#ff7fb8"/><circle r="9" fill="#ff2f87"/><path d="M-36-8q10-6 20 0M16-8q10-6 20 0" stroke="#fff" stroke-opacity=".6" stroke-width="3" fill="none" stroke-linecap="round"/></g><path transform="translate(196 44) scale(.4)" d="M0 40C-60 0-45-45-15-40-5-38 0-30 0-30S5-38 15-40C45-45 60 0 0 40z" fill="#ff8fc0"/><path transform="translate(334 106) scale(.5)" d="M0 40C-60 0-45-45-15-40-5-38 0-30 0-30S5-38 15-40C45-45 60 0 0 40z" fill="#ff8fc0"/>${star(330, 62, 2.5, '#fff')}${star(190, 100, 2, '#fff')}${star(228, 20, 2, '#fff')}<path d="M300 90l2 6 6 2-6 2-2 6-2-6-6-2 6-2z" fill="#fff"/>`,
    '3d': u => `<defs><linearGradient id="a${u}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2a2e3a"/><stop offset="1" stop-color="#050608"/></linearGradient><radialGradient id="s${u}" cx=".35" cy=".3" r=".8"><stop offset="0" stop-color="#fff"/><stop offset=".5" stop-color="#9db8ff"/><stop offset="1" stop-color="#1e3a8a"/></radialGradient><linearGradient id="f${u}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".18"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient></defs><rect width="360" height="150" fill="url(#a${u})"/><rect y="112" width="360" height="38" fill="url(#f${u})"/><ellipse cx="248" cy="124" rx="44" ry="8" fill="#000" opacity=".5"/><circle cx="248" cy="84" r="36" fill="url(#s${u})"/><ellipse cx="236" cy="70" rx="10" ry="6" fill="#fff" opacity=".7"/><g transform="translate(318 96)"><path d="M0-30l28 14-28 14-28-14z" fill="#e3e9f5"/><path d="M-28-16L0-2V32L-28 18z" fill="#8fa0c0"/><path d="M28-16L0-2V32L28 18z" fill="#4c5a7a"/></g><ellipse cx="318" cy="130" rx="30" ry="6" fill="#000" opacity=".45"/><g transform="translate(190 108)"><ellipse rx="16" ry="5" cy="-14" fill="#e3e9f5"/><path d="M-16-14V8q16 10 32 0V-14q-16 8-32 0z" fill="#8fa0c0"/></g>${star(200, 24, 1.6)}${star(336, 36, 1.8)}`,
    beach: u => `<defs><linearGradient id="a${u}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7fdcf0"/><stop offset="1" stop-color="#d8f6ff"/></linearGradient><linearGradient id="w${u}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#0aa6c2"/><stop offset="1" stop-color="#0b6f94"/></linearGradient><radialGradient id="s${u}" cx=".5" cy=".5" r=".5"><stop offset=".3" stop-color="#fff2a0"/><stop offset="1" stop-color="#fff2a0" stop-opacity="0"/></radialGradient></defs><rect width="360" height="150" fill="url(#a${u})"/><circle cx="312" cy="30" r="46" fill="url(#s${u})"/><circle cx="312" cy="30" r="20" fill="#ffd34d"/><rect y="78" width="360" height="40" fill="url(#w${u})"/><path d="M0 92q20-8 40 0t40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0" stroke="#fff" stroke-opacity=".7" stroke-width="3" fill="none"/><path d="M0 106q20-8 40 0t40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0" stroke="#fff" stroke-opacity=".4" stroke-width="3" fill="none"/><path d="M0 150V116q90-12 180 0t180-4v38z" fill="#f6d596"/><path d="M262 140Q256 100 276 62" stroke="#7a4a1d" stroke-width="6" fill="none" stroke-linecap="round"/><g fill="#2fa84f"><path d="M276 62q-30-8-44 12 24-6 44-12z"/><path d="M276 62q-8-30-34-30 18 12 34 30z"/><path d="M276 62q14-28 42-22-22 6-42 22z"/><path d="M276 62q32-4 44 20-22-14-44-20z"/></g><g transform="translate(206 112)"><path d="M0 0a24 24 0 0 1 48 0z" transform="translate(-24 0)" fill="#ff5c5c"/><path d="M-24 0a8 8 0 0 1 16 0zM8 0a8 8 0 0 1 16 0z" fill="#fff"/><path d="M0-24V16" stroke="#7a4a1d" stroke-width="3"/></g>${star(190, 30, 0, '#fff')}`,
    anime: u => `<defs><linearGradient id="a${u}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2a0f7a"/><stop offset="1" stop-color="#07051a"/></linearGradient><radialGradient id="g${u}" cx=".5" cy=".5" r=".5"><stop offset=".5" stop-color="#ff4fd8" stop-opacity=".6"/><stop offset="1" stop-color="#ff4fd8" stop-opacity="0"/></radialGradient></defs><rect width="360" height="150" fill="url(#a${u})"/><circle cx="276" cy="66" r="80" fill="url(#g${u})"/><circle cx="276" cy="66" r="38" fill="#ffd0f6"/><circle cx="276" cy="66" r="38" fill="none" stroke="#ff4fd8" stroke-width="3"/><g stroke="#19e3ff" stroke-width="1.2" opacity=".5"><path d="M276 66L180 0M276 66L360 20M276 66L190 130M276 66L360 130"/></g><path d="M0 150V112h14V96h18v20h12V84h22v36h14V100h16v24h12V90h20v34h16V104h14V120h18V98h18v52z" fill="#0b0626"/><g fill="#19e3ff"><rect x="20" y="104" width="3" height="3"/><rect x="52" y="94" width="3" height="3"/><rect x="108" y="108" width="3" height="3"/><rect x="152" y="98" width="3" height="3"/><rect x="214" y="110" width="3" height="3"/></g><path d="M226 12l-24 56h18l-12 44 42-60h-20l16-40z" fill="#19e3ff" stroke="#fff" stroke-width="1.2"/><g fill="#ff9fd0"><ellipse cx="190" cy="30" rx="4" ry="2.4" transform="rotate(30 190 30)"/><ellipse cx="330" cy="104" rx="4" ry="2.4" transform="rotate(-20 330 104)"/><ellipse cx="340" cy="40" rx="3.5" ry="2" transform="rotate(50 340 40)"/></g>`,
    live: u => `<defs><linearGradient id="a${u}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#0b1330"/><stop offset="1" stop-color="#1b0f45"/></linearGradient><linearGradient id="p${u}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#19e3b1"/><stop offset="1" stop-color="#7c6bff"/></linearGradient><clipPath id="c${u}"><rect x="190" y="0" width="170" height="150"/></clipPath></defs><rect width="360" height="150" fill="url(#a${u})"/><g clip-path="url(#c${u})" opacity=".95">${[0, 1, 2].map(i => `<g transform="translate(${200 + i * 52} 0)"><g><animateTransform attributeName="transform" type="translate" from="0 ${i % 2 ? -96 : 0}" to="0 ${i % 2 ? 0 : -96}" dur="${6 + i * 2}s" repeatCount="indefinite"/>${[0, 1, 2, 3, 4, 5].map(k => `<rect x="0" y="${k * 48}" width="44" height="40" rx="6" fill="hsl(${(i * 70 + (k % 2) * 80) % 360} 65% ${36 + (i % 2) * 8}%)"/>`).join('')}</g></g>`).join('')}</g><circle cx="262" cy="75" r="32" fill="#000" opacity=".4"/><circle cx="262" cy="75" r="26" fill="none" stroke="url(#p${u})" stroke-width="3"><animate attributeName="r" values="24;31;24" dur="2.4s" repeatCount="indefinite"/></circle><path d="M254 62l22 13-22 13z" fill="#fff"/>${star(190, 30, 2, '#19e3b1')}${star(176, 118, 1.8, '#7c6bff')}`,
    photo: () => ''
  };

  /* ===== hero artwork with characters (all original drawings) ===== */
// ===== Original character & scene art (no third-party characters, logos or names) =====
// "Mochi" - an original collectible character, drawn in gold / silver / diamond finishes
const figure = (u, mat, x, y, s) => {
  const G = {
    gold:    ['#fff0b8', '#f0b94a', '#8a5a10', '#6b430a'],
    silver:  ['#ffffff', '#b4bcc9', '#4d5562', '#2f3541'],
    diamond: ['#e9f7ff', '#7fc3ff', '#2468d8', '#123a8c']
  }[mat];
  const f = `url(#m${u})`, st = G[3];
  const facets = mat === 'diamond' ? `<g fill="#fff" opacity=".28"><path d="M-30 30L0 0 4 30z"/><path d="M4 30L30 38 8 66z" opacity=".6"/><path d="M-34 34L-12 62-30 80z" opacity=".5"/></g><g fill="#0d3a8a" opacity=".22"><path d="M0 0L30 34 4 30z"/><path d="M-12 62L8 66-6 90z"/></g><g stroke="#fff" stroke-opacity=".5" stroke-width="1" fill="none"><path d="M-34 34L0 0 34 34M0 0L4 30M-34 34L4 30 34 34"/></g>` : '';
  const crown = mat === 'gold' ? `<path d="M-15 2L-19 -20-8 -10 0 -26 8 -10 19 -20 15 2z" fill="#ffe27a" stroke="#8a5a10" stroke-width="1.5"/><circle cx="0" cy="-8" r="2.6" fill="#e33"/>` : '';
  const cape = mat === 'gold' ? `<path d="M-30 72C-46 100-44 130-38 146L38 146C44 130 46 100 30 72z" fill="#5a2f0c"/><path d="M-38 146L38 146" stroke="#ffe27a" stroke-width="3"/>` : '';
  return `<defs><radialGradient id="m${u}" cx=".35" cy=".25" r=".95"><stop offset="0" stop-color="${G[0]}"/><stop offset=".45" stop-color="${G[1]}"/><stop offset="1" stop-color="${G[2]}"/></radialGradient></defs>
<g transform="translate(${x} ${y}) scale(${s})">${cape}
<path d="M-27 20L-37 -14-12 6z" fill="${f}" stroke="${st}" stroke-width="1.6" stroke-linejoin="round"/><path d="M27 20L37 -14 12 6z" fill="${f}" stroke="${st}" stroke-width="1.6" stroke-linejoin="round"/>
<path d="M-24 14L-30 -6-14 6z" fill="#fff" opacity=".35"/><path d="M24 14L30 -6 14 6z" fill="#fff" opacity=".35"/>
<ellipse cx="-34" cy="94" rx="10" ry="17" transform="rotate(22 -34 94)" fill="${f}" stroke="${st}" stroke-width="1.6"/><ellipse cx="34" cy="94" rx="10" ry="17" transform="rotate(-22 34 94)" fill="${f}" stroke="${st}" stroke-width="1.6"/>
<ellipse cx="0" cy="102" rx="31" ry="36" fill="${f}" stroke="${st}" stroke-width="1.6"/>
<ellipse cx="0" cy="108" rx="18" ry="22" fill="#fff" opacity=".22"/>
<ellipse cx="-15" cy="138" rx="15" ry="8" fill="${f}" stroke="${st}" stroke-width="1.6"/><ellipse cx="15" cy="138" rx="15" ry="8" fill="${f}" stroke="${st}" stroke-width="1.6"/>
<circle cx="0" cy="36" r="35" fill="${f}" stroke="${st}" stroke-width="1.8"/>
${facets}
<ellipse cx="-12" cy="34" rx="7" ry="9.5" fill="#1a1230"/><ellipse cx="12" cy="34" rx="7" ry="9.5" fill="#1a1230"/>
<circle cx="-14" cy="30" r="3" fill="#fff"/><circle cx="10" cy="30" r="3" fill="#fff"/><circle cx="-10" cy="38" r="1.5" fill="#fff" opacity=".8"/><circle cx="14" cy="38" r="1.5" fill="#fff" opacity=".8"/>
<path d="M-11 50Q0 60 11 50" fill="none" stroke="#1a1230" stroke-width="2.6" stroke-linecap="round"/>
<circle cx="-24" cy="46" r="5.5" fill="#ff7fa6" opacity=".55"/><circle cx="24" cy="46" r="5.5" fill="#ff7fa6" opacity=".55"/>
<path d="M-22 14Q-8 4 6 8" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" opacity=".6"/>${crown}</g>`;
};
ART.gold = u => `<defs><linearGradient id="a${u}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#8a5f18"/><stop offset="1" stop-color="#150e04"/></linearGradient><radialGradient id="b${u}" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#ffe49a" stop-opacity=".95"/><stop offset="1" stop-color="#ffe49a" stop-opacity="0"/></radialGradient></defs><rect width="360" height="230" fill="url(#a${u})"/><ellipse cx="268" cy="112" rx="150" ry="120" fill="url(#b${u})"/><path d="M0 0h44q-14 115 0 230H0z" fill="#3b2708"/><path d="M360 0h-44q14 115 0 230h44z" fill="#3b2708"/><g fill="#caa24a" opacity=".5"><rect x="150" y="10" width="14" height="200" rx="3"/><rect x="178" y="10" width="14" height="200" rx="3"/></g><ellipse cx="268" cy="206" rx="78" ry="12" fill="#000" opacity=".45"/><ellipse cx="268" cy="200" rx="64" ry="9" fill="#e8b84a"/>${figure(u, 'gold', 268, 44, 1.12)}${star(196, 36, 2.4, '#fff3c4')}${star(338, 50, 2.6, '#fff3c4')}${star(210, 176, 2, '#fff3c4')}${star(330, 150, 2.2, '#fff3c4')}`;
ART.silver = u => `<defs><linearGradient id="a${u}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#626875"/><stop offset="1" stop-color="#0c0e12"/></linearGradient><mask id="m2${u}"><rect width="360" height="230" fill="#fff"/><circle cx="296" cy="64" r="34" fill="#000"/></mask></defs><rect width="360" height="230" fill="url(#a${u})"/><g stroke="#fff" stroke-opacity=".07"><path d="M40 0v230M80 0v230M120 0v230M160 0v230"/></g><circle cx="276" cy="66" r="42" fill="#eef1f6" mask="url(#m2${u})"/><ellipse cx="268" cy="208" rx="92" ry="14" fill="#9aa3b2" opacity=".5"/><ellipse cx="268" cy="202" rx="72" ry="10" fill="#d5dbe5"/>${figure(u, 'silver', 268, 46, 1.1)}${star(200, 40, 2)}${star(340, 150, 2)}${star(196, 150, 1.6)}${star(230, 20, 1.5)}`;
ART.diamond = u => `<defs><linearGradient id="a${u}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1d4fb8"/><stop offset="1" stop-color="#050c24"/></linearGradient></defs><rect width="360" height="230" fill="url(#a${u})"/><g fill="#7fd6ff" opacity=".3"><path d="M150 230l24-130 26 130z"/><path d="M196 230l20-100 24 100z"/><path d="M296 230l22-150 30 150z"/><path d="M338 230l12-90 16 90z"/><path d="M236 230l14-70 16 70z"/></g><g fill="#bfeaff" opacity=".35"><path d="M174 100l12 130-12-60z"/><path d="M318 80l16 150-12-70z"/></g><ellipse cx="268" cy="208" rx="82" ry="12" fill="#7fd6ff" opacity=".35"/>${figure(u, 'diamond', 268, 46, 1.1)}${star(196, 38, 2.4)}${star(340, 40, 2.2)}${star(332, 190, 2.6)}${star(190, 190, 1.8)}`;
ART.neon = u => `<defs><linearGradient id="a${u}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1a0638"/><stop offset=".55" stop-color="#8a1fa8"/><stop offset=".8" stop-color="#ff5c8a"/><stop offset="1" stop-color="#ffb347"/></linearGradient><linearGradient id="s${u}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffe86b"/><stop offset="1" stop-color="#ff3d9a"/></linearGradient><linearGradient id="c${u}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#6a2ad8"/><stop offset=".5" stop-color="#2a0f66"/><stop offset="1" stop-color="#0d0420"/></linearGradient><clipPath id="k${u}"><rect x="180" y="40" width="130" height="86"/></clipPath></defs>
