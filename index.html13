      (IMG.logo ? `<div class="cvs-row"><button class="btn g" onclick="cvPickFile('logo')">Change my logo</button><button class="btn g" onclick="cvDelImg('logo')">Remove my logo</button></div>` : '') +
      secH('🖼️ My photo theme', 'Use a picture or a short video (under 25 MB) from your gallery. Colours are picked automatically.') +
      `<div class="cvs-ph"><div class="th" style="${IMG.bg ? `background-image:url('${IMG.bg}')` : ''}">${IMG.bg ? '' : '🖼️'}</div><div class="bt"><button class="btn" onclick="cvPickFile('bg')">${IMG.bg ? 'Change photo' : 'Choose from gallery'}</button>${IMG.bg ? '<button class="btn g" onclick="cvDelImg(\'bg\')">Remove photo</button>' : ''}<button class="btn g" onclick="cvPickFile('vid')">${IMG.vid ? 'Change video' : 'Choose a video'}</button>${IMG.vid ? '<button class="btn g" onclick="cvDelImg(\'vid\')">Remove video</button>' : ''}</div></div>` +
      (IMG.bg ? toggle('Photo as background', 'Show your photo behind the whole app', !!ST.cvBgOn, 'cvBgTog') + (IMG.vid ? toggle('Play video background', 'Your video plays silently behind the app. Turn off to save battery and data.', ST.cvVidOn !== false, 'cvVidTog') + '<div class="cvs-sw" style="padding-bottom:0"><span class="s">Video size</span></div>' + chips([['fit', 'Show whole video'], ['fill', 'Fill the screen']], ST.cvVidFit === 'fill' ? 'fill' : 'fit', 'cvVidFit') + '<p class="s" id="vidStat" style="padding:4px 14px">' + vidState() + '</p>' + toggle('Compatibility mode', 'Draws the video frame by frame. Turn it on if your video looks frozen.', vidCompat(), 'cvVidCompatTog') : '') + slider('Photo darkness', 'dim', 10, 90, ST.cvDim == null ? 55 : ST.cvDim, '%') + slider('Photo blur', 'blur', 0, 16, ST.cvBlur == null ? 6 : ST.cvBlur, 'px') + `<div class="pad"><input class="f" id="cvTitleIn" maxlength="26" placeholder="Banner title (e.g. My CineVerse)" value="${esc(ST.cvTitle || '')}" oninput="cvTitle(this.value)"></div><div class="cvs-row"><button class="btn g" onclick="cvAutoCol()">✨ Re-pick colours from photo</button></div>` : '') +
      secH('🎛️ Fine-tune', 'Works on top of any theme.') +
      `<div class="cvs-sw" style="--x:0"><span class="s" style="width:100%;margin-bottom:-2px">Accent colour</span>${accs.map(c => `<i class="${ST.cvAcc === c ? 'on' : ''}" style="--c0:${c}" onclick="cvAcc('${c}')"></i>`).join('')}<input type="color" value="${ST.cvAcc || t.a}" onchange="cvAcc(this.value)" aria-label="Custom colour"><button class="btn g" style="padding:8px 12px;font-size:12px" onclick="cvAcc(null)">Theme colour</button></div>` +
      `<div class="cvs-sw" style="padding-bottom:0"><span class="s">Card corners</span></div>` + chips([['sharp', 'Sharp'], ['round', 'Round'], ['soft', 'Extra soft']], ST.cvR || 'round', 'cvCorner') +
      slider('Poster glow', 'gk', 0, 60, ST.cvGk == null ? 22 : ST.cvGk, '') +
      `<div class="cvs-sw" style="padding-bottom:0"><span class="s">Floating effect</span></div>` + chips(FX_PICK, ST.cvFx || 'auto', 'cvFxPick') +
      `<div class="cvs-sw" style="padding-bottom:0"><span class="s">Effect amount</span></div>` + chips([['0.5', 'Light'], ['1', 'Normal'], ['1.7', 'Lots']], String(ST.cvFxN || 1), 'cvFxAmt') +
      toggle('Smooth mode', 'Fewer glows and effects so scrolling stays fast. Recommended for most phones.', ST.cvSmooth !== false, 'cvSmoothTog') +
      toggle('Animated effects', 'Falling effects, banner zoom and glow. Turn off to save battery.', ST.cvMotion !== false, 'cvMotion') +
      toggle('Home banner', 'Show the themed picture banner at the top of Home.', ST.cvBanner !== false, 'cvBnTog') +
      secH('🤖 Smart', 'Let CineVerse dress up for the day.') +
      toggle('Auto seasonal theme', sea ? (ST.cvAuto ? `Today: ${SEASON_NAME[sea]} theme is active` : `Today it would switch to the ${SEASON_NAME[sea]} theme`) : 'Switches to Christmas, Valentine’s, Easter, Halloween, Eid and New Year on their days', !!ST.cvAuto, 'cvAutoTog') +
      (CVN ? toggle('Change app icon with theme', 'The CineVerse icon on your home screen follows your theme. It changes when you leave the app, so the app never closes by itself.', ST.cvIconOn !== false, 'cvIconTog') : '') +
      `<div class="cvs-row"><button class="btn" onclick="cvSurprise()">🎲 Surprise me</button><button class="btn g" onclick="cvReset()">Reset all</button></div>` +
      secH('📤 Share your style', 'Copy a code and send it to a friend. They paste it here to get the same style (photos are not included).') +
      `<textarea class="f cvs-code" id="cvCode" readonly>${esc(makeCode())}</textarea><div class="cvs-row"><button class="btn g" onclick="cvCopy()">Copy my code</button><button class="btn g" onclick="cvPaste()">Paste a code</button></div>` +
      `<div class="pad"><p class="s mt">Themes change colours, pictures and effects only. They do not give VIP access.</p></div><input type="file" id="cvFile" accept="image/*" hidden onchange="cvFileSel(this)">`;
  };
  function rerender() { const y = window.scrollY; cvStudio(); window.scrollTo(0, y); }
  window.cvOpen = function () { S.nav = 'set'; S.sf = false; go(); cvStudio(); scrollTo(0, 0); };

  /* ---- undo bar ---- */
  let undoSnap = null, undoT;
  const KEYS = ['cvTheme', 'cvLogo', 'cvAcc', 'cvFx', 'cvBgOn', 'cvPal', 'cvAuto'];
  function snap() { const o = {}; KEYS.forEach(k => o[k] = ST[k]); return o; }
  function showUndo(msg) {
    let u = document.getElementById('cvundo'); if (!u) { u = document.createElement('div'); u.id = 'cvundo'; document.body.appendChild(u); }
    u.innerHTML = `<span>${esc(msg)}</span><button type="button" onclick="cvUndo()">Undo</button>`; u.style.display = 'flex'; clearTimeout(undoT); undoT = setTimeout(() => u.style.display = 'none', 6000);
  }
  window.cvUndo = function () { if (!undoSnap) return; KEYS.forEach(k => setS(k, undoSnap[k] == null ? null : undoSnap[k])); undoSnap = null; const u = document.getElementById('cvundo'); if (u) u.style.display = 'none'; paint(); rerender(); };
  function change(fn, msg) { undoSnap = snap(); fn(); paint(); vib(); rerender(); if (msg) showUndo(msg); }

  /* ---- handlers ---- */
  window.cvPick = function (id) {
    if (id === 'photo' && !IMG.bg) return cvPickFile('bg');
    change(() => { setS('cvTheme', id); setS('cvAuto', false); if (id !== 'photo') setS('cvBgOn', false); else setS('cvBgOn', true); }, thById(id).name + ' applied');
  };
  window.cvLogo = function (k) { if (k === 'own' && !IMG.logo) return cvPickFile('logo'); change(() => setS('cvLogo', k), 'Logo changed'); };
  window.cvAcc = function (c) { change(() => setS('cvAcc', c)); };
  window.cvCorner = function (k) { change(() => setS('cvR', k === 'round' ? null : k)); };
  window.cvFxPick = function (k) { change(() => setS('cvFx', k)); };
  window.cvFxAmt = function (k) { change(() => setS('cvFxN', +k)); };
  window.cvMotion = function (v) { setS('cvMotion', v); paint(); };
  window.cvBnTog = function (v) { setS('cvBanner', v); paint(); };
  window.cvBgTog = function (v) { setS('cvBgOn', v); paint(); };
  window.cvAutoTog = function (v) { setS('cvAuto', v); paint(); rerender(); };
  window.cvTitle = function (v) { setS('cvTitle', v.slice(0, 26)); const b = document.querySelector('.cvs-prev .cvb-t b'); if (b) b.textContent = v || 'My CineVerse'; };
  window.cvSl = function (k, v, unit) {
    v = +v; const e = document.getElementById('v-' + k); if (e) e.textContent = v + (unit || '');
    if (k === 'gk') { setS('cvGk', v); document.body.style.setProperty('--gk', v); } else if (k === 'dim') { setS('cvDim', v); paintBg(); } else if (k === 'blur') { setS('cvBlur', v); paintBg(); }
  };
  window.cvSurprise = function () { const pool = T.filter(x => x.id !== 'photo' && x.id !== eff()); const x = pool[Math.floor(Math.random() * pool.length)]; change(() => { setS('cvTheme', x.id); setS('cvAuto', false); setS('cvBgOn', false); }, '🎲 ' + x.name); };
  window.cvReset = function () { change(() => { ['cvTheme', 'cvLogo', 'cvAcc', 'cvFx', 'cvFxN', 'cvR', 'cvGk', 'cvAuto', 'cvBgOn', 'cvDim', 'cvBlur', 'cvTitle', 'cvBanner'].forEach(k => setS(k, null)); }, 'Reset to Classic'); };
  window.cvAutoCol = function () { if (!IMG.bg) return; const im = new Image(); im.onload = () => { const c = document.createElement('canvas'); c.width = im.naturalWidth; c.height = im.naturalHeight; c.getContext('2d').drawImage(im, 0, 0); change(() => { setS('cvPal', palFromCanvas(c)); setS('cvAcc', null); }, 'Colours updated'); }; im.src = IMG.bg; };

  let fileTarget = 'bg';
  window.cvPickFile = function (t) { fileTarget = t; const f = document.getElementById('cvFile'); if (!f) return; f.value = ''; f.accept = t === 'vid' ? 'video/*' : 'image/*'; f.click(); };
  window.cvVidTog = v => { setS('cvVidOn', v); paint(); };
  window.cvVidCompatTog = v => { setS('cvVidCompat', v); paint(); rerender(); };
  window.cvVidFit = k => { setS('cvVidFit', k); paint(); rerender(); };
  window.cvFileSel = async function (inp) {
    const f = inp.files && inp.files[0]; if (!f) return;
    if (fileTarget !== 'vid' && !/^image\//.test(f.type)) return toast('Please choose a picture');
    try {
      if (fileTarget === 'vid') {
        if (!/^video\//.test(f.type)) return toast('Please choose a video');
        if (f.size > 25 * 1024 * 1024) return toast('That video is too big. Choose a short clip under 25 MB.');
        let ok = false; try { await idb.set('vid', f); ok = true; } catch (e) { }
        if (!ok) return toast('Could not save this video on this phone');
        const url = URL.createObjectURL(f); let c;
        try { c = await videoFrame(url); } catch (e) { URL.revokeObjectURL(url); try { await idb.del('vid'); } catch (x) { } return toast('This video type is not supported. Try an MP4 clip.'); }
        const fr = c.toDataURL('image/jpeg', .8); await saveImg('bg', fr); IMG.bg = fr; if (IMG.vid) { try { URL.revokeObjectURL(IMG.vid); } catch (e) { } } IMG.vid = url;
        const pal = palFromCanvas(c);
        change(() => { setS('cvPal', pal); setS('cvTheme', 'photo'); setS('cvAuto', false); setS('cvBgOn', true); setS('cvVidOn', true); setS('cvVidFit', c.width >= c.height ? 'fit' : 'fill'); setS('cvBanner', true); setS('cvAcc', null); }, 'Video theme ready');
        return;
      }
      if (fileTarget === 'bg') {
        const r = await readImg(f, 1000, 'image/jpeg', .8), ok = await saveImg('bg', r.url);
        if (!ok) return toast('This photo is too big to save on this phone');
        IMG.bg = r.url; const pal = palFromCanvas(r.c);
        change(() => { setS('cvPal', pal); setS('cvTheme', 'photo'); setS('cvAuto', false); setS('cvBgOn', true); setS('cvBanner', true); setS('cvAcc', null); }, 'Photo theme ready');
      } else {
        const r = await readImg(f, 520, 'image/webp', .88), ok = await saveImg('logo', r.url);
        if (!ok) return toast('This logo is too big to save on this phone');
        IMG.logo = r.url; change(() => setS('cvLogo', 'own'), 'Logo changed');
      }
    } catch (e) { toast('Could not open that picture'); }
  };
  function videoFrame(url) {
    return new Promise((res, rej) => {
      const v = document.createElement('video'); v.muted = true; v.playsInline = true; v.preload = 'auto'; v.src = url;
      const t = setTimeout(() => rej(new Error('timeout')), 12000);
      v.onerror = () => { clearTimeout(t); rej(new Error('format')); };
      v.onloadedmetadata = () => { try { v.currentTime = Math.min(1, (v.duration || 2) / 3); } catch (e) { } };
      v.onseeked = () => { clearTimeout(t); const w = v.videoWidth || 900, h = v.videoHeight || 506, sc = Math.min(1, 900 / Math.max(w, h)), c = document.createElement('canvas'); c.width = Math.max(1, Math.round(w * sc)); c.height = Math.max(1, Math.round(h * sc)); try { c.getContext('2d').drawImage(v, 0, 0, c.width, c.height); res(c); } catch (e) { rej(e); } };
    });
  }
  window.cvDelImg = async function (k) {
    if (k === 'vid') { try { await idb.del('vid'); } catch (e) { } if (IMG.vid) { try { URL.revokeObjectURL(IMG.vid); } catch (e) { } } IMG.vid = null; return change(() => setS('cvVidOn', null)); }
    try { await idb.del(k); } catch (e) { } try { localStorage.removeItem('cv-img-' + k); } catch (e) { }
    IMG[k] = null;
    change(() => { if (k === 'bg') { setS('cvBgOn', false); setS('cvPal', null); if (ST.cvTheme === 'photo') setS('cvTheme', 'classic'); } else if (ST.cvLogo === 'own') setS('cvLogo', 'text'); });
  };

  /* ---- share code ---- */
  function makeCode() { const o = { t: ST.cvTheme && ST.cvTheme !== 'photo' ? ST.cvTheme : 'classic', l: ST.cvLogo && ST.cvLogo !== 'own' ? ST.cvLogo : 'text', ac: ST.cvAcc || null, fx: ST.cvFx || 'auto', fn: ST.cvFxN || 1, r: ST.cvR || null, g: ST.cvGk == null ? 22 : ST.cvGk, b: ST.cvBanner !== false, au: !!ST.cvAuto }; return 'CV1.' + btoa(unescape(encodeURIComponent(JSON.stringify(o)))); }
  window.cvCopy = function () { const c = makeCode(), e = document.getElementById('cvCode'); if (e) { e.value = c; e.select(); } try { navigator.clipboard.writeText(c).then(() => toast('Code copied'), () => toast('Select the code and copy it')); } catch (x) { toast('Select the code and copy it'); } };
  window.cvPaste = async function () {
    let c = ''; try { c = await navigator.clipboard.readText(); } catch (e) { }
    if (!/^CV1\./.test((c || '').trim())) { const p = prompt('Paste a theme code here'); c = p || ''; }
    try {
      c = c.trim(); if (!/^CV1\./.test(c)) return toast('That is not a CineVerse theme code');
      const o = JSON.parse(decodeURIComponent(escape(atob(c.slice(4)))));
      if (!T.some(x => x.id === o.t) || o.t === 'photo') throw 0;
      change(() => {
        setS('cvTheme', o.t); setS('cvBgOn', false); setS('cvLogo', ['text', 'gold', 'holo', 'patch'].includes(o.l) ? o.l : 'text');
        setS('cvAcc', /^#[0-9a-f]{6}$/i.test(o.ac || '') ? o.ac : null); setS('cvFx', FX_PICK.some(x => x[0] === o.fx) ? o.fx : 'auto');
        setS('cvFxN', [0.5, 1, 1.7].includes(+o.fn) ? +o.fn : 1); setS('cvR', ['sharp', 'soft'].includes(o.r) ? o.r : null);
        setS('cvGk', Math.max(0, Math.min(60, +o.g || 22))); setS('cvBanner', o.b !== false); setS('cvAuto', !!o.au);
      }, 'Style applied');
    } catch (e) { toast('That code did not work'); }
  };


  /* ================= NATIVE BRIDGE (Android app only, after the native update) ================= */
  const CVN = (() => { try { return window.Capacitor && Capacitor.isNativePlatform && Capacitor.isNativePlatform() && (!Capacitor.isPluginAvailable || Capacitor.isPluginAvailable('CvNative')) && Capacitor.Plugins && Capacitor.Plugins.CvNative || null; } catch (e) { return null; } })();
  function syncIcon() {
    if (!CVN) return;
    const id = thById(eff()).id, want = ST.cvIconOn === false ? 'classic' : (id === 'photo' ? 'classic' : id);
    if (ST.cvIcon === want) return;
    setS('cvIcon', want);
    try { CVN.setIcon({ theme: want }).catch(() => setS('cvIcon', null)); } catch (e) { setS('cvIcon', null); }
  }

  /* ---- AdMob (Android app, after the native update) ---- */
  const AD_LIVE = 'ca-app-pub-4031231954162326/1511751509', AD_TEST = 'ca-app-pub-3940256099942544/6300978111';
  const INT_LIVE = 'ca-app-pub-4031231954162326/4217805893', INT_TEST = 'ca-app-pub-3940256099942544/1033173712';
  const AO_LIVE = 'ca-app-pub-4031231954162326/2252620555', AO_TEST = 'ca-app-pub-3940256099942544/9257395921';
  const RW_LIVE = 'ca-app-pub-4031231954162326/4683964899', RW_TEST = 'ca-app-pub-3940256099942544/5224354917';
  const lsGet = k => { try { return localStorage.getItem(k); } catch (e) { return null; } };
  const lsSet = (k, v) => { try { localStorage.setItem(k, v); } catch (e) { } };
  // the admin phone always gets Google TEST ads, so you never tap your own live ads by mistake
  const liveOn = () => Date.now() < (+lsGet('cv-live') || 0);        // admin can switch LIVE ads on for 30 minutes
  const isTest = () => { if (S.admin) lsSet('cv-adm', '1'); const adm = !!S.admin || lsGet('cv-adm') === '1'; return adm && !liveOn(); };
  let adId = '', adBad = false, intId = '', intBad = false, aoId = '', aoBad = false, aoDone = false, rwId = '', rwBad = false, plays = 0, lastInt = 0;
  const sleep = ms => new Promise(r => setTimeout(r, ms));
  const bootAt = Date.now();
  function adSync() {
    if (!CVN || adBad || (!aoDone && Date.now() - bootAt < 4000)) return;   // banner waits a few seconds for the app-open ad
    const want = isTest() ? AD_TEST : AD_LIVE;
    if (want === adId) return;
    adId = want;
    try { CVN.showBanner({ id: want }).catch(() => { adBad = true; adId = ''; }); } catch (e) { adBad = true; }
  }
  function intSync() {
    if (!CVN || intBad) return;
    const want = isTest() ? INT_TEST : INT_LIVE;
    if (want === intId) return;
    intId = want;
    try { CVN.loadInterstitial({ id: want }).catch(() => { intBad = true; intId = ''; }); } catch (e) { intBad = true; }
  }
  function rwSync() {
    if (!CVN || rwBad) return;
    const want = isTest() ? RW_TEST : RW_LIVE;
    rwId = want;
    try { CVN.loadRewarded({ id: want }).catch(() => { rwBad = true; }); } catch (e) { rwBad = true; }
  }
  /* App Open ad: full-screen pop-up when the app starts (never on the very first launch) */
  function launchAd(force) {
    if (!CVN || aoBad) { aoDone = true; adSync(); return; }
    const first = !lsGet('cv-launched'); lsSet('cv-launched', '1');
    if ((first && !force) || (force && (Date.now() - (+lsGet('cv-ao') || 0) < 4 * 3600 * 1000 || Date.now() - (+lsGet('cv-aotry') || 0) < 30 * 60000))) { aoDone = true; adSync(); return; }
    lsSet('cv-aotry', String(Date.now()));
    aoDone = false; aoId = isTest() ? AO_TEST : AO_LIVE;
    try { CVN.loadAppOpen({ id: aoId }).catch(() => { aoBad = true; }); } catch (e) { aoBad = true; }
    let n = 0;
    const fin = () => { aoDone = true; adSync(); };
    const tryShow = async () => {
      if (aoDone) return;
      try { const r = await CVN.showAppOpen(); if (r && r.shown) { lsSet('cv-ao', String(Date.now())); fin(); return; } } catch (e) { aoBad = true; fin(); return; }
      if (++n < 9) setTimeout(tryShow, 700); else fin();
    };
    setTimeout(tryShow, 900);
    setTimeout(() => { if (!aoDone) fin(); }, 9000);
  }
  /* Rewarded ad: "watch a short ad to play / save", then a 30 minute pass */
  const PASS_MIN = 30;
  const passOn = () => Date.now() < (+lsGet('cv-pass') || 0);
  function askAd(kind) {
    return new Promise(res => {
      const old = document.getElementById('cvgate'); if (old) old.remove();
      const d = document.createElement('div'); d.id = 'cvgate';
      d.innerHTML = `<div class="cvg-card"><div class="cvg-i">🎬</div><b>Watch a short ad to ${kind === 'save' ? 'save this' : 'play this'}</b><p>After the ad, enjoy free viewing for ${PASS_MIN} minutes.${isTest() ? ' (Test ad)' : ''}</p><button class="btn" id="cvgY" type="button">Watch ad</button><button class="btn g" id="cvgN" type="button">Not now</button></div>`;
      document.body.appendChild(d);
      document.getElementById('cvgY').onclick = () => { d.remove(); res(true); };
      document.getElementById('cvgN').onclick = () => { d.remove(); res(false); };
    });
  }
  let rwFailUntil = 0;
  async function rewardGate(kind) {            // returns 'no' | 'ad' | 'pass'
    if (!CVN || rwBad) return 'pass';
    if (passOn()) return 'pass';
    if (Date.now() < rwFailUntil) return 'pass';
    rwSync();
    let ready = false;
    try { const r = await CVN.rewardedReady(); ready = !!(r && r.ready); } catch (e) { rwBad = true; return 'pass'; }
    if (!ready) return 'pass';                  // no ad ready: play right away, never make the viewer wait
    if (!(await askAd(kind))) return 'no';
    let r; try { r = await CVN.showRewarded(); } catch (e) { rwBad = true; return 'pass'; }
    if (r && r.shown) { if (r.rewarded) { lsSet('cv-pass', String(Date.now() + PASS_MIN * 60000)); return 'ad'; } toast('Watch the full ad to continue'); return 'no'; }
    return 'pass';
  }
  async function interGate() {                 // inside a pass: a short ad on every 2nd video, at most once a minute
    if (!CVN || intBad || !intId) return;
    if (++plays % 2 !== 0) return;
    if (Date.now() - lastInt < 60000) return;
    try { const r = await Promise.race([CVN.showInterstitial(), sleep(60000).then(() => ({ shown: false }))]); if (r && r.shown) lastInt = Date.now(); } catch (e) { intBad = true; }
  }
  if (CVN && typeof play === 'function') {
    const p0 = play;
    play = async function () { let g = 'pass'; try { g = await rewardGate('play'); if (g === 'no') return; if (g === 'pass') await interGate(); } catch (e) { } return p0.apply(this, arguments); };
  }
  if (CVN && typeof down === 'function') {
    const d0 = down;
    down = async function () { let g = 'pass'; try { g = await rewardGate('save'); if (g === 'no') return; } catch (e) { } return d0.apply(this, arguments); };
  }
  if (CVN) {
    launchAd(false); intSync();
    setInterval(() => { try { adSync(); intSync(); } catch (e) { } }, 30000);
    setTimeout(rwSync, 2500);
    document.addEventListener('visibilitychange', () => { if (!document.hidden && aoDone) launchAd(true); });
  }
  window.cvIconTog = function (v) { setS('cvIconOn', v); syncIcon(); };
  if (CVN) {
    const shuf = a => [...a].sort(() => Math.random() - .5), txt = t => t.title + ' is waiting for you. Tap to watch.';
    const one = (t, id) => ({ id, title: 'Pick for tonight 🎬', body: txt(t), image: t.backdrop_url || t.poster_url || '', icon: t.poster_url || '', tid: t.id, color: themeNow().a });
    if (typeof lnSchedule === 'function') {
      const o = lnSchedule;
      lnSchedule = async function () {
        try {
          const pool = S.titles.filter(t => t && t.id && t.title); if (!pool.length) return;
          try { await LN.cancel({ notifications: LN_IDS.map(id => ({ id })) }); } catch (e) { }
          const now = new Date(), items = shuf(pool).slice(0, 7).map((t, i) => { const d = new Date(now.getFullYear(), now.getMonth(), now.getDate() + i, 18, 0, 0); if (d <= now) d.setDate(d.getDate() + 7); return Object.assign(one(t, 9101 + i), { at: d.getTime() }); });
          await CVN.schedule({ items });
        } catch (e) { return o(); }
      };
    }
    if (typeof nSug === 'function') {
      const o = nSug;
      nSug = async function () {
        try { await o(); } catch (e) { }
        try {
          const r = document.getElementById('nR'), m = /Sent "(.*)" to/.exec((r && r.textContent) || '');
          let t = m && S.titles.find(x => x.title === m[1]);
          if (!t) { const pool = S.titles.filter(x => x && x.title); t = pool[Math.floor(Math.random() * pool.length)]; }
          if (!t) return;
          try { if (LN) { const p = await LN.checkPermissions(); if (p.display !== 'granted') await LN.requestPermissions(); } } catch (e) { }
          await CVN.show(one(t, 9099));
          if (r) r.textContent = (r.textContent || '') + ' Also showing it on this phone.';
        } catch (e) { }
      };
    }
    try { CVN.addListener('cvOpen', e => { if (e && e.t && byId(e.t)) openT(e.t); }); } catch (e) { }
    /* count ad views/taps (not test ads) and send totals to Supabase in batches */
    let AQ = { banner: { i: 0, c: 0 }, inter: { i: 0, c: 0 }, appopen: { i: 0, c: 0 }, rewarded: { i: 0, c: 0 } };
    try { const q = JSON.parse(localStorage.getItem('cv-adq') || 'null'); if (q && q.banner && q.inter) { for (const k in q) if (AQ[k]) AQ[k] = q[k]; } } catch (e) { }
    const aqSave = () => { try { localStorage.setItem('cv-adq', JSON.stringify(AQ)); } catch (e) { } };
    const aqFlush = async () => {
      for (const k of ['banner', 'inter', 'appopen', 'rewarded']) {
        for (let n = 0; n < 5; n++) {
          const x = AQ[k]; if (!x.i && !x.c) break;
          const i = Math.min(x.i, 200), c = Math.min(x.c, 50); x.i -= i; x.c -= c; aqSave();
          try { const r = await sb.rpc('cv_ad_log', { p_kind: k, p_imp: i, p_click: c }); if (r && r.error) { x.i += i; x.c += c; aqSave(); break; } } catch (e) { x.i += i; x.c += c; aqSave(); break; }
        }
      }
    };
    const isT = k => (k === 'banner' && adId === AD_TEST) || (k === 'inter' && intId === INT_TEST) || (k === 'appopen' && aoId === AO_TEST) || (k === 'rewarded' && rwId === RW_TEST);
    try { CVN.addListener('cvAd', e => { if (!e) return; const k = ['inter', 'appopen', 'rewarded'].includes(e.kind) ? e.kind : 'banner'; if (isT(k)) return; if (e.ev === 'imp') AQ[k].i++; else if (e.ev === 'click') AQ[k].c++; aqSave(); }); } catch (e) { }
    /* ad problems (why an ad did not show) are counted too, so you can see them in Earnings */
    let AQE = {}; try { AQE = JSON.parse(lsGet('cv-adqe') || '{}') || {}; } catch (e) { AQE = {}; }
    const aqeSave = () => lsSet('cv-adqe', JSON.stringify(AQE));
    try { CVN.addListener('cvAdErr', e => { if (e && e.kind === 'rewarded') rwFailUntil = Date.now() + 10 * 60000; }); } catch (x) { }
    try { CVN.addListener('cvAdErr', e => { if (!e || !['banner', 'inter', 'appopen', 'rewarded'].includes(e.kind) || isT(e.kind)) return; const key = e.kind + '|' + e.code; const x = AQE[key] || (AQE[key] = { k: e.kind, c: +e.code, m: '', n: 0 }); x.n++; x.m = String(e.msg || '').slice(0, 120); aqeSave(); }); } catch (e) { }
    const aqeFlush = async () => {
      for (const key of Object.keys(AQE)) {
        const x = AQE[key]; if (!x || !(x.n > 0)) { delete AQE[key]; continue; }
        const n = Math.min(x.n, 50); x.n -= n; aqeSave();
        try { const r = await sb.rpc('cv_ad_err', { p_kind: x.k, p_code: x.c, p_msg: x.m, p_n: n }); if (r && r.error) { x.n += n; aqeSave(); break; } } catch (e) { x.n += n; aqeSave(); break; }
        if (x.n <= 0) delete AQE[key];
      }
      aqeSave();
    };
    setInterval(() => { aqFlush(); aqeFlush(); }, 60000); setTimeout(() => { aqFlush(); aqeFlush(); }, 15000);
    document.addEventListener('visibilitychange', () => { if (document.hidden) { aqFlush(); aqeFlush(); } });
    setTimeout(async () => { try { const r = await CVN.getLaunch(); if (r && r.t) { let n = 0; const w = () => { if (byId(r.t)) openT(r.t); else if (n++ < 20) setTimeout(w, 500); }; w(); } } catch (e) { } }, 2500);
  }


  /* ================= EARNINGS TAB (admin) ================= */
  const MK = [['ads', 'Ad income (AdMob)'], ['sponsor', 'Sponsor income'], ['vip', 'VIP / payments'], ['other_income', 'Other income'], ['cost', 'Cost / expense']];
  const usd = n => (n < 0 ? '-$' : '$') + Math.abs(Math.round(n * 100) / 100).toFixed(2);
  let ER = null;
  const todayStr = () => new Date().toISOString().slice(0, 10);
  const cut = d => { const t = new Date(); t.setUTCDate(t.getUTCDate() - (d - 1)); return t.toISOString().slice(0, 10); };
  const lastN = id => (id || '').slice(-4);
  function adStatusHtml() {
    if (!CVN) return '<p class="s">Ad controls work inside the Android app only.</p>';
    const live = !isTest(), left = Math.max(0, Math.ceil(((+lsGet('cv-live') || 0) - Date.now()) / 60000));
    const row = (n, id, want) => `<div class="mi"><span>${n}<p class="s">${id ? (id === want[0] ? 'TEST ad unit' : 'LIVE ad unit') + ' …' + lastN(id) : 'not requested yet'}</p></span></div>`;
    return `<div class="mi"><span>Live ads on this phone<p class="s">${live ? (lsGet('cv-adm') === '1' ? `LIVE for about ${left} more min, then back to test.` : 'Real ads (you are not an admin on this phone).') : 'Test ads now. Switch on to check real ads for 30 minutes. Never tap live ads.'}</p></span><label class="sw"><input type="checkbox" ${live && lsGet('cv-adm') === '1' ? 'checked' : ''} onchange="erLive(this.checked)"><i></i></label></div>
      ${row('Banner', adId, [AD_TEST])}${row('Between videos', intId, [INT_TEST])}${row('App open', aoId, [AO_TEST])}${row('Rewarded', rwId, [RW_TEST])}`;
  }
  window.erLive = on => {
    if (on) { if (!confirm('Turn on LIVE ads on this phone for 30 minutes?\n\nNever tap live ads. Google can close your AdMob account for tapping your own ads.')) return erDraw(); lsSet('cv-live', String(Date.now() + 30 * 60000)); }
    else lsSet('cv-live', '0');
    try { adSync(); intSync(); rwSync(); } catch (e) { }
    toast(on ? 'Live ads on for 30 minutes' : 'Test ads on');
    setTimeout(erDraw, 600);
  };
  const ERR_CODE = { 0: 'Internal error', 1: 'Invalid ad unit or ads not set up yet', 2: 'Network error', 3: 'No ad available (no fill)', 8: 'App ID or setup problem', 9: 'No ad from partner' };
  const KIND_NAME = { banner: 'Banner', inter: 'Between videos', appopen: 'App open', rewarded: 'Rewarded' };
  function adErrHtml() {
    const rows = {}; (ER.errs || []).forEach(x => { const k = x.kind + '|' + x.code; (rows[k] = rows[k] || { kind: x.kind, code: x.code, n: 0, msg: x.msg }).n += x.n; });
    const list = Object.values(rows).sort((a, b) => b.n - a.n);
    if (!list.length) return '<p class="s">No ad problems recorded.</p>';
    return list.map(x => `<div class="mi"><span>${esc(KIND_NAME[x.kind] || x.kind)}: ${esc(ERR_CODE[x.code] || 'Error ' + x.code)}<p class="s">Code ${x.code}${x.msg ? ' · ' + esc(x.msg) : ''}</p></span><span class="s">${x.n}×</span></div>`).join('') + '<p class="s">"No ad available" is normal for new apps and new ad units. It usually improves after a few days.</p>';
  }
  async function erV() {
    const el = document.getElementById('adm'); if (!el) return;
    el.innerHTML = '<p class="msg">Loading…</p>';
    let r; try { r = await sb.rpc('cv_ad_report', { p_days: 90 }); } catch (e) { r = { error: e }; }
    if (!r || r.error || !r.data) { el.innerHTML = '<p class="msg">Could not load earnings.' + (r && r.error && r.error.message ? ' ' + esc(r.error.message) : '') + '</p>'; return; }
    ER = r.data; erDraw();
  }
  function erDraw() {
    const el = document.getElementById('adm'); if (!el || !ER) return;
    const per = ST.cvPer || '30', days = per === 'today' ? 1 : +per, from = per === 'today' ? todayStr() : cut(days);
    const ecpm = ST.cvEcpm == null ? 1 : +ST.cvEcpm, rate = +ST.cvRate || 0;
    const st = ER.stats.filter(x => String(x.day) >= from), mo = ER.money.filter(x => String(x.day) >= from);
    const sum = (a, f) => a.reduce((t, x) => t + f(x), 0);
    const imp = sum(st, x => x.imp), clk = sum(st, x => x.clk), est = imp / 1000 * ecpm;
    const kindSum = k => sum(mo.filter(x => x.kind === k), x => +x.amount);
    const adsReal = kindSum('ads'), adsUsed = adsReal > 0 ? adsReal : est, other = kindSum('sponsor') + kindSum('vip') + kindSum('other_income'), cost = kindSum('cost');
    const rev = adsUsed + other, profit = rev - cost;
    const c = (n, l, col) => `<div><b${col ? ` style="color:${col}"` : ''}>${n}</b><span>${l}</span></div>`;
    const ghs = n => rate > 0 ? `<span class="s"> ≈ GH₵ ${(Math.round(n * rate * 100) / 100).toFixed(2)}</span>` : '';
    const dayKeys = []; for (let i = 13; i >= 0; i--) { const t = new Date(); t.setUTCDate(t.getUTCDate() - i); dayKeys.push(t.toISOString().slice(0, 10)); }
    const perDay = dayKeys.map(k => sum(ER.stats.filter(x => String(x.day) === k), x => x.imp));
    const mx = Math.max(1, ...perDay);
    el.innerHTML = `<div class="chips pad mt">${[['today', 'Today'], ['7', '7 days'], ['30', '30 days'], ['90', '90 days']].map(x => `<span class="${per === x[0] ? 'on' : ''}" onclick="erPer('${x[0]}')">${x[1]}</span>`).join('')}</div>
      <div class="stats">${c(usd(profit), 'Profit' + (adsReal > 0 ? '' : ' (estimate)'), profit >= 0 ? '#39df91' : '#ff7a7a')}${c(usd(rev), 'Income')}${c(usd(cost), 'Costs')}${c(imp.toLocaleString(), 'Ad views')}${c(clk.toLocaleString(), 'Ad taps')}${c(usd(est), 'Est. from views')}</div>
      <div class="pad"><p class="s">Profit = income − costs. ${adsReal > 0 ? 'Ad income uses the real amounts you typed in.' : 'No real ad income typed in for this period, so ad income is estimated: views ÷ 1000 × eCPM.'}${ghs(profit)}</p>
      <div class="sec" style="padding-left:0"><h3>Ad views, last 14 days</h3></div><div class="bars">${perDay.map((n, i) => `<div><i style="height:${Math.round(n / mx * 80) + 2}px"></i><span>${dayKeys[i].slice(8)}</span></div>`).join('')}</div>
      <div class="sec" style="padding-left:0"><h3>Ads on this phone</h3></div>
      <div id="adStat">${adStatusHtml()}</div>
      <div class="sec" style="padding-left:0"><h3>Ad problems, last 14 days</h3></div>
      ${adErrHtml()}
      <div class="sec" style="padding-left:0"><h3>Settings</h3></div>
      <div class="mi"><span>eCPM (USD per 1000 views)<p class="s">Copy it from AdMob, Reports.</p></span><input class="f" style="width:90px" inputmode="decimal" value="${ecpm}" onchange="erSet('cvEcpm',this.value)"></div>
      <div class="mi"><span>Cedis per 1 USD (optional)<p class="s">Shows an estimate in GH₵.</p></span><input class="f" style="width:90px" inputmode="decimal" value="${rate || ''}" placeholder="e.g. 11" onchange="erSet('cvRate',this.value)"></div>
      <div class="sec" style="padding-left:0"><h3>Add money in or out</h3></div>
      <p class="s">Exact earnings are in AdMob. Open admob.google.com in Chrome, read the amount, and type it here.</p>
      <input class="f mt" id="erD" type="date" value="${todayStr()}"><select class="f mt" id="erK">${MK.map(x => `<option value="${x[0]}">${x[1]}</option>`).join('')}</select>
      <input class="f mt" id="erA" inputmode="decimal" placeholder="Amount in USD, e.g. 2.35"><input class="f mt" id="erN" maxlength="120" placeholder="Note (optional)">
      <button class="btn mt" style="width:100%" onclick="erAdd()">Add</button>
      <div class="sec" style="padding-left:0"><h3>Recent entries</h3></div>
      ${ER.money.length ? ER.money.slice(0, 25).map(x => `<div class="mi"><span>${esc((MK.find(k => k[0] === x.kind) || [0, x.kind])[1])}<p class="s">${esc(String(x.day))}${x.note ? ' · ' + esc(x.note) : ''}</p></span><span class="s" style="color:${x.kind === 'cost' ? '#ff9a9a' : '#39df91'}">${x.kind === 'cost' ? '-' : '+'}${usd(+x.amount).replace('-', '')} <span onclick="erDel(${+x.id})" style="margin-left:10px;color:#ff9a9a">✕</span></span></div>`).join('') : '<p class="s">Nothing yet.</p>'}</div>`;
  }
  setInterval(() => { const e = document.getElementById('adStat'); if (e && !document.hidden) { try { e.innerHTML = adStatusHtml(); } catch (x) { } } }, 4000);
  window.erPer = k => { setS('cvPer', k); erDraw(); };
  window.erSet = (k, v) => { const n = parseFloat(String(v).replace(',', '.')); setS(k, isFinite(n) && n >= 0 ? n : null); erDraw(); };
  window.erAdd = async () => {
    const g = id => document.getElementById(id), amt = parseFloat(String(g('erA').value).replace(',', '.'));
    if (!isFinite(amt) || amt <= 0) return toast('Type an amount first');
    const r = await sb.rpc('cv_money_add', { p_day: g('erD').value || todayStr(), p_kind: g('erK').value, p_amount: amt, p_note: g('erN').value || '' });
    if (r.error) return toast('Could not save: ' + r.error.message);
    toast('Saved'); erV();
  };
  window.erDel = async id => { if (!confirm('Delete this entry?')) return; const r = await sb.rpc('cv_money_del', { p_id: id }); if (r.error) return toast('Could not delete'); erV(); };
  if (typeof admin === 'function' && typeof admT === 'function') {
    const ad0 = admin, at0 = admT;
    admin = function () { return ad0.apply(this, arguments).replace('<span id="at-mb"', '<span id="at-er" onclick="admT(\'er\')">Earnings</span><span id="at-mb"'); };
    admT = function (k) { if (k !== 'er') return at0.apply(this, arguments); S.at = 'er'; document.querySelectorAll('[id^=at-]').forEach(e => e.classList.toggle('on', e.id === 'at-er')); return erV(); };
  }


  /* ================= SPONSOR BANNERS: counting, rotation, report, "Advertise" page ================= */
  const SLOT_NAME = { home_banner: 'Home, top of page', between_rows: 'Home, between movie rows', title_page: 'Movie page', footer: 'Home, bottom', pre_roll: 'Before video (not live yet)' };
  let AH = {}; try { AH = JSON.parse(lsGet('cv-adh') || '{}') || {}; } catch (e) { AH = {}; }
  const ahSave = () => lsSet('cv-adh', JSON.stringify(AH));
  const seen = {}, tapT = {};
  const bump = (id, k) => { if (S.admin || !id) return; const x = AH[id] || (AH[id] = { v: 0, t: 0 }); x[k]++; ahSave(); };
  async function ahFlush() {
    for (const id of Object.keys(AH)) {
      for (let n = 0; n < 5; n++) {
        const x = AH[id]; if (!x || (!x.v && !x.t)) { delete AH[id]; break; }
        const v = Math.min(x.v, 50), t = Math.min(x.t, 10); x.v -= v; x.t -= t; ahSave();
        try { const r = await sb.rpc('cv_ad_hit', { p_ad: id, p_view: v, p_tap: t }); if (r && r.error) { x.v += v; x.t += t; ahSave(); break; } } catch (e) { x.v += v; x.t += t; ahSave(); break; }
      }
    }
  }
  setInterval(ahFlush, 20000); setTimeout(ahFlush, 6000);
  document.addEventListener('visibilitychange', () => { if (document.hidden) ahFlush(); });
  let io = null;
  try {
    io = new IntersectionObserver(es => es.forEach(e => { if (!e.isIntersecting) return; const id = e.target.getAttribute('data-adid'); if (!id) return; const n = Date.now(); if (seen[id] && n - seen[id] < 90000) return; seen[id] = n; bump(id, 'v'); }), { threshold: 0.5 });
  } catch (e) { io = null; }
  const watchAds = () => { if (!io) return; document.querySelectorAll('.ad[data-adid]:not([data-w])').forEach(el => { el.setAttribute('data-w', '1'); io.observe(el); }); };
  try { let tm; new MutationObserver(() => { clearTimeout(tm); tm = setTimeout(watchAds, 250); }).observe(document.body, { childList: true, subtree: true }); } catch (e) { }
  document.addEventListener('click', e => { const a = e.target.closest && e.target.closest('.ad[data-adid]'); if (!a) return; const id = a.getAttribute('data-adid'), n = Date.now(); if (tapT[id] && n - tapT[id] < 2000) return; tapT[id] = n; bump(id, 't'); }, true);
  setInterval(() => {                      // rotate when several sponsors share a spot
    if (document.hidden || typeof adPick !== 'function') return;
    document.querySelectorAll('.ad[data-adslot]').forEach(el => {
      const slot = el.getAttribute('data-adslot'), cur = el.getAttribute('data-adid');
      const L = (S.ads || []).filter(a => a.slot === slot && adLive(a)); if (L.length < 2) return;
      const nx = L[(L.findIndex(a => a.id === cur) + 1) % L.length]; if (!nx || nx.id === cur) return;
      S.adPk = S.adPk || {}; S.adPk[slot] = nx.id; el.outerHTML = adHtml(nx);
    });
    watchAds();
  }, 30000);
  setTimeout(watchAds, 1500);

  // Admin Ads tab: views, taps and a copy-able report for each sponsor
  const pct = (t, v) => v ? (Math.round(t / v * 1000) / 10) + '%' : '0%';
  const sumDays = (rows, id, from) => rows.filter(r => r.ad_id === id && String(r.day) >= from).reduce((a, r) => ({ v: a.v + r.views, t: a.t + r.taps }), { v: 0, t: 0 });
  const dayAgo = n => { const d = new Date(); d.setUTCDate(d.getUTCDate() - (n - 1)); return d.toISOString().slice(0, 10); };
  window.__adrep = {};
  async function decorateAds() {
    const el = document.getElementById('adm'); if (!el) return;
    let r; try { r = await sb.rpc('cv_ad_hits_report', { p_days: 30 }); } catch (e) { return; }
    const rows = (r && r.data) || [], f7 = dayAgo(7), f30 = dayAgo(30);
    let TV = 0, TT = 0;
    el.querySelectorAll('.rw').forEach(row => {
      const m = /adTg\('([0-9a-f-]{36})'/.exec(row.innerHTML); if (!m) return;
      const id = m[1], a7 = sumDays(rows, id, f7), a30 = sumDays(rows, id, f30); TV += a30.v; TT += a30.t;
      const name = (row.querySelector('b') || {}).textContent || 'Sponsor', slotTxt = (row.querySelector('.s') || {}).textContent || '', slot = slotTxt.split(' · ')[0];
      window.__adrep[id] = { name, slot, a7, a30 };
      const info = document.createElement('p'); info.className = 's';
      info.textContent = `7 days: ${a7.v} views, ${a7.t} taps (${pct(a7.t, a7.v)}) · 30 days: ${a30.v} views, ${a30.t} taps (${pct(a30.t, a30.v)})`;
      const box = row.querySelector('div[style*="flex:1"]'); if (box) { box.appendChild(info); const b = document.createElement('button'); b.className = 'btn g'; b.style.cssText = 'padding:6px 10px;font-size:12px;margin-top:6px'; b.textContent = 'Copy report'; b.onclick = () => cvAdCopy(id); box.appendChild(b); }
    });
    const sec = el.querySelector('.sec'); const sum = document.createElement('div');
    sum.className = 'stats'; sum.innerHTML = `<div><b>${TV.toLocaleString()}</b><span>Sponsor views, 30 days</span></div><div><b>${TT.toLocaleString()}</b><span>Taps</span></div><div><b>${pct(TT, TV)}</b><span>Tap rate</span></div>`;
    const hdr = Array.from(el.querySelectorAll('.sec')).find(x => /Your ads/.test(x.textContent)); if (hdr) hdr.before(sum);
    el.querySelectorAll('.s').forEach(p => { if (/Only the home_banner slot/.test(p.textContent)) p.textContent = 'All spots are live: home_banner (top of Home), between_rows, title_page (movie page) and footer. Several sponsors in one spot take turns.'; });
    el.querySelectorAll('#dS option').forEach(o => { const n = SLOT_NAME[o.textContent]; if (n) o.label = n + ' (' + o.textContent + ')'; });
  }
  window.cvAdCopy = id => {
    const x = window.__adrep[id]; if (!x) return;
    const t = `CineVerse sponsor report\nSponsor: ${x.name}\nSpot: ${SLOT_NAME[x.slot] || x.slot}\nLast 7 days: ${x.a7.v} views, ${x.a7.t} taps (${pct(x.a7.t, x.a7.v)})\nLast 30 days: ${x.a30.v} views, ${x.a30.t} taps (${pct(x.a30.t, x.a30.v)})\nThank you for advertising with CineVerse.`;
    try { navigator.clipboard.writeText(t).then(() => toast('Report copied'), () => prompt('Copy this report', t)); } catch (e) { prompt('Copy this report', t); }
  };
  if (typeof adsV === 'function') { const a0 = adsV; adsV = async function () { await a0.apply(this, arguments); try { await decorateAds(); } catch (e) { } }; }

  // "Advertise with us" page, footer link and settings row
  try {
    PGT.advertise = 'Advertise with us';
    PG.advertise = `<p>Reach people who watch films, series and anime on CineVerse. Your banner can appear at the top of the Home screen, between movie rows, on movie pages, or at the bottom of Home. It links to your website, WhatsApp or page.</p><h4>What you get</h4><p>Your banner in the spot you choose, for the dates you choose. We send you a report of how many people saw it and tapped it.</p><h4>How to start</h4><p>Email <a href="mailto:${EMAIL}?subject=Advertise%20on%20CineVerse">${EMAIL}</a> with your business name, your banner image and the link people should open. We will reply with the options.</p><p class="s">Ads must be honest, legal and suitable for a general audience.</p>`;
    const ft = document.querySelector('.foot'); if (ft && !ft.querySelector('[data-adv]')) ft.insertAdjacentHTML('beforeend', '<a data-adv="1" onclick="pageV(\'advertise\')">Advertise</a>');
  } catch (e) { }


  /* ================= PROFILE PHOTO (kept on this phone) ================= */
  const avKey = () => 'cv-av-' + (S.user ? S.user.id : 'x');
  function decorateMe() {
    const a = document.getElementById('app'); const av = a && a.querySelector('.prof .av'); if (!av || !S.user) return;
    const u = lsGet(avKey());
    if (u) av.style.cssText = 'background:url("' + u + '") center/cover;color:transparent;cursor:pointer';
    else av.style.cursor = 'pointer';
    av.onclick = () => cvAvatar();
    const nm = Array.from(a.querySelectorAll('.mi')).find(r => /Change name/.test(r.textContent));
    if (nm && !a.querySelector('[data-avrow]')) nm.insertAdjacentHTML('beforebegin', '<div class="mi" data-avrow="1" onclick="cvAvatar()"><span>📷 Profile photo<p class="s">Choose a picture from your gallery</p></span><span class="s">Change ›</span></div>' + (u ? '<div class="mi" onclick="cvAvatarDel()"><span>Remove profile photo</span></div>' : ''));
  }
  window.cvAvatar = () => {
    if (!S.user) return toast('Sign in first');
    const i = document.createElement('input'); i.type = 'file'; i.accept = 'image/*';
    i.onchange = async () => {
      const f = i.files && i.files[0]; if (!f) return; if (!/^image\//.test(f.type)) return toast('Please choose a picture');
      try {
        const r = await readImg(f, 640, 'image/jpeg', .9), c = r.c, side = Math.min(c.width, c.height), o = document.createElement('canvas'); o.width = o.height = 256;
        o.getContext('2d').drawImage(c, (c.width - side) / 2, (c.height - side) / 2, side, side, 0, 0, 256, 256);
        lsSet(avKey(), o.toDataURL('image/jpeg', .85)); toast('Profile photo saved'); try { me(); } catch (e) { }
      } catch (e) { toast('Could not open that picture'); }
    };
    i.click();
  };
  window.cvAvatarDel = () => { try { localStorage.removeItem(avKey()); } catch (e) { } toast('Profile photo removed'); try { me(); } catch (e) { } };
  if (typeof me === 'function') { const m0 = me; me = async function () { const r = await m0.apply(this, arguments); try { decorateMe(); } catch (e) { } return r; }; }


  /* ================= SPEED: lazy posters, smooth mode, faster video start ================= */
  try {
    const lazyIO = ('IntersectionObserver' in window) ? new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('li'); lazyIO.unobserve(e.target); } }), { rootMargin: '400px 700px' }) : null;
    const lazyScan = () => document.querySelectorAll('[style*="--u:"]:not([data-lz])').forEach(el => { el.setAttribute('data-lz', '1'); if (lazyIO) lazyIO.observe(el); else el.classList.add('li'); });
    let lt; new MutationObserver(() => { clearTimeout(lt); lt = setTimeout(lazyScan, 80); }).observe(document.body, { childList: true, subtree: true });
    lazyScan();
  } catch (e) { document.querySelectorAll('[style*="--u:"]').forEach(el => el.classList.add('li')); }
  window.cvSmoothTog = v => { setS('cvSmooth', v); paint(); };
  // faster video start: remember lookups, warm up the connection and the first video link
  const AC = {};
  if (typeof assets === 'function') { const a0 = assets; assets = async function (eid) { const c = AC[eid]; if (c && Date.now() - c.t < 300000) return c.v; const v = await a0.apply(this, arguments); if (v && v.length) AC[eid] = { v, t: Date.now() }; return v; }; }
  try { if (sb && sb.supabaseUrl) { const l = document.createElement('link'); l.rel = 'preconnect'; l.href = sb.supabaseUrl; l.crossOrigin = ''; document.head.appendChild(l); } } catch (e) { }
  async function warmFirst() {
    try {
      const e = (typeof EPS !== 'undefined' && EPS && EPS[0]) ? EPS[0] : null; if (!e) return;
      const A = await assets(e.id); if (!A || !A.length) return;
      let i0 = 0; const cn = navigator.connection; if (ST.saver || (cn && (cn.saveData || /2g|3g/.test(cn.effectiveType || '') || cn.downlink < 1.5 || cn.rtt > 600))) { const j = A.findIndex(a => QO.indexOf(a.quality) <= 1); if (j >= 0) i0 = j; }
      await vurl(A[i0]);
    } catch (x) { }
  }
  if (typeof openT === 'function') { const o0 = openT; openT = function () { const r = o0.apply(this, arguments); setTimeout(warmFirst, 900); setTimeout(warmFirst, 2500); return r; }; }


  /* ================= DOWNLOAD MANAGER: queue, progress, pause / resume, storage limit ================= */
  const dlCap = () => (ST.cvDlCap || 3) * 1073741824;
  const gbs = n => (Math.round(n / 1073741824 * 100) / 100).toFixed(2) + ' GB';
  const dlUsed = () => DM().reduce((t, d) => t + (d.st && d.st !== 'done' ? (d.got || 0) : (d.size || d.got || 0)), 0);
  const dmUpd = (id, p) => { const l = DM(), i = l.findIndex(d => d.id === id); if (i < 0) return; Object.assign(l[i], p); sDM(l); };
  const RT = {};
  { const l = DM(); let ch = false; l.forEach(d => { if (d.st && d.st !== 'done' && d.st !== 'paused') { d.st = 'paused'; ch = true; } }); if (ch) sDM(l); }
  const dlRedraw = () => { if (S.nav === 'dl') { const y = window.scrollY; try { go(); } catch (e) { } window.scrollTo(0, y); } };
  async function dlClear(id, parts) { try { const c = await caches.open('cv-dl'); for (let i = 0; i < (parts || 0) + 2; i++) await c.delete(DK(id) + '/p/' + i); await c.delete(DK(id)); } catch (e) { } }
  const anyActive = () => Object.keys(RT).some(k => !RT[k].paused);
  function pump() { if (anyActive()) return; const d = DM().find(x => x.st === 'queued'); if (d) runDl(d); }
  function dlTick(id, off, total, R) {
    const p = total ? Math.min(100, Math.floor(off * 100 / total)) : 0, now = Date.now(), w = R.win;
    const sp = w.length ? w.reduce((t, x) => t + x[1], 0) / Math.max(1, (now - w[0][0]) / 1000) : 0;
    const b = document.getElementById('dlb-' + id), pe = document.getElementById('dlp-' + id), se = document.getElementById('dls-' + id);
    if (b) b.style.width = p + '%'; if (pe) pe.textContent = 'Downloading… ' + p + '%'; if (se) se.textContent = (sp / 1048576).toFixed(1) + ' MB/s';
    dlCard(off);
  }
  function dlCard(extra) {
    const used = Math.max(dlUsed(), extra || 0), cap = dlCap(), p = Math.min(100, Math.round(used * 100 / cap));
    const r = document.getElementById('dlring'), u = document.getElementById('dlused'), bar = document.getElementById('dlbarI'), av = document.getElementById('dlavail');
    if (r) { r.style.setProperty('--p', p); r.firstChild.textContent = p + '%'; } if (u) u.textContent = gbs(used) + ' / ' + gbs(cap); if (bar) bar.style.width = p + '%'; if (av) av.textContent = gbs(Math.max(0, cap - used)) + ' available';
  }
  async function runDl(d) {
    const R = RT[d.id] = { paused: false, ctrl: new AbortController(), win: [] };
    dmUpd(d.id, { st: 'downloading', err: '' }); dlRedraw();
    let off = d.got || 0, part = d.parts || 0, tick = 0;
    try {
      const c = await caches.open('cv-dl');
      const u = await vurl(d.a); if (!u) throw new Error('could not get the video link');
      let r = await fetch(u, { headers: off > 0 ? { Range: 'bytes=' + off + '-' } : {}, signal: R.ctrl.signal });
      if (off > 0 && r.status !== 206) { await dlClear(d.id, part); off = 0; part = 0; dmUpd(d.id, { got: 0, parts: 0 }); if (r.status !== 200) r = await fetch(u, { signal: R.ctrl.signal }); }
      if (!r.ok || !r.body) throw new Error('could not fetch the file (' + r.status + ')');
      const clen = +r.headers.get('content-length') || 0, total = (r.status === 206 ? off : 0) + clen || d.tot || d.size || 0;
      dmUpd(d.id, { tot: total });
      const rd = r.body.getReader(); let buf = [], bl = 0;
      const flush = async () => { if (!bl) return; await c.put(DK(d.id) + '/p/' + part, new Response(new Blob(buf))); part++; buf = []; bl = 0; dmUpd(d.id, { got: off, parts: part }); };
      for (;;) {
        while (R.paused) await sleep(250);
        const { done, value } = await rd.read(); if (done) break;
        buf.push(value); bl += value.length; off += value.length;
        const now = Date.now(); R.win.push([now, value.length]); while (R.win.length && now - R.win[0][0] > 3000) R.win.shift();
        if (bl >= 4 * 1048576) await flush();
        if (now - tick > 400) { tick = now; dlTick(d.id, off, total, R); }
      }
      await flush();
      dmUpd(d.id, { st: 'done', got: off, size: off, tot: off });
      toast('Saved: ' + d.title + ' ✅');
    } catch (x) {
      if (!R.cancel) { dmUpd(d.id, { st: 'paused', err: R.dropped ? '' : String((x && x.message) || x).slice(0, 80) }); if (!R.dropped) toast('Download stopped: ' + ((x && x.message) || x)); }
    } finally { delete RT[d.id]; dlRedraw(); pump(); }
  }
  window.dlPause = id => {
    const R = RT[id]; if (!R) return; R.paused = true; dmUpd(id, { st: 'paused' });
    R.pt = setTimeout(() => { if (RT[id] && RT[id].paused) { RT[id].dropped = true; try { RT[id].ctrl.abort(); } catch (e) { } } }, 120000);
    dlRedraw(); pump();
  };
  window.dlResume = id => {
    const cur = DM().find(d => d.id === id); if (cur && (!cur.st || cur.st === 'done')) return;
    const R = RT[id]; if (R) { clearTimeout(R.pt); R.paused = false; dmUpd(id, { st: 'downloading' }); dlRedraw(); return; }
    if (dlUsed() >= dlCap()) return toast('Your download limit is full. Raise it with ⚙ or delete something.');
    dmUpd(id, { st: 'queued', err: '' }); dlRedraw(); pump();
  };
  rmOff = async function (id, q) {
    if (!q && !confirm('Delete this download?')) return;
    const R = RT[id]; if (R) { R.cancel = true; R.paused = false; clearTimeout(R.pt); try { R.ctrl.abort(); } catch (e) { } }
    const d = DM().find(x => x.id === id); sDM(DM().filter(x => x.id !== id)); await dlClear(id, d && d.parts); dlRedraw(); pump();
  };
  playOff = async function (id) {
    if (!window.caches) return;
    const d = DM().find(x => x.id === id), c = await caches.open('cv-dl'); let b = null;
    if (d && d.parts > 0) { const bl = []; for (let i = 0; i < d.parts; i++) { const r = await c.match(DK(id) + '/p/' + i); if (!r) { bl.length = 0; break; } bl.push(await r.blob()); } if (bl.length) b = new Blob(bl, { type: 'video/mp4' }); }
    else { const r = await c.match(DK(id)); if (r) b = await r.blob(); }
    if (!b || !d) { toast('That file is gone. Removing it from the list.'); return rmOff(id, 1); }
    const w = $('#watch'); w.classList.add('open'); w.scrollTop = 0;
    w.innerHTML = `<div class="wi"><div class="wv" id="wv"><video id="vp" playsinline autoplay></video>${pcHTML(false)}</div><div class="pad"><h2 class="wh mt">${esc(d.title)}</h2><p class="s mt">${esc(d.label)} | ${esc(d.q)} | plays from your saved copy, no data used</p></div><div class="tb"><span class="on">For you</span></div><div class="grid mt">${S.titles.filter(x => x.id !== d.tid).slice(0, 24).map(card).join('')}</div></div>`;
    initPlayer(); $('#ptl').textContent = d.title + ' · ' + d.label; $('#vp').src = URL.createObjectURL(b);
  };
  dgo = async function () {
    const ids = [...document.querySelectorAll('[data-e]:checked')].map(x => x.dataset.e);
    if (!ids.length) return toast('Select at least one.');
    if (!window.caches) return toast("This browser can't save downloads inside the app. Try Chrome over https.");
    try { navigator.storage && navigator.storage.persist && navigator.storage.persist(); } catch (e) { }
    let g = 'pass'; try { g = await rewardGate('save'); } catch (e) { } if (g === 'no') return;
    const { t, e } = DL; shut(); let added = 0;
    for (const id of ids) {
      const a = DL.A.find(x => x.episode_id === id && x.quality === DL.q), ep = e.find(x => x.id === id); if (!a) continue;
      if (DM().some(d => d.id === a.id)) { toast('Already in Downloads.'); continue; }
      const need = a.size_bytes || 0;
      if (dlUsed() + need > dlCap()) { toast('Not enough space in your download limit. Raise it with ⚙ in Downloads.'); break; }
      const l = DM(); l.push({ id: a.id, tid: t.id, title: t.title, poster: t.poster_url, type: t.type, year: t.release_year || '', genre: (t.genres || [])[0] || '', label: t.type === 'movie' ? 'Movie' : 'S' + ep.season + ' E' + ep.episode, q: DL.q, size: need, tot: need, got: 0, parts: 0, st: 'queued', a: { id: a.id, provider: a.provider, storage_path: a.storage_path } });
      sDM(l); added++;
    }
    if (added) { toast(added + ' added to Downloads'); pump(); if (S.nav === 'dl') go(); }
  };
  window.dlFilter = k => { setS('cvDlF', k); dlRedraw(); };
  window.dlLimit = () => {
    const old = document.getElementById('cvgate'); if (old) old.remove();
    const d = document.createElement('div'); d.id = 'cvgate';
    d.innerHTML = `<div class="cvg-card"><b>Download limit</b><p>The most CineVerse may save on this phone.</p><div class="cvs-chips" style="justify-content:center">${[1, 2, 3, 5, 10, 20].map(n => `<button type="button" class="${(ST.cvDlCap || 3) === n ? 'on' : ''}" onclick="dlSetCap(${n})">${n} GB</button>`).join('')}</div><button class="btn g" type="button" onclick="document.getElementById('cvgate').remove()">Close</button></div>`;
    document.body.appendChild(d);
  };
  window.dlSetCap = n => { setS('cvDlCap', n); const g = document.getElementById('cvgate'); if (g) g.remove(); dlRedraw(); };
  const dlSvg = { pause: '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>', play: '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4l13 8-13 8z"/></svg>', del: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 11v6M14 11v6"/></svg>', clock: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>', ok: '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/><path d="M7 12.5l3.2 3.2L17 9" stroke="#0b0e17" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>' };
  dl = function () {
    const D = DM(), T = S.titles.filter(t => t.allow_download), f = ST.cvDlF || 'All';
    const typ = d => d.type || ((S.titles.find(t => t.id === d.tid) || {}).type) || 'movie';
    const FT = { Movies: 'movie', Series: 'series', Anime: 'anime' }, list = D.filter(d => f === 'All' || typ(d) === FT[f]);
    const used = dlUsed(), cap = dlCap(), p = Math.min(100, Math.round(used * 100 / cap));
    const item = d => {
      const st = d.st || 'done', meta = [d.year, d.genre, mb(d.size || d.tot || 0)].filter(Boolean).join(' • '), tot = d.tot || d.size || 0, pc = tot ? Math.min(100, Math.floor((d.got || 0) * 100 / tot)) : 0;
      let mid, btn;
      if (st === 'downloading') { mid = `<div class="dlbar"><i id="dlb-${d.id}" style="width:${pc}%"></i></div><div class="stt"><span class="wt" id="dlp-${d.id}">Downloading… ${pc}%</span><span class="s" id="dls-${d.id}">…</span></div>`; btn = `<button class="ib p" onclick="dlPause('${d.id}')" aria-label="Pause">${dlSvg.pause}</button>`; }
      else if (st === 'paused') { mid = `<div class="stt"><span class="wt">${dlSvg.pause.replace('18', '12').replace('18', '12')} Paused${pc ? ' · ' + pc + '%' : ''}${d.err ? ' · ' + esc(d.err) : ''}</span></div>`; btn = `<button class="ib p" onclick="dlResume('${d.id}')" aria-label="Resume">${dlSvg.play}</button><button class="ib" onclick="rmOff('${d.id}')" aria-label="Delete">${dlSvg.del}</button>`; }
      else if (st === 'queued') { mid = `<div class="stt"><span class="s">${dlSvg.clock} Queued</span></div>`; btn = `<button class="ib" onclick="rmOff('${d.id}')" aria-label="Delete">${dlSvg.del}</button>`; }
      else { mid = `<div class="stt"><span class="ok">${dlSvg.ok} Completed</span></div>`; btn = `<button class="ib" onclick="event.stopPropagation();rmOff('${d.id}')" aria-label="Delete">${dlSvg.del}</button>`; }
      return `<div class="dli" ${st === 'done' ? `onclick="playOff('${d.id}')"` : ''}><div class="po" style="${bg(d.poster)}"></div><div class="mid"><b>${esc(d.title)}</b><div class="m2">${esc(d.label)} · ${esc(meta)}</div>${mid}</div>${btn}</div>`;
    };
    const busy = D.some(d => d.st === 'downloading');
    return `<div class="dlh"><span style="font-size:22px">⇩</span><h2>Downloads</h2><button class="dlg" onclick="dlLimit()" aria-label="Download limit">⚙</button></div>
      <div class="dlc"><div class="dlr" id="dlring" style="--p:${p}"><div>${p}%</div></div><div class="st"><small>Storage Usage</small><div class="big" id="dlused">${gbs(used)} / ${gbs(cap)}</div><div class="dlbar"><i id="dlbarI" style="width:${p}%"></i></div><small id="dlavail">${gbs(Math.max(0, cap - used))} available</small></div></div>
      ${busy ? '<p class="s pad" style="margin:0">Keep CineVerse open while downloading.</p>' : ''}
      <div class="dlf">${['All', 'Movies', 'Series', 'Anime'].map(c => `<span class="${f === c ? 'on' : ''}" onclick="dlFilter('${c}')">${c}</span>`).join('')}</div>
      ${list.length ? list.map(item).join('') : '<p class="msg">Nothing here yet. Titles you save stay inside CineVerse, not in your phone\'s gallery or files.</p>'}` +
      (T.length ? `<div class="sec"><h3>Available to download</h3></div>` + T.map(t => `<div class="rw"><div class="po" style="${bg(t.poster_url)}" onclick="openT('${t.id}')"></div><div style="flex:1;min-width:0"><b>${esc(t.title)}</b><p class="s">${esc(meta(t))}</p></div><button class="btn" onclick="dlg('${t.id}')">⇩</button></div>`).join('') : '');
  };


  /* ================= BACK BUTTON: go back inside the app instead of closing it ================= */
  if (IS_NATIVE) {
    let lastBack = 0;
    try { history.replaceState({ cv: 0 }, ''); history.pushState({ cv: 1 }, ''); } catch (e) { }
    const closeTop = () => {
      const g = document.getElementById('cvgate'); if (g) { g.remove(); return true; }
      const sh = document.getElementById('sheet'); if (sh && sh.classList.contains('open')) { shut(); return true; }
      const w = document.getElementById('watch'); if (w && w.classList.contains('open')) { closeW(); return true; }
      if (S.sf) { endS(); return true; }
      if (document.querySelector('.cvs-prev')) { nav('set'); return true; }
      if (S.nav && S.nav !== 'home') { nav('home'); return true; }
      return false;
    };
    window.addEventListener('popstate', () => {
      let handled = false; try { handled = closeTop(); } catch (e) { }
      if (handled) { try { history.pushState({ cv: 1 }, ''); } catch (e) { } return; }
      const now = Date.now();
      if (now - lastBack < 2200) {
        try { if (CVN && CVN.exitApp) { CVN.exitApp(); return; } } catch (e) { }
        try { const A = window.Capacitor && Capacitor.Plugins && Capacitor.Plugins.App; if (A && A.exitApp) { A.exitApp(); return; } } catch (e) { }
        return;                                   // the next press leaves the app
      }
      lastBack = now; toast('Press back again to exit'); try { history.pushState({ cv: 1 }, ''); } catch (e) { }
    });
  }

  /* ================= HOOKS ================= */
  if (typeof setV === 'function') {
    const so = setV;
    setV = function () {
      const h = so.apply(this, arguments), i = h.indexOf('<div class="mi">');
      const row = `<div class="mi" onclick="cvStudio()"><span>🎨 Theme Studio<p class="s">${T.length - 1} themes, logos, your own photo and more</p></span><span class="s">Open ›</span></div>`;
      const row2 = `<div class="mi" onclick="pageV('advertise')"><span>📣 Advertise with us<p class="s">Show your business to CineVerse viewers</p></span><span class="s">Open ›</span></div>`;
      return i < 0 ? h + row + row2 : h.slice(0, i) + row + row2 + h.slice(i);
    };
  }
  if (typeof go === 'function') { const go0 = go; go = function () { const r = go0.apply(this, arguments); try { cvBanner(); } catch (e) { } try { adSync(); intSync(); } catch (e) { } try { const lb = document.getElementById('cvbg'); if (lb && lb.getAttribute('data-mode') === 'live' && lb.getAttribute('data-n') !== String((S.titles || []).length)) buildLive(lb); } catch (e) { } return r; }; }

  /* keep trying when the phone's network is bad */
  let loadTries = 0;
  setInterval(() => { if (!document.hidden && S.loadErr && !(S.titles && S.titles.length) && loadTries++ < 8) { try { load(); } catch (e) { } } }, 12000);
  window.addEventListener('online', () => { if (S.loadErr) { loadTries = 0; try { load(); } catch (e) { } } });

  paint();
  loadImgs();
})();

</script></body></html>
