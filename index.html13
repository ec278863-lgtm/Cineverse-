<path d="M54 12L70 5C84 3 100 4 112 8L128 15L54 15Z" fill="#0a0418" stroke="#19e3ff" stroke-width="1"/><path d="M66 8L72 5L80 5L74 13z" fill="#fff" opacity=".3"/>
<rect x="144" y="12" width="20" height="3" rx="1.5" fill="#ff3df2"/><path d="M0 28L10 26" stroke="#ff2a6d" stroke-width="3"/><path d="M158 30L164 28" stroke="#fff6a8" stroke-width="3"/>
