${star(196, 24, 1.6)}${star(330, 30, 1.8)}${star(120, 40, 1.4)}`;
ART.ops = u => `<defs><linearGradient id="a${u}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1b0d06"/><stop offset=".6" stop-color="#5a2208"/><stop offset="1" stop-color="#b8420d"/></linearGradient><radialGradient id="f${u}" cx=".5" cy="1" r=".8"><stop offset="0" stop-color="#ffb347"/><stop offset=".5" stop-color="#ff5a1a" stop-opacity=".7"/><stop offset="1" stop-color="#ff5a1a" stop-opacity="0"/></radialGradient><linearGradient id="v${u}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a4030"/><stop offset="1" stop-color="#14170f"/></linearGradient></defs>
<rect width="360" height="230" fill="url(#a${u})"/><ellipse cx="260" cy="230" rx="200" ry="120" fill="url(#f${u})"/>
